fn main() -> nil {
    let items = [10, 25, 3, 42, 17]

    let result = find(items, fn(x) { x > 20 })
    match result {
        Some(v) => { print(f"found: {v}") }
        None => { print("not found") }
    }

    let empty_result = find(items, fn(x) { x > 100 })
    match empty_result {
        Some(v) => { print(f"found: {v}") }
        None => { print("not found") }
    }
}
// expect: found: 25
// expect: not found

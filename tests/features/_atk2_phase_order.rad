// Attack: phase should preserve declaration order of systems within it
component C { v: 0 }

system First(c: C) { print("1") }
system Second(c: C) { print("2") }
system Third(c: C) { print("3") }

phase InOrder { First, Second, Third }

fn main() -> nil {
    spawn(C { v: 0 })
    schedule [InOrder]
}

// expect: 1
// expect: 2
// expect: 3

// Test: read_file_bytes / write_file_bytes

let path = "_test_io_bytes.tmp"

// Clean up
if file_exists(path) {
    remove_file(path)
}

// Write bytes and read them back
let bytes = [72, 101, 108, 108, 111]
write_file_bytes(path, bytes)

let result = read_file_bytes(path)
print(result)
// expect: [72, 101, 108, 108, 111]

// read_file should see the same content as text
print(read_file(path))
// expect: Hello

// Clean up
remove_file(path)

print("file bytes ok")
// expect: file bytes ok

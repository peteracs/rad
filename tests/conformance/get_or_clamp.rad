// get_or() — lookup with a fallback instead of nil/bounds-error — and
// clamp() — pin a number to a range. The cooldown-table and CDR idioms.

fn main() -> nil {
    let cds = {"q": 135, "w": 0}

    // map hits and misses
    print(get_or(cds, "q", 0))            // 135
    print(get_or(cds, "r", 0))            // 0 (missing key -> default)
    print(cds |> get_or("w", -1))         // 0 (present zero is not "missing")

    // lists: in-bounds, out-of-bounds, negative
    let ranks = [10, 20, 30]
    print(get_or(ranks, 1, -1))           // 20
    print(get_or(ranks, 9, -1))           // -1
    print(get_or(ranks, -1, -1))          // -1

    // clamp: ints stay int, floats promote, bounds inclusive
    print(clamp(5, 0, 10))                // 5
    print(clamp(-3, 0, 10))               // 0
    print(clamp(99, 0, 10))               // 10
    print(clamp(0.55, 0.0, 0.4))          // 0.4
    print(clamp(3, 0.0, 10.0))            // 3.0

    // the CDR formula, exactly as spellwork writes it
    let cdr = 0.55
    print(80.0 * (1.0 - clamp(cdr, 0.0, 0.4)))   // 48.0
}

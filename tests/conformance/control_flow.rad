// if/else, while, for, break
if 3 < 5 {
    print("yes")
} else {
    print("no")
}
// expect: yes
if false {
    print("bad")
} else {
    print("else")
}
// expect: else
let mut i = 0
while i < 3 {
    print(i)
    i = i + 1
}
// expect: 0
// expect: 1
// expect: 2
for v in [10, 20] {
    print(v)
}
// expect: 10
// expect: 20
for k in range(3) {
    if k == 2 {
        break
    }
    print(k)
}
// expect: 0
// expect: 1
let mut j = 0
while j < 10 {
    j = j + 1
    if j == 2 {
        break
    }
}
print(j)
// expect: 2

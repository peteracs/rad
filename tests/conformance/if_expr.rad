// if-expressions: `if cond { a } else { b }` has a value. else is
// mandatory, chains continue with `else if`, branches must agree on
// type, and the whole form nests anywhere an expression goes.

pure fn sign(v: int) -> int {
    return if v > 0 { 1 } else if v < 0 { -1 } else { 0 }
}

fn main() -> nil {
    // basics + chains
    print(if 2 > 1 { "yes" } else { "no" })          // yes
    print(sign(42))                                  // 1
    print(sign(-7))                                  // -1
    print(sign(0))                                   // 0

    // nests in arguments, lists, and arithmetic
    let hp = 35
    print(max(if hp > 50 { hp } else { 0 }, 10))     // 10
    print([if true { 1 } else { 2 }, 3])             // [1, 3]
    print(1 + if hp < 50 { 100 } else { 200 })       // 101

    // condition can be any bool expression; branches unify int|float
    let scale = if hp % 2 == 1 { 1.5 } else { 0.5 }
    print(scale)                                     // 1.5

    // works in pipeline closures
    let labels = [1, -2, 0] |> map(fn(v) { return if v >= 0 { "pos" } else { "neg" } })
    print(labels)                                    // ["pos", "neg", "pos"]

    // nested if-expressions
    let a = 3
    let b = 5
    print(if a > b { if true { "a" } else { "?" } } else { "b" })  // b
}

// backend: both
component Marker { id: 0 }

entity e { Marker { id: 1 } }

system First(m: Marker, io true) before Second {
    print("first")
}

system Second(m: Marker, io true) before Third {
    print("second")
}

system Third(m: Marker, io true) {
    print("third")
}

schedule [Third, Second, First]
// expect: first
// expect: second
// expect: third

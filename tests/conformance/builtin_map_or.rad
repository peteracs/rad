// backend: both
let some_hp = Option::Some { value: 42 }
let no_hp = Option::None {}

let hp1 = map_or(some_hp, 0, fn(v) { return v + 1 })
let hp2 = map_or(no_hp, 0, fn(v) { return v + 1 })
print(hp1)
print(hp2)

let ok_name = Result::Ok { value: "hero" }
let err_name = Result::Err { message: "no name" }
print(map_or(ok_name, "unknown", fn(v) { return to_upper(v) }))
print(map_or(err_name, "unknown", fn(v) { return to_upper(v) }))

// expect: 43
// expect: 0
// expect: HERO
// expect: unknown

// Pipe with builtins and user functions
fn double(x) {
    return x * 2
}

fn pos(x) {
    return x > 0
}
print([1, 2, 3] |> map(double))
// expect: [2, 4, 6]
print([3, -1, 4] |> filter(pos))
// expect: [3, 4]
print([2, 1, 3] |> sort)
// expect: [1, 2, 3]
print(5 |> double)
// expect: 10
let r = [1, 2, 3] |> map(double) |> reduce(0, fn(a, b) { return a + b })
print(r)
// expect: 12
print("hi" |> len)
// expect: 2
print([-2, 3, -1] |> filter(pos) |> map(double))
// expect: [6]

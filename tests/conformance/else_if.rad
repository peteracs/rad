// backend: both
// else-if chains

let x = 15

if x > 20 {
    print("big")
} else if x > 10 {
    print("medium")
} else {
    print("small")
}
// expect: medium

if x > 100 {
    print("huge")
} else if x > 50 {
    print("large")
} else if x > 20 {
    print("big")
} else if x > 10 {
    print("medium")
} else if x > 0 {
    print("small")
} else {
    print("zero")
}
// expect: medium

// else-if without trailing else
let y = 3
if y == 1 {
    print("one")
} else if y == 2 {
    print("two")
} else if y == 3 {
    print("three")
}
// expect: three

// else-if with side effects
let mut counter = 0
if false {
    counter = counter + 1
} else if true {
    counter = counter + 10
} else {
    counter = counter + 100
}
print(counter)
// expect: 10

// nested if inside else-if branch
let a = 5
let b = 3
if a < b {
    print("a < b")
} else if a > b {
    if b > 2 {
        print("a > b and b > 2")
    } else {
        print("a > b and b <= 2")
    }
} else {
    print("equal")
}
// expect: a > b and b > 2

// else-if with and/or
let p = true
let q = false
if p and q {
    print("both")
} else if p or q {
    print("either")
} else {
    print("neither")
}
// expect: either

// first branch true — verify short-circuit
if true {
    print("first")
} else if true {
    print("second")
} else {
    print("third")
}
// expect: first

// all false — hits final else
if false {
    print("a")
} else if false {
    print("b")
} else if false {
    print("c")
} else {
    print("d")
}
// expect: d

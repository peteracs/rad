// range, min, max, abs, typeof, str, int, float, contains, keys
print(range(4))
// expect: [0, 1, 2, 3]
print(range(2, 5))
// expect: [2, 3, 4]
print(min(3, 7))
// expect: 3
print(max(3, 7))
// expect: 7
print(abs(-9))
// expect: 9
print(typeof(42))
// expect: int
print(typeof(true))
// expect: bool
print(typeof([]))
// expect: list
print(str(100))
// expect: 100
print(int("42"))
// expect: 42
print(float("2.5"))
// expect: 2.5
component Box { a: 0, b: 0 }
let c = Box { a: 1, b: 2 }
print(str(keys(c)))
// expect: ["a", "b"]

// Literals, indexing, push, sort, reverse, slice, map, filter, reduce
let xs = [3, 1, 4]
print(xs[1])
// expect: 1
print(push(xs, 5))
// expect: [3, 1, 4, 5]
print(sort([2, 1, 3]))
// expect: [1, 2, 3]
print(reverse([1, 2, 3]))
// expect: [3, 2, 1]
print(slice([0, 1, 2, 3], 1, 3))
// expect: [1, 2]
fn inc(n) {
    return n + 1
}
print(map([1, 2, 3], inc))
// expect: [2, 3, 4]
fn big(n) {
    return n >= 2
}
print(filter([1, 2, 3, 4], big))
// expect: [2, 3, 4]
fn add(a, b) {
    return a + b
}
print(reduce([1, 2, 3, 4], 0, add))
// expect: 10
print(len([1, 2, 3]))
// expect: 3
print(contains([1, 2, 3], 2))
// expect: true

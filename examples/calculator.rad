// =====================================================================
//  Calculator — Pipeline-based expression evaluation
// =====================================================================

pure fn add(a, b) { return a + b }

pure fn sub(a, b) { return a - b }

pure fn mul(a, b) { return a * b }

pure fn add5(x) { return add(x, 5) }

pure fn mul3(x) { return mul(x, 3) }

pure fn sub10(x) { return sub(x, 10) }

fn div(a, b) {
    if b == 0 { return 0 }
    return a / b
}

pure fn clamp(val, low, high) {
    if val < low { return low }
    if val > high { return high }
    return val
}

pure fn factorial(n) {
    if n <= 1 { return 1 }
    let mut result = 1
    let mut i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

fn fibonacci(n) {
    if n <= 0 { return [] }
    if n == 1 { return [0] }
    let mut result = [0, 1]
    let mut i = 2
    while i < n {
        let next = result[i - 1] + result[i - 2]
        result = push(result, next)
        i = i + 1
    }
    return result
}

pure fn is_prime(n) {
    if n < 2 { return false }
    if n == 2 { return true }
    if n % 2 == 0 { return false }
    let mut i = 3
    while i * i <= n {
        if n % i == 0 { return false }
        i = i + 2
    }
    return true
}

fn main() -> any {
    print("=== Pipeline Calculator ===\n")

    // Basic arithmetic pipeline
    let result = 10
    |> add5
    |> mul3
    |> sub10
    print(f"(10 + 5) * 3 - 10 = {result}")

    // Factorial pipeline
    let factorials = range(10)
    |> map(factorial)
    print(f"Factorials 0-9: {factorials}")

    // Fibonacci
    let fib = fibonacci(15)
    print(f"Fibonacci(15): {fib}")

    let fib_sum = fib |> reduce(0, fn(a, b) { return a + b })
    print(f"Sum of first 15 Fibonacci: {fib_sum}")

    let even_fibs = fib
    |> filter(fn(n) { return n > 0 and n % 2 == 0 })
    print(f"Even Fibonacci: {even_fibs}")

    // Prime finder
    print("")
    let primes = range(2, 50)
    |> filter(is_prime)
    print(f"Primes under 50: {primes}")
    print(f"Count: {len(primes)}")

    let prime_sum = primes |> reduce(0, fn(a, b) { return a + b })
    print(f"Sum of primes under 50: {prime_sum}")

    // Clamping pipeline
    print("")
    let values = [150, -20, 75, 200, 0, 50, -100, 99]
    let clamped = values |> map(fn(v) { return clamp(v, 0, 100) })
    print(f"Values:  {values}")
    print(f"Clamped: {clamped}")

    // Complex pipeline: statistical operations
    print("")
    let data = [23, 45, 12, 67, 89, 34, 56, 78, 90, 11]
    let sum = data |> reduce(0, fn(a, b) { return a + b })
    let avg = sum / len(data)
    let sorted = data |> sort
    let min_val = sorted[0]
    let max_val = sorted[len(sorted) - 1]
    let mid = len(sorted) / 2
    let median = sorted[mid]

    print(f"Data: {data}")
    print(f"  Sum:    {sum}")
    print(f"  Avg:    {avg}")
    print(f"  Min:    {min_val}")
    print(f"  Max:    {max_val}")
    print(f"  Median: {median}")
    print(f"  Range:  {max_val - min_val}")
}

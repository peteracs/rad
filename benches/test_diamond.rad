use "../experiments/c-backend/src/lexer.rad"
use "../experiments/c-backend/src/parser.rad"
use "../experiments/c-backend/src/emit_c.rad"

fn main() -> nil {
    let t0 = clock()
    compile_file_to_c_unchecked("experiments/c-backend/src/emit_c.rad", "experiments/c-backend/target/diamond_output.c")
    let t1 = clock()
    let elapsed = t1 - t0
    print(f"ELAPSED:{elapsed}")
}

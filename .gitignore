.vscode/
.cursor/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Rad build artifacts
*.radc
*.bak
a.out
*_err.txt

# wasm-pack output (workflow builds core/vm/pkg; local playground builds projects/playground/pkg)

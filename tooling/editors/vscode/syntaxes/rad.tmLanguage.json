{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rad",
  "scopeName": "source.rad",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#types" },
    { "include": "#state-refs" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rad",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rad",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rad",
              "match": "\\\\[\"\\\\nrt]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.rad",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.rad",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rad",
          "match": "\\b(if|else|while|for|in|return|break|match|when)\\b"
        },
        {
          "name": "keyword.declaration.rad",
          "match": "\\b(component|entity|state|system|event|on|fn|let|mut|use|run|emit)\\b"
        },
        {
          "name": "constant.language.rad",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(component|entity|state|system|event|fn)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.rad" },
            "2": { "name": "entity.name.type.rad" }
          }
        },
        {
          "match": "\\b(fn)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.rad" },
            "2": { "name": "entity.name.function.rad" }
          }
        },
        {
          "match": "\\b(let)\\s+(mut\\s+)?([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.rad" },
            "2": { "name": "keyword.declaration.rad" },
            "3": { "name": "variable.other.rad" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.rad",
          "match": "\\b(print|len|type|str|int|float|push|pop|map|filter|reduce|range|get|set|has|remove|spawn|destroy|transition)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.rad",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.rad",
          "match": "->"
        },
        {
          "name": "keyword.operator.fat-arrow.rad",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.rad",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.rad",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.rad",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.rad",
          "match": "="
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.rad",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "state-refs": {
      "patterns": [
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)::([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.rad" },
            "2": { "name": "constant.other.state.rad" }
          }
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.rad",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.rad",
          "match": "[\\[\\]()]"
        },
        {
          "name": "punctuation.separator.rad",
          "match": "[,:]"
        }
      ]
    }
  }
}

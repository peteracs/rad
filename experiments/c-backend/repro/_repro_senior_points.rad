// backend: both
component Pos {
  x: 0
}

// Empty body: parser still appends write-back `set(__sys_e, p)` for every `mut` param.
system Touch(p: mut Pos) {
}

fn main() -> nil {
  let _e = spawn(Pos { x: 1 })
  let i = 0
  while i < 1000 {
    Touch()
    i = i + 1
  }
  print(42)
}

// expect: 42

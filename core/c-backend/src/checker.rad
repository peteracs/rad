use "parser.rad"

// Type representation as strings: "int", "float", "str", "bool", "nil",
// "entity", "list", "fn", "any", or a component/struct name.

component CheckError { line: int = 0, col: int = 0, message: str = "" }
component CheckResult { errors: list<entity> = [] }

component Binding { name: str = "", ty: str = "any", is_mut: bool = false }
component Scope { bindings: list<entity> = [], parent: entity | nil = nil }
component FnSig { name: str = "", param_types: list<str> = [], ret_type: str = "any", raw_param_types: list<str> = [] }

component CheckerState {
    scope: entity | nil = nil,
    fn_sigs: list<entity> = [],
    errors: list<entity> = [],
    current_fn_ret: str = "any",
    component_names: list<str> = [],
    struct_names: list<str> = [],
    type_names: list<str> = [],
    type_variant_names: list<str> = [],
    state_names: list<str> = [],
    state_variant_names: list<str> = [],
    field_types: list<entity> = [],
    private_types: list<str> = [],
    event_names: list<str> = []
}

component FieldTypeEntry { comp_name: str = "", field_name: str = "", field_type: str = "any" }
component CheckerFlags { compat_v05_dx: bool = false }
component TypeVariantGroup { type_name: str = "", variants: list<str> = [], variant_field_counts: list<int> = [] }

pub component CheckerNode {}

fn make_error(state: entity, line: int, col: int, msg: str) -> nil {
    let err = entity { CheckerNode {}, CheckError { line: line, col: col, message: msg } }
    let mut errs = require(state, CheckerState).errors
    errs << err
    set(state, CheckerState {
        scope: require(state, CheckerState).scope,
        fn_sigs: require(state, CheckerState).fn_sigs,
        errors: errs,
        current_fn_ret: require(state, CheckerState).current_fn_ret,
        component_names: require(state, CheckerState).component_names,
        struct_names: require(state, CheckerState).struct_names,
        type_names: require(state, CheckerState).type_names,
        type_variant_names: require(state, CheckerState).type_variant_names,
        state_names: require(state, CheckerState).state_names,
        state_variant_names: require(state, CheckerState).state_variant_names,
        field_types: require(state, CheckerState).field_types,
        private_types: require(state, CheckerState).private_types,
        event_names: require(state, CheckerState).event_names
    })
    return nil
}

fn push_scope(state: entity) -> nil {
    let old_scope = require(state, CheckerState).scope
    let new_scope = entity { CheckerNode {}, Scope { bindings: [], parent: old_scope } }
    let cs = require(state, CheckerState)
    set(state, CheckerState {
        scope: new_scope,
        fn_sigs: cs.fn_sigs,
        errors: cs.errors,
        current_fn_ret: cs.current_fn_ret,
        component_names: cs.component_names,
        struct_names: cs.struct_names,
        type_names: cs.type_names,
        type_variant_names: cs.type_variant_names,
        state_names: cs.state_names,
        state_variant_names: cs.state_variant_names,
        field_types: cs.field_types,
        private_types: cs.private_types,
        event_names: cs.event_names
    })
    return nil
}

fn pop_scope(state: entity) -> nil {
    let current = require(state, CheckerState).scope
    if current == nil {
        return nil
    } else {
        if not has(current, Scope) { return nil }
        let parent = require(current, Scope).parent
        // Keep root scope alive; extra pops should be no-ops.
        if parent == nil { return nil }
        let cs = require(state, CheckerState)
        set(state, CheckerState {
            scope: parent,
            fn_sigs: cs.fn_sigs,
            errors: cs.errors,
            current_fn_ret: cs.current_fn_ret,
            component_names: cs.component_names,
            struct_names: cs.struct_names,
            type_names: cs.type_names,
            type_variant_names: cs.type_variant_names,
            state_names: cs.state_names,
            state_variant_names: cs.state_variant_names,
            field_types: cs.field_types,
            private_types: cs.private_types,
            event_names: cs.event_names
        })
    }
    return nil
}

fn define_var(state: entity, name: str, ty: str, is_mut: bool) -> nil {
    let scope0 = require(state, CheckerState).scope
    if scope0 == nil {
        push_scope(state)
    } else {
        if not has(scope0, Scope) {
            push_scope(state)
        }
    }
    let scope_eid = require(state, CheckerState).scope
    if scope_eid == nil { return nil }
    let b = entity { CheckerNode {}, Binding { name: name, ty: ty, is_mut: is_mut } }
    let mut bindings = require(scope_eid, Scope).bindings
    bindings << b
    set(scope_eid, Scope { bindings: bindings, parent: require(scope_eid, Scope).parent })
    return nil
}

// Scope chains are walked recursively so `if scope_eid == nil { ... } else { ... }` narrows
// `entity | nil` for the Rust VM checker. Depth equals lexical scope depth (small); a `while`
// would need loop-body narrowing the VM does not implement yet.
fn var_exists_inner(scope_eid: entity | nil, name: str) -> bool {
    if scope_eid == nil {
        return false
    } else {
        if not has(scope_eid, Scope) { return false }
        let sc = require(scope_eid, Scope)
        for b_eid in sc.bindings {
            let b = require(b_eid, Binding)
            if b.name == name { return true }
        }
        return var_exists_inner(sc.parent, name)
    }
}

fn var_exists(state: entity, name: str) -> bool {
    return var_exists_inner(require(state, CheckerState).scope, name)
}

fn lookup_var_inner(scope_eid: entity | nil, name: str) -> str {
    if scope_eid == nil {
        return "any"
    } else {
        if not has(scope_eid, Scope) { return "any" }
        let sc = require(scope_eid, Scope)
        for b_eid in sc.bindings {
            let b = require(b_eid, Binding)
            if b.name == name { return b.ty }
        }
        return lookup_var_inner(sc.parent, name)
    }
}

fn lookup_var(state: entity, name: str) -> str {
    return lookup_var_inner(require(state, CheckerState).scope, name)
}

fn lookup_var_mut_inner(scope_eid: entity | nil, name: str) -> bool {
    if scope_eid == nil {
        return false
    } else {
        if not has(scope_eid, Scope) { return false }
        let sc = require(scope_eid, Scope)
        for b_eid in sc.bindings {
            let b = require(b_eid, Binding)
            if b.name == name { return b.is_mut }
        }
        return lookup_var_mut_inner(sc.parent, name)
    }
}

fn lookup_var_mut(state: entity, name: str) -> bool {
    return lookup_var_mut_inner(require(state, CheckerState).scope, name)
}

fn get_parent_type_of_variant(variant_name: str) -> str {
    for tvg_eid in query { TypeVariantGroup } {
        let tvg = require(tvg_eid, TypeVariantGroup)
        if str_in_list(tvg.variants, variant_name) { return tvg.type_name }
    }
    return ""
}

fn get_type_variants(type_name: str) -> list<str> {
    for tvg_eid in query { TypeVariantGroup } {
        let tvg = require(tvg_eid, TypeVariantGroup)
        if tvg.type_name == type_name { return tvg.variants }
    }
    return []
}

fn is_zero_field_variant(variant_name: str) -> bool {
    for tvg_eid in query { TypeVariantGroup } {
        let tvg = require(tvg_eid, TypeVariantGroup)
        let mut i = 0
        for vn in tvg.variants {
            if vn == variant_name {
                if i < len(tvg.variant_field_counts) {
                    return tvg.variant_field_counts[i] == 0
                }
            }
            i = i + 1
        }
    }
    return false
}

fn outer_scope_has_mut(state: entity, name: str) -> bool {
    let scope = require(state, CheckerState).scope
    if scope != nil {
        if not has(scope, Scope) { return false }
        let sc = require(scope, Scope)
        return lookup_var_mut_inner(sc.parent, name)
    }
    return false
}

fn find_fn_sig(state: entity, name: str) -> Option<entity> {
    let sigs = require(state, CheckerState).fn_sigs
    for s_eid in sigs {
        let s = require(s_eid, FnSig)
        if s.name == name { return Some(s_eid) }
    }
    return None
}

fn base_type(t: str) -> str {
    let blen = byte_len(t)
    let mut i = 0
    while i < blen {
        let c = byte_at(t, i)
        if c == 60 { return substring_bytes(t, 0, i) }
        i = i + 1
    }
    return t
}

fn str_in_list(lst: list<str>, item: str) -> bool {
    for s in lst {
        if s == item { return true }
    }
    return false
}

fn is_value_type(t: str) -> bool {
    return t == "int" or t == "float" or t == "str" or t == "bool" or t == "list" or t == "fn"
}

fn resolve_type_str(state: entity, t: str) -> str {
    if t == "" { return "any" }
    let b = base_type(t)
    if b == "int" { return "int" }
    if b == "float" { return "float" }
    if b == "str" { return "str" }
    if b == "bool" { return "bool" }
    if b == "nil" { return "nil" }
    if b == "entity" { return "entity" }
    if b == "list" { return "list" }
    if b == "fn" { return "fn" }
    if b == "any" { return "any" }
    let cs = require(state, CheckerState)
    if str_in_list(cs.component_names, b) { return b }
    if str_in_list(cs.struct_names, b) { return b }
    if str_in_list(cs.type_names, b) { return b }
    if str_in_list(cs.type_variant_names, b) { return b }
    return "any"
}

fn types_compatible(expected: str, actual: str) -> bool {
    if expected == "any" or actual == "any" { return true }
    if expected == actual { return true }
    if expected == "nil" or actual == "nil" { return true }
    if expected == "float" and actual == "int" { return true }
    if expected == "int" and actual == "float" { return true }
    if expected == "entity" and not is_value_type(actual) { return true }
    if actual == "entity" and not is_value_type(expected) { return true }
    // Tagged variants should satisfy their parent sum type at boundaries.
    let expected_parent = get_parent_type_of_variant(expected)
    if expected_parent != "" and expected_parent == actual { return true }
    let actual_parent = get_parent_type_of_variant(actual)
    if actual_parent != "" and actual_parent == expected { return true }
    return false
}

fn lookup_field_type(state: entity, comp_name: str, field_name: str) -> str {
    let fts = require(state, CheckerState).field_types
    for ft_eid in fts {
        let ft = require(ft_eid, FieldTypeEntry)
        if ft.comp_name == comp_name and ft.field_name == field_name {
            return ft.field_type
        }
    }
    return "any"
}

fn get_span(eid: entity) -> Option<entity> {
    if has(eid, Span) { return Some(eid) }
    return None
}

fn get_line(eid: entity) -> int {
    if has(eid, Span) {
        return require(eid, Span).line
    }
    return 0
}

fn get_col(eid: entity) -> int {
    if has(eid, Span) {
        return require(eid, Span).col
    }
    return 0
}


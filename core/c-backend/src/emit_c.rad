use "lexer.rad"
use "parser.rad"
use "checker.rad"

pub component HoistedName { name: str = "" }
component EmitCompat { compat_v05_dx: bool = false }
pub component EmitCtx {
    env_names: list<str> = [],
    closure_names: list<str> = [],
    builtins: map<str, str> = {},
    comp_fields: map<str, list<str>> = {},
    value_vars: map<str, str> = {},
    radcomp_locals: list<str> = [],
    fn_ret_type: str = "",
    fn_ret_types: map<str, str> = {},
    fn_param_types: map<str, list<str>> = {},
    comp_params: map<str, str> = {},
    type_aliases: map<str, str> = {},
    state_names: list<str> = [],
    type_names: list<str> = []
}

fn make_emit_ctx(env_names: list<str>, closure_names: list<str>, builtins: map<str, str>, comp_fields: map<str, list<str>>, value_vars: map<str, str>, radcomp_locals: list<str>, fn_ret_type: str, fn_ret_types: map<str, str>, fn_param_types: map<str, list<str>>, comp_params: map<str, str>, type_aliases: map<str, str>, state_names: list<str>, type_names: list<str>) -> EmitCtx {
    return EmitCtx { env_names: env_names, closure_names: closure_names, builtins: builtins, comp_fields: comp_fields, value_vars: value_vars, radcomp_locals: radcomp_locals, fn_ret_type: fn_ret_type, fn_ret_types: fn_ret_types, fn_param_types: fn_param_types, comp_params: comp_params, type_aliases: type_aliases, state_names: state_names, type_names: type_names }
}

fn collect_comp_fields(root: entity) -> map<str, list<str>> {
    let mut result: map<str, list<str>> = {}
    if not has(root, Program) { return result }
    let p = require(root, Program)
    for d in p.decls {
        if has(d, ComponentDecl) {
            let cd = require(d, ComponentDecl)
            let mut fields: list<str> = []
            for f_eid in cd.fields {
                let cf = require(f_eid, ComponentField)
                fields << cf.name
            }
            result[cd.name] = fields
        }
        if has(d, StructDecl) {
            let sd = require(d, StructDecl)
            let mut fields: list<str> = []
            for f_eid in sd.fields {
                let cf = require(f_eid, ComponentField)
                fields << cf.name
            }
            result[sd.name] = fields
        }
    }
    return result
}

fn collect_variant_fields(root: entity) -> map<str, list<str>> {
    let mut result: map<str, list<str>> = {}
    if not has(root, Program) { return result }
    let p = require(root, Program)
    for d in p.decls {
        if has(d, TypeDecl) {
            let td = require(d, TypeDecl)
            for v_eid in td.variants {
                let tv = require(v_eid, TypeVariant)
                let mut fields: list<str> = []
                for f_eid in tv.fields {
                    if has(f_eid, VariantField) {
                        fields << require(f_eid, VariantField).name
                    } else if has(f_eid, ComponentField) {
                        fields << require(f_eid, ComponentField).name
                    }
                }
                result[f"{td.name}_{tv.name}"] = fields
            }
        }
        if has(d, ComponentDecl) {
            let cd = require(d, ComponentDecl)
            let mut fields: list<str> = []
            for f_eid in cd.fields {
                let cf = require(f_eid, ComponentField)
                fields << cf.name
            }
            result[cd.name] = fields
        }
    }
    return result
}

fn is_comp_type(name: str, comp_fields: map<str, list<str>>) -> bool {
    if name == "" { return false }
    if contains(name, "<") { return false }
    return contains(keys(comp_fields), name)
}

fn trim_ascii_whitespace(s: str) -> str {
    let mut start = 0
    let mut end = byte_len(s)
    while start < end {
        let ch = byte_at(s, start)
        if ch != 32 and ch != 9 and ch != 10 and ch != 13 { break }
        start = start + 1
    }
    while end > start {
        let ch = byte_at(s, end - 1)
        if ch != 32 and ch != 9 and ch != 10 and ch != 13 { break }
        end = end - 1
    }
    if start == 0 and end == byte_len(s) { return s }
    return substring_bytes(s, start, end)
}

fn remove_ascii_whitespace(s: str) -> str {
    let mut out = ""
    let mut i = 0
    while i < byte_len(s) {
        let b = byte_at(s, i)
        if not (b == 32 or b == 9 or b == 10 or b == 13) {
            out = f"{out}{chr(b)}"
        }
        i = i + 1
    }
    return out
}

fn annotation_head(name: str) -> str {
    let trimmed = trim_ascii_whitespace(name)
    let mut i = 0
    while i < byte_len(trimmed) {
        if byte_at(trimmed, i) == 60 {
            return trim_ascii_whitespace(substring_bytes(trimmed, 0, i))
        }
        i = i + 1
    }
    return trimmed
}

/// Qualified name for C dispatch: `system::a::b` → `a.b` (matches VM `system_ref_qualified_string`).
fn system_ref_emit_str(path: list<str>) -> str {
    if len(path) == 0 { return "" }
    if len(path) == 1 { return path[0] }
    let mut s = path[0]
    let mut i = 1
    while i < len(path) {
        s = f"{s}.{path[i]}"
        i = i + 1
    }
    return s
}

fn collect_value_typed_lets(body: entity, comp_fields: map<str, list<str>>) -> map<str, str> {
    let mut result: map<str, str> = {}
    if not has(body, BlockStmt) { return result }
    let b = require(body, BlockStmt)
    for st in b.stmts {
        if has(st, LetStmt) {
            let s = require(st, LetStmt)
            if len(s.names) == 1 and is_comp_type(s.type_ann, comp_fields) {
                result[s.names[0]] = s.type_ann
            }
        }
        if has(st, IfStmt) {
            let ifs = require(st, IfStmt)
            let sub = collect_value_typed_lets(ifs.then_block, comp_fields)
            for k in keys(sub) { result[k] = sub[k] }
            let eb = ifs.else_block
            if eb != nil {
                let esub = collect_value_typed_lets(eb, comp_fields)
                for k in keys(esub) { result[k] = esub[k] }
            }
        }
        if has(st, WhileStmt) {
            let ws = require(st, WhileStmt)
            let sub = collect_value_typed_lets(ws.body, comp_fields)
            for k in keys(sub) { result[k] = sub[k] }
        }
        if has(st, ForStmt) {
            let fs = require(st, ForStmt)
            let sub = collect_value_typed_lets(fs.body, comp_fields)
            for k in keys(sub) { result[k] = sub[k] }
        }
        if has(st, MatchStmt) {
            let ms = require(st, MatchStmt)
            for c_eid in ms.cases {
                let mc = require(c_eid, MatchCase)
                let sub = collect_value_typed_lets(mc.body, comp_fields)
                for k in keys(sub) { result[k] = sub[k] }
            }
        }
    }
    return result
}

fn collect_radcomp_struct_lets(body: entity, comp_fields: map<str, list<str>>) -> list<str> {
    let mut result: list<str> = []
    if not has(body, BlockStmt) { return result }
    let b = require(body, BlockStmt)
    for st in b.stmts {
        if has(st, LetStmt) {
            let s = require(st, LetStmt)
            if len(s.names) == 1 and is_comp_type(s.type_ann, comp_fields) {
                if not list_contains(result, s.names[0]) {
                    result << s.names[0]
                }
            }
        }
        if has(st, IfStmt) {
            let ifs = require(st, IfStmt)
            let sub = collect_radcomp_struct_lets(ifs.then_block, comp_fields)
            for x in sub {
                if not list_contains(result, x) {
                    result << x
                }
            }
            let eb = ifs.else_block
            if eb != nil {
                let esub = collect_radcomp_struct_lets(eb, comp_fields)
                for x in esub {
                    if not list_contains(result, x) {
                        result << x
                    }
                }
            }
        }
        if has(st, WhileStmt) {
            let ws = require(st, WhileStmt)
            let sub = collect_radcomp_struct_lets(ws.body, comp_fields)
            for x in sub {
                if not list_contains(result, x) {
                    result << x
                }
            }
        }
        if has(st, ForStmt) {
            let fs = require(st, ForStmt)
            let sub = collect_radcomp_struct_lets(fs.body, comp_fields)
            for x in sub {
                if not list_contains(result, x) {
                    result << x
                }
            }
        }
        if has(st, MatchStmt) {
            let ms = require(st, MatchStmt)
            for c_eid in ms.cases {
                let mc = require(c_eid, MatchCase)
                let sub = collect_radcomp_struct_lets(mc.body, comp_fields)
                for x in sub {
                    if not list_contains(result, x) {
                        result << x
                    }
                }
            }
        }
    }
    return result
}

fn collect_fn_ret_types(root: entity, comp_fields: map<str, list<str>>) -> map<str, str> {
    let mut result: map<str, str> = {}
    if not has(root, Program) { return result }
    let p = require(root, Program)
    for d in p.decls {
        if has(d, FnDecl) {
            let f = require(d, FnDecl)
            if is_comp_type(f.ret_type, comp_fields) {
                result[f.name] = f.ret_type
            }
        }
    }
    return result
}

fn collect_fn_param_types(root: entity) -> map<str, list<str>> {
    let mut result: map<str, list<str>> = {}
    if not has(root, Program) { return result }
    let p = require(root, Program)
    for d in p.decls {
        if has(d, FnDecl) {
            let f = require(d, FnDecl)
            let mut types: list<str> = []
            for p_eid in f.params {
                let param = require(p_eid, Param)
                types << param.type_str
            }
            result[f.name] = types
        }
    }
    return result
}

fn is_ident_start(c: int) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

fn is_ident_continue(c: int) -> bool {
    return is_ident_start(c) or (c >= 48 and c <= 57)
}

fn sanitize_ident(name: str) -> str {
    if len(name) == 0 { return "_v" }
    let mut out = ""
    let mut i = 0
    while i < byte_len(name) {
        let c = byte_at(name, i)
        let ch = substring_bytes(name, i, i + 1)
        if i == 0 {
            if is_ident_start(c) {
                out = f"{out}{ch}"
            } else if c >= 48 and c <= 57 {
                out = f"{out}_{ch}"
            } else {
                out = f"{out}_"
            }
        } else {
            if is_ident_continue(c) {
                out = f"{out}{ch}"
            } else {
                out = f"{out}_"
            }
        }
        i = i + 1
    }
    return out
}


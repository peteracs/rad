// Template V(n) = K log2 n + g(n mod 2^k). States are residues mod 2^k; a step
// from r goes to T(r + 2^k u) mod 2^k for the two possible values of bit k.
// Edge growth in log2: odd step +log2(3/2) = 0.584963, even step -1 (micro-bits).
// A template succeeds (for large K) iff every abstract cycle has negative mean
// growth; Karp's algorithm finds the maximum mean cycle exactly.
pub pure fn tstep(x: int) -> int { return if x % 2 == 0 { int_div(x, 2) } else { int_div(3 * x + 1, 2) } }

pub pure fn successors(r: int, k: int) -> list<int> {
    let m: int = 1 << k
    let mut out: list<int> = []
    for u in [0, 1] {
        let n: int = r + m * u + m * 4     // large positive representative
        out = push(out, tstep(n) % m)
    }
    return out
}

pub pure fn growth(r: int) -> int { return if r % 2 == 1 { 584963 } else { 0 - 1000000 } }

pub struct Witness {
    k: int = 0
    mean_growth_micro: int = 0     // max cycle mean (micro-bits per step)
    cycle: list<int> = []          // residues along the maximizing cycle
    parity: str = ""               // its parity word
    point_num: int = 0             // 2-adic fixed point x = C / (2^j - 3^q), reduced
    point_den: int = 1
    template_ok: bool = false
}

// Karp's maximum mean cycle with cycle recovery.
pub pure fn graph(k: int) -> list<list<int>> {
    let mut succ: list<list<int>> = []
    for r in range(1 << k) { succ = push(succ, successors(r, k)) }
    return succ
}

pub pure fn max_mean_cycle(k: int) -> Witness { return karp(k, graph(k)) }

pub pure fn karp(k: int, succ: list<list<int>>) -> Witness {
    let n: int = 1 << k
    let neg: int = 0 - (1 << 60)
    // D[i][v] = max weight of a walk of exactly i edges ending at v (any start).
    let mut rows: list<list<int>> = []
    let mut zeros: list<int> = []
    for _ in range(n) { zeros = push(zeros, 0) }
    rows = push(rows, zeros)
    let mut parent: list<list<int>> = [zeros]
    for i in range(1, n + 1) {
        let prev: list<int> = rows[i - 1]
        let mut cur: list<int> = []
        let mut par: list<int> = []
        for _ in range(n) { cur = push(cur, neg) par = push(par, 0 - 1) }
        for v in range(n) {
            if prev[v] > neg {
                for w in succ[v] {
                    let cand: int = prev[v] + growth(v)
                    if cand > cur[w] { cur = set_at(cur, w, cand) par = set_at(par, w, v) }
                }
            }
        }
        rows = push(rows, cur)
        parent = push(parent, par)
    }
    // mean = max_v min_i (D[n][v] - D[i][v]) / (n - i)   (scaled by 1e6 already)
    let mut best: int = neg
    let mut best_v: int = 0
    for v in range(n) {
        if rows[n][v] > neg {
            let mut worst: int = 1 << 60
            for i in range(n) {
                if rows[i][v] > neg {
                    let m: int = int_div(rows[n][v] - rows[i][v], n - i)
                    if m < worst { worst = m }
                }
            }
            if worst > best { best = worst best_v = v }
        }
    }
    // Recover a cycle by walking parents back from (n, best_v) until a state repeats.
    let mut seen: list<int> = []
    let mut path: list<int> = []
    let mut v: int = best_v
    let mut i: int = n
    let mut cycle: list<int> = []
    let mut found: bool = false
    while i > 0 and not found {
        let idx: int = index_of(seen, v)
        if idx >= 0 {
            cycle = slice(path, idx, len(path))
            found = true
        } else {
            seen = push(seen, v)
            path = push(path, v)
            v = parent[i][v]
            i = i - 1
        }
    }
    // path was walked backwards: reverse to forward order
    let mut forward: list<int> = []
    let mut j: int = len(cycle) - 1
    while j >= 0 { forward = push(forward, cycle[j]) j = j - 1 }
    // Parity word and exact 2-adic fixed point of the periodic pattern.
    let mut word: str = ""
    let mut c: int = 0
    let mut p3: int = 1
    let mut t: int = 0
    for r in forward {
        if r % 2 == 1 { word = word + "o" c = 3 * c + (1 << t) p3 = 3 * p3 } else { word = word + "e" }
        t = t + 1
    }
    let den: int = (1 << t) - p3
    let g: int = gcd(c, den)
    let mut num: int = int_div(c, g)
    let mut d: int = int_div(den, g)
    if d < 0 { num = 0 - num d = 0 - d }
    return Witness { k: k, mean_growth_micro: best, cycle: forward, parity: word, point_num: num, point_den: d, template_ok: best < 0 }
}

pub pure fn gcd(a: int, b: int) -> int {
    let mut x: int = abs(a)
    let mut y: int = abs(b)
    while y != 0 { let r: int = x % y x = y y = r }
    return x
}

pub pure fn index_of(xs: list<int>, v: int) -> int {
    for i in range(len(xs)) { if xs[i] == v { return i } }
    return 0 - 1
}

// Remove the witness cycle's edges: the refinement "a counter pays for this pattern".
pub pure fn remove_cycle(succ: list<list<int>>, cycle: list<int>) -> list<list<int>> {
    let mut out: list<list<int>> = succ
    for i in range(len(cycle)) {
        let v: int = cycle[i]
        let w: int = cycle[(i + 1) % len(cycle)]
        let mut kept: list<int> = []
        let mut dropped: bool = false
        for x in out[v] { if x == w and not dropped { dropped = true } else { kept = push(kept, x) } }
        out = set_at(out, v, kept)
    }
    return out
}

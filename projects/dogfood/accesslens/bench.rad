use "schema.rad"
use "owners/access_owner.rad"
use "systems/policy.rad"
use "scenarios/production.rad"

fn main() -> nil {
    let receipt = summarize_access_batch(100000, 10000)
    set_resource(AccessLensBatchReceipt, receipt)
    assert(res(AccessLensBatchReceipt).deployers == 90000, "trusted unrevoked deployer count exact")
    print(f"accesslens-bench: users=100000 revoked=10000 deployers={res(AccessLensBatchReceipt).deployers}")
}

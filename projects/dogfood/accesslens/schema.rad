pub opaque type UserId = u64
pub opaque type RevocationBatchId = u64

pub resource AccessLensBatchReceipt {
    users: int = 0,
    revoked: int = 0,
    deployers: int = 0,
}

pub event EntitlementRevoked {
    user: entity,
    batch: RevocationBatchId,
    reason: str,
}

pub event AccessDecisionPublished {
    user: entity,
    allowed: bool,
}

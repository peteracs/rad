use "schema.rad"
use "owners/catalog_owner.rad"
use "scenarios/production.rad"

fn main() -> nil {
    let receipt = summarize_catalog_batch(1000000, 50000)
    set_resource(MarketLensBatchReceipt, receipt)
    assert(res(MarketLensBatchReceipt).initial_sellable == 857142, "million-product initial view exact")
    assert(res(MarketLensBatchReceipt).final_sellable == 862111, "incremental updates exact")
    assert(res(MarketLensBatchReceipt).revision == 865837, "view revision exact")
    print(f"marketlens-bench: products=1000000 updates=50000 revision={res(MarketLensBatchReceipt).revision}")
}

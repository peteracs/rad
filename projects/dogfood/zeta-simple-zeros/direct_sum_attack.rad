// Multi-window bandwidth-one attack on the 70% simple-zero boundary.
// Complementary cosine kernels are convexly combined so one kernel can fill
// the other's transform zeros without asking the prime side for bandwidth > 1.

use "../native-math-kernels/math_kernels.rad"

let SCALE = 1000000000
let A_MIN_MICROS = 720000
let A_MAX_MICROS = 1560000
let A_STEP_MICROS = 20000
let WEIGHT_MIN_PPM = 0
let WEIGHT_MAX_PPM = 1000000
let WEIGHT_STEP_PPM = 20000
let TARGET_SCALED = 700000000

pure fn a_count() -> int {
    return (A_MAX_MICROS - A_MIN_MICROS) / A_STEP_MICROS + 1
}

pure fn weight_count() -> int {
    return (WEIGHT_MAX_PPM - WEIGHT_MIN_PPM) / WEIGHT_STEP_PPM + 1
}

resource DirectSumUniverse {
    companion_a_micros: int = 0
    companion_weight_ppm: int = 0
    baseline_scaled: int = 0
    best_q_scaled: int = 0
    local_a_scaled: int = 0
    minimizing_gap_micros: int = 0
    simple_bound_scaled: int = 0
    evaluated: bool = false
}

system EvaluateDirectSum(candidate: mut DirectSumUniverse) {
    let report = zeta_cosine_direct_sum_scout(
        candidate.companion_a_micros,
        candidate.companion_weight_ppm,
    )
    assert(not report["rigorous"], "sampled direct-sum scout mislabeled as rigorous")
    assert(report["scale"] == SCALE, "direct-sum scout scale mismatch")
    candidate = DirectSumUniverse {
        companion_a_micros: report["companion_a_micros"],
        companion_weight_ppm: report["companion_weight_ppm"],
        baseline_scaled: report["baseline_scaled"],
        best_q_scaled: report["best_q_scaled"],
        local_a_scaled: report["local_a_scaled"],
        minimizing_gap_micros: report["minimizing_gap_micros"],
        simple_bound_scaled: report["simple_bound_scaled"],
        evaluated: true,
    }
}

component DirectSumExpectation {
    proposal_count: int = 0
}

component DirectSumSelection {
    proposal_count: int = 0
    cells_seen: list = []
    best_companion_a_micros: int = 0
    best_companion_weight_ppm: int = 0
    best_baseline_scaled: int = 0
    best_q_scaled: int = 0
    best_local_a_scaled: int = 0
    best_gap_micros: int = 0
    best_simple_bound_scaled: int = 0
    crossing_count: int = 0
}

intent DirectSumFinding {
    key target: entity
    candidate: DirectSumUniverse
}

law SubmitDirectSum(target: entity, candidate: DirectSumUniverse) {
    propose DirectSumFinding { target: target, candidate: candidate }
}

resolver SelectDirectSum for DirectSumFinding(target, proposals) {
    let expected = require(target, DirectSumExpectation)
    let mut seen = []
    for _index in range(expected.proposal_count) {
        seen = push(seen, 0)
    }
    let mut best = DirectSumUniverse {}
    let mut crossing_count = 0
    for proposal in proposals {
        let candidate = proposal.candidate
        assert(candidate.evaluated, "unevaluated direct-sum proposal")
        assert(candidate.companion_a_micros >= A_MIN_MICROS, "companion window below grid")
        assert(candidate.companion_a_micros <= A_MAX_MICROS, "companion window above grid")
        assert((candidate.companion_a_micros - A_MIN_MICROS) % A_STEP_MICROS == 0, "companion window off grid")
        assert(candidate.companion_weight_ppm >= WEIGHT_MIN_PPM, "companion weight below grid")
        assert(candidate.companion_weight_ppm <= WEIGHT_MAX_PPM, "companion weight above grid")
        assert((candidate.companion_weight_ppm - WEIGHT_MIN_PPM) % WEIGHT_STEP_PPM == 0, "companion weight off grid")
        let a_slot = (candidate.companion_a_micros - A_MIN_MICROS) / A_STEP_MICROS
        let weight_slot = (candidate.companion_weight_ppm - WEIGHT_MIN_PPM) / WEIGHT_STEP_PPM
        let slot = a_slot * weight_count() + weight_slot
        assert(seen[slot] == 0, "duplicate direct-sum proposal")
        seen = set_at(seen, slot, 1)

        if candidate.simple_bound_scaled >= TARGET_SCALED {
            crossing_count = crossing_count + 1
        }
        if candidate.simple_bound_scaled > best.simple_bound_scaled
        or (candidate.simple_bound_scaled == best.simple_bound_scaled
            and candidate.companion_a_micros < best.companion_a_micros)
        or (candidate.simple_bound_scaled == best.simple_bound_scaled
            and candidate.companion_a_micros == best.companion_a_micros
            and candidate.companion_weight_ppm < best.companion_weight_ppm) {
            best = candidate
        }
    }

    next(target, DirectSumSelection {
        proposal_count: len(proposals),
        cells_seen: seen,
        best_companion_a_micros: best.companion_a_micros,
        best_companion_weight_ppm: best.companion_weight_ppm,
        best_baseline_scaled: best.baseline_scaled,
        best_q_scaled: best.best_q_scaled,
        best_local_a_scaled: best.local_a_scaled,
        best_gap_micros: best.minimizing_gap_micros,
        best_simple_bound_scaled: best.simple_bound_scaled,
        crossing_count: crossing_count,
    })
}

constraint CompleteDirectSumScan
for DirectSumSelection(subject, proposed)
watches DirectSumExpectation
{
    let expected = candidate(subject, DirectSumExpectation)
    require proposed.proposal_count == expected.proposal_count else "zeta.70.direct_sum_count"
    require len(proposed.cells_seen) == expected.proposal_count else "zeta.70.direct_sum_shape"
    let mut total = 0
    for seen in proposed.cells_seen {
        total = total + seen
    }
    require total == expected.proposal_count else "zeta.70.direct_sum_partition"
    require proposed.best_companion_a_micros >= A_MIN_MICROS else "zeta.70.direct_sum_best_missing"
}

entity direct_sum_judge {
    DirectSumExpectation {}
    DirectSumSelection {}
}

entity reversed_direct_sum_judge {
    DirectSumExpectation {}
    DirectSumSelection {}
}

event DirectSumBatchReady {
    target: entity
    candidates: list
    reverse_order: bool
}

on DirectSumBatchReady(evt) {
    settle {
        if evt.reverse_order {
            for index in range(len(evt.candidates)) {
                SubmitDirectSum(evt.target, evt.candidates[len(evt.candidates) - index - 1])
            }
        } else {
            for candidate in evt.candidates {
                SubmitDirectSum(evt.target, candidate)
            }
        }
    }
}

fn explore_direct_sums() -> map<str, any> {
    let live_before = world_digest()
    let root = fork()
    let mut candidates = []
    for a_slot in range(a_count()) {
        for weight_slot in range(weight_count()) {
            candidates = push(candidates, fork_with(root, DirectSumUniverse {
                companion_a_micros: A_MIN_MICROS + a_slot * A_STEP_MICROS,
                companion_weight_ppm: WEIGHT_MIN_PPM + weight_slot * WEIGHT_STEP_PPM,
            }))
        }
    }
    let futures = simulate_many(candidates, [system::EvaluateDirectSum], 1, 2017)
    assert(world_digest() == live_before, "direct-sum forks mutated live state")

    let mut reports = []
    let mut first_wire_digest = ""
    let mut last_wire_digest = ""
    for future in futures {
        assert_only_changed(root, future, [DirectSumUniverse])
        let wire = fork_to_bytes(future)
        let restored = fork_from_bytes(wire) |> unwrap
        assert(world_digest(restored) == world_digest(future), "direct-sum wire roundtrip changed a fork")
        let report = peek_resource(restored, DirectSumUniverse) |> unwrap
        assert(report.evaluated, "direct-sum fork did not execute")
        reports = push(reports, report)
        if first_wire_digest == "" {
            first_wire_digest = world_digest(restored)
        }
        last_wire_digest = world_digest(restored)
    }
    let result: map<str, any> = {
        "candidates": reports,
        "live_before": live_before,
        "live_after": world_digest(),
        "wire_boundary_digests": [first_wire_digest, last_wire_digest],
    }
    return result
}

fn main() -> nil {
    let expected = a_count() * weight_count()
    set(direct_sum_judge, DirectSumExpectation { proposal_count: expected })
    set(reversed_direct_sum_judge, DirectSumExpectation { proposal_count: expected })

    let explored = explore_direct_sums()
    emit DirectSumBatchReady {
        target: direct_sum_judge,
        candidates: explored["candidates"],
        reverse_order: false,
    }
    emit DirectSumBatchReady {
        target: reversed_direct_sum_judge,
        candidates: explored["candidates"],
        reverse_order: true,
    }
    flush_events()

    let selected = require(direct_sum_judge, DirectSumSelection)
    let reversed = require(reversed_direct_sum_judge, DirectSumSelection)
    assert(selected == reversed, "direct-sum selection depends on proposal order")
    assert(explored["live_before"] == explored["live_after"], "direct-sum speculation leaked")

    let receipt: map<str, any> = {
        "schema": "rad.zeta-direct-sum-attack.v1",
        "rigorous": false,
        "status": "sampled direct-sum scout; directed lower minimization still required",
        "proposal_count": expected,
        "target_scaled": TARGET_SCALED,
        "scale": SCALE,
        "selection": selected,
        "crosses_target_numerically": selected.best_simple_bound_scaled >= TARGET_SCALED,
        "proposal_order_independent": selected == reversed,
        "speculation_isolated": explored["live_before"] == explored["live_after"],
        "wire_boundary_digests": explored["wire_boundary_digests"],
        "selection_why": why(direct_sum_judge, DirectSumSelection),
    }
    create_dir("projects/dogfood/zeta-simple-zeros/out")
    write_file(
        "projects/dogfood/zeta-simple-zeros/out/direct-sum-attack.json",
        json_stringify(receipt),
    )

    print("bandwidth-one direct-sum attack")
    print("forked cells:", expected)
    print("best companion a micros:", selected.best_companion_a_micros)
    print("best companion weight ppm:", selected.best_companion_weight_ppm)
    print("combined baseline:", selected.best_baseline_scaled, "/", SCALE)
    print("best q:", selected.best_q_scaled, "/", SCALE)
    print("sampled local A:", selected.best_local_a_scaled, "/", SCALE)
    print("active gap micros:", selected.best_gap_micros)
    print("sampled simple bound:", selected.best_simple_bound_scaled, "/", SCALE)
    print("cells at or above 70%:", selected.crossing_count)
    print(why(direct_sum_judge, DirectSumSelection))
}

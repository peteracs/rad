use "arctic.rad"

// Farkas rules on original words: fd->d, ead->ed, fad->fd, fbd->fgd, gbd->ggd,
// conversions ae->ea af->eb ag->fa be->fb bf->ga bg->gb, ce->cb cf->caa cg->cab.
pub struct Rule { left: list<int> = [], right: list<int> = [], dynamic: bool = false }

pub pure fn rules() -> list<Rule> {
    return [Rule { left: [3, 6], right: [6], dynamic: true }, Rule { left: [2, 0, 6], right: [2, 6], dynamic: true },
        Rule { left: [3, 0, 6], right: [3, 6], dynamic: true }, Rule { left: [3, 1, 6], right: [3, 4, 6], dynamic: true },
        Rule { left: [4, 1, 6], right: [4, 4, 6], dynamic: true },
        Rule { left: [0, 2], right: [2, 0] }, Rule { left: [0, 3], right: [2, 1] }, Rule { left: [0, 4], right: [3, 0] },
        Rule { left: [1, 2], right: [3, 1] }, Rule { left: [1, 3], right: [4, 0] }, Rule { left: [1, 4], right: [4, 1] },
        Rule { left: [5, 2], right: [5, 1] }, Rule { left: [5, 3], right: [5, 0, 0] }, Rule { left: [5, 4], right: [5, 0, 1] }]
}

pub struct Rewrite { word: list<int> = [], rule: int = 0 - 1, at: int = 0 }

pub pure fn matches(word: list<int>, at: int, pattern: list<int>) -> bool {
    if at + len(pattern) > len(word) { return false }
    for i in range(len(pattern)) { if word[at + i] != pattern[i] { return false } }
    return true
}

// Leftmost-innermost choice: first rule, first position.
pub pure fn step(word: list<int>) -> Rewrite {
    let rs: list<Rule> = rules()
    // Dynamic (top) rules first, so rewriting follows the Farkas map.
    for k in range(5) {
        let at: int = len(word) - len(rs[k].left)
        if at >= 0 and matches(word, at, rs[k].left) {
            let mut out: list<int> = []
            for i in range(at) { out = push(out, word[i]) }
            for s in rs[k].right { out = push(out, s) }
            return Rewrite { word: out, rule: k, at: at }
        }
    }
    for at in range(len(word)) {
        for k in range(len(rs)) {
            if matches(word, at, rs[k].left) {
                let mut out: list<int> = []
                for i in range(at) { out = push(out, word[i]) }
                for s in rs[k].right { out = push(out, s) }
                for i in range(at + len(rs[k].left), len(word)) { out = push(out, word[i]) }
                return Rewrite { word: out, rule: k, at: at }
            }
        }
    }
    return Rewrite { word: word }
}

// Ternary representation: c (value 1, or "c a" = 2) then base-3 digits e/f/g.
pub pure fn ternary_word(n: int) -> list<int> {
    let mut digits: list<int> = []
    let mut x: int = n
    while x > 2 { digits = push(digits, x % 3) x = int_div(x, 3) }
    let mut word: list<int> = if x == 1 { [5] } else { [5, 0] }
    for i in range(len(digits)) { word = push(word, 2 + digits[len(digits) - 1 - i]) }
    return push(word, 6)
}

pub pure fn decode(word: list<int>) -> int {
    let mut x: int = 1
    for s in word {
        if s == 0 { x = 2 * x } else if s == 1 { x = 2 * x + 1 }
        else if s == 2 { x = 3 * x } else if s == 3 { x = 3 * x + 1 } else if s == 4 { x = 3 * x + 2 }
    }
    return x
}

struct Audit { starts: int = 0, rewrites: int = 0, dynamic: int = 0, min_drop: int = 1000, max_rank: int = 0, violations: int = 0 }

pure fn audit(limit: int) -> Audit {
    let rs: list<Rule> = rules()
    let mut rewrites: int = 0
    let mut dynamic: int = 0
    let mut min_drop: int = 1000
    let mut max_rank: int = 0
    let mut violations: int = 0
    for n in range(2, limit) {
        let mut word: list<int> = ternary_word(n)
        assert(decode(word) == n, "bad ternary word")
        let mut r: int = rank(word)
        let mut going: bool = true
        while going {
            let moved: Rewrite = step(word)
            if moved.rule < 0 { going = false } else {
                let r2: int = rank(moved.word)
                if r2 > r or (rs[moved.rule].dynamic and r2 >= r) { violations = violations + 1 }
                if rs[moved.rule].dynamic { dynamic = dynamic + 1 if r - r2 < min_drop { min_drop = r - r2 } }
                if r > max_rank { max_rank = r }
                word = moved.word
                r = r2
                rewrites = rewrites + 1
            }
        }
    }
    return Audit { starts: limit - 2, rewrites: rewrites, dynamic: dynamic, min_drop: min_drop, max_rank: max_rank, violations: violations }
}

fn main() -> nil { print(json_stringify(audit(int(sys_args()[0])))) }

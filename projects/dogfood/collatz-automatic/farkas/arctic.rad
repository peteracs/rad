// The 5-dimensional arctic certificate for Farkas' variant published by
// Yolcu, Aaronson and Heule (proofs/farkas.log), on the reversed system.
// Symbols: a=0 b=1 e=2 f=3 g=4 c=5 d=6. NEG stands for minus infinity.
pub pure fn neg() -> int { return 0 - 1000000 }

pub pure fn matrix(s: int) -> list<list<int>> {
    let n: int = neg()
    if s == 0 { return [[n, n, n, n, 0], [n, n, n, n, n], [1, n, 2, n, n], [n, n, n, n, n], [n, n, n, 2, n]] }
    if s == 1 { return [[2, n, n, n, n], [n, n, n, n, n], [n, n, 2, n, n], [n, n, n, n, n], [n, 4, n, n, n]] }
    if s == 2 { return [[2, n, 3, n, n], [n, n, n, n, n], [3, n, 4, n, n], [1, n, 3, n, n], [2, n, 4, n, n]] }
    if s == 3 { return [[0, n, 3, n, n], [0, n, 2, n, n], [3, n, 4, n, n], [n, n, n, n, 0], [n, n, n, n, 1]] }
    if s == 4 { return [[1, n, n, n, n], [0, n, n, n, n], [3, n, 4, n, n], [n, n, n, n, n], [2, n, n, n, n]] }
    if s == 5 { return [[n, n, n, n, n], [n, n, n, n, n], [n, n, n, n, n], [n, n, n, n, n], [n, n, n, n, n]] }
    return [[n, n, n, n, 0], [n, n, n, n, n], [n, n, n, n, n], [n, n, n, n, n], [n, n, n, n, n]]
}

pub pure fn offset(s: int) -> list<int> {
    let n: int = neg()
    if s == 0 { return [0, n, n, n, n] }
    if s == 1 { return [0, n, n, n, 1] }
    if s == 2 { return [n, n, n, 0, n] }
    if s == 3 { return [n, n, n, 0, 1] }
    if s == 4 { return [n, n, n, n, n] }
    if s == 5 { return [1, n, n, n, n] }
    return [0, n, n, n, n]
}

// Provenance of one coordinate: where its maximum came from.
pub struct Source { from_state: int = 0 - 1, weight: int = 0, restart: bool = false }

pub struct Evaluation { value: list<int> = [], trail: list<list<Source>> = [] }

// [w](x) for the reversed word w = rev(original): apply [c] first, then the
// original word's interior left to right, then [d]; x = all minus infinity.
pub pure fn evaluate(original: list<int>) -> Evaluation {
    let n: int = neg()
    let mut y: list<int> = [n, n, n, n, n]
    let mut trail: list<list<Source>> = []
    for idx in range(len(original)) {
        let s: int = original[idx]
        let m: list<list<int>> = matrix(s)
        let v: list<int> = offset(s)
        let mut later: list<int> = []
        let mut sources: list<Source> = []
        for i in range(5) {
            let mut best: int = v[i]
            let mut src: Source = Source { restart: true, weight: v[i] }
            for j in range(5) {
                if m[i][j] > n and y[j] > n and m[i][j] + y[j] > best {
                    best = m[i][j] + y[j]
                    src = Source { from_state: j, weight: m[i][j], restart: false }
                }
            }
            later = push(later, if best > n { best } else { n })
            sources = push(sources, src)
        }
        y = later
        trail = push(trail, sources)
    }
    return Evaluation { value: y, trail: trail }
}

pub pure fn rank(original: list<int>) -> int { return evaluate(original).value[0] }

// Yolcu–Aaronson–Heule mixed-base system. Symbols:
// a=0 b=1 (binary 2x, 2x+1), e=2 f=3 g=4 (ternary 3x, 3x+1, 3x+2), c=5, d=6.
pub pure fn binary_word(n: int) -> list<int> {
    assert(n >= 1, "positive integers only")
    let mut bits: list<int> = []
    let mut x: int = n
    while x > 1 {
        bits = push(bits, x % 2)
        x = int_div(x, 2)
    }
    let mut word: list<int> = [5]
    for i in range(len(bits)) { word = push(word, bits[len(bits) - 1 - i]) }
    return push(word, 6)
}

pub pure fn decode(word: list<int>) -> int {
    let mut x: int = 1
    for s in word {
        if s == 0 { x = 2 * x } else if s == 1 { x = 2 * x + 1 }
        else if s == 2 { x = 3 * x } else if s == 3 { x = 3 * x + 1 } else if s == 4 { x = 3 * x + 2 }
    }
    return x
}

pub struct OddStep { word: list<int> = [], boundary_firings: int = 0, conversions: int = 0, ternary_seen: int = 0 }

// Rule 1 (bd -> gd), then the forced conversion walk of the single ternary symbol.
pub pure fn odd_step(word: list<int>) -> OddStep {
    let n: int = len(word)
    assert(word[n - 1] == 6 and word[n - 2] == 1, "odd step needs ...bd")
    let mut w: list<int> = set_at(word, n - 2, 4)
    let mut p: int = n - 2
    let mut conversions: int = 0
    let mut firings: int = 0
    let mut max_ternary: int = 0
    let mut walking: bool = true
    while walking {
        let mut ternary: int = 0
        for s in w { if s >= 2 and s <= 4 { ternary = ternary + 1 } }
        if ternary > max_ternary { max_ternary = ternary }
        let left: int = w[p - 1]
        let t: int = w[p]
        if left == 5 {
            // ce -> cb, cf -> caa, cg -> cab: the strict boundary rules.
            let mut tail: list<int> = []
            for i in range(p + 1, len(w)) { tail = push(tail, w[i]) }
            let mut head: list<int> = [5]
            if t == 2 { head = push(head, 1) } else if t == 3 { head = push(push(head, 0), 0) } else { head = push(push(head, 0), 1) }
            for s in tail { head = push(head, s) }
            w = head
            firings = firings + 1
            walking = false
        } else {
            // Conversion rules ae->ea, af->eb, ag->fa, be->fb, bf->ga, bg->gb.
            let mut nt: int = 0
            let mut nb: int = 0
            if left == 0 and t == 2 { nt = 2 nb = 0 } else if left == 0 and t == 3 { nt = 2 nb = 1 }
            else if left == 0 and t == 4 { nt = 3 nb = 0 } else if left == 1 and t == 2 { nt = 3 nb = 1 }
            else if left == 1 and t == 3 { nt = 4 nb = 0 } else { nt = 4 nb = 1 }
            w = set_at(set_at(w, p - 1, nt), p, nb)
            p = p - 1
            conversions = conversions + 1
        }
    }
    return OddStep { word: w, boundary_firings: firings, conversions: conversions, ternary_seen: max_ternary }
}

pub pure fn even_step(word: list<int>) -> list<int> {
    let n: int = len(word)
    assert(word[n - 1] == 6 and word[n - 2] == 0, "even step needs ...ad")
    let mut out: list<int> = []
    for i in range(n - 2) { out = push(out, word[i]) }
    return push(out, 6)
}

pub pure fn collatz_next(n: int) -> int {
    return if n % 2 == 0 { int_div(n, 2) } else { int_div(3 * n + 1, 2) }
}

// PROBE: ghost effects and the rest of the builtin mask.
//
// Each block is one escape class. A denial is a PASS. Anything that returns
// Ok is a hole.

component Reactor { temp: 0 }

let site = spawn("site", Reactor { temp: 20 })
let caps = f"""{ "write": ["Reactor"], "fuel": 200000, "mem_bytes": 4194304 }"""

print("=== probe: ghost effects + mask coverage ===")

// G1: debug_trace -- a "ghost" diagnostic effect. Is it masked, and does its
// output reach the host?
let g1 = f"""
debug_trace("ghost: this came from inside the guest")
"""
match sandbox_run(g1, fork(), caps) {
    Ok(_f) => { print("G1 debug_trace: ALLOWED inside guest") }
    Err(m) => { print(f"G1 debug_trace denied: {m}") }
}

// G2: commit reached WITHOUT calling fork() first -- the guest is handed no
// fork value, so this checks whether commit itself is masked, rather than
// bouncing off the fork() denial the way a naive attempt does.
let g2 = f"""
commit(sandbox_input())
"""
match sandbox_run(g2, fork(), caps, 1) {
    Ok(_f) => { print("G2 commit: ALLOWED -- guest committed to the live world") }
    Err(m) => { print(f"G2 commit denied: {m}") }
}

// G3: nested sandbox_run -- does the mask stop a guest hosting its own guest?
let g3 = f"""
let inner = "print(\"inner\")"
sandbox_run(inner, sandbox_input(), "{}")
"""
match sandbox_run(g3, fork(), caps, 1) {
    Ok(_f) => { print("G3 nested sandbox_run: ALLOWED") }
    Err(m) => { print(f"G3 nested sandbox_run denied: {m}") }
}

// G4: clock / nondeterminism.
let g4 = f"""
let t = clock()
print("clock: " + str(t))
"""
match sandbox_run(g4, fork(), caps) {
    Ok(_f) => { print("G4 clock: ALLOWED") }
    Err(m) => { print(f"G4 clock denied: {m}") }
}

// G5: writing a file.
let g5 = f"""
write_file("D:\\Temp\\bastion_escape.txt", "escaped")
"""
match sandbox_run(g5, fork(), caps) {
    Ok(_f) => { print("G5 write_file: ALLOWED -- guest touched the filesystem") }
    Err(m) => { print(f"G5 write_file denied: {m}") }
}

// G6: save_world -- persistence is another way to reach the disk.
let g6 = f"""
save_world("D:\\Temp\\bastion_escape.world")
"""
match sandbox_run(g6, fork(), caps) {
    Ok(_f) => { print("G6 save_world: ALLOWED -- guest wrote a world to disk") }
    Err(m) => { print(f"G6 save_world denied: {m}") }
}

// G7: despawn without the "*" wildcard the docs say it requires.
let g7 = f"""
despawn(get_entity("site"))
"""
match sandbox_run(g7, fork(), caps) {
    Ok(_f) => { print("G7 despawn: ALLOWED without wildcard") }
    Err(m) => { print(f"G7 despawn denied: {m}") }
}

print("=== probe done ===")

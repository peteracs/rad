// caps case 3: unknown key in the grant.
component Reactor { temp: 0 }
let _s = spawn("site", Reactor { temp: 1 })
print("before")
match sandbox_run("print(\"hi\")", fork(), f"""{ "write": [], "allow_everything": true }""") {
    Ok(_f) => { print("Ok") }
    Err(m) => { print(f"Err: {m}") }
}
print("after")

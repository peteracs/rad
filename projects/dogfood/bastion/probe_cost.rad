// PROBE: what does one sandbox_run cost? A plugin host runs many per tick.

component Tick { n: 0 }

let e = spawn("e", Tick { n: 0 })

let caps = f"""{ "write": ["Tick"], "fuel": 100000 }"""
let tiny = f"""let x = 1 + 1"""

let t0 = clock()
let mut i = 0
while i < 10 {
    match sandbox_run(tiny, fork(), caps) {
        Ok(_f) => { i = i + 1 }
        Err(m) => { print(m) i = i + 1 }
    }
}
let t1 = clock()
print(f"10 trivial sandbox_run calls: {t1 - t0} s")

// RADSHEET engine smoke: formulas, cascade, cycles, errors, why().
use "lib_sheet.rad"

fn main() -> nil {
    init_grid()

    // numbers + a SUM + chained formula
    let _ = set_cell("A1", "10", "alice", 100)
    let _ = set_cell("A2", "20", "alice", 101)
    let _ = set_cell("A3", "12", "bob", 102)
    let _ = set_cell("B1", "=SUM(A1:A3)", "alice", 103)
    let _ = set_cell("B2", "=B1*2", "bob", 104)
    let _ = set_cell("B3", "=AVG(A1:A3)", "bob", 105)
    print(fmt_cell("B1"))   // 42
    print(fmt_cell("B2"))   // 84
    print(fmt_cell("B3"))   // 14

    // dependency cascade: change an input, formulas reflow
    let _ = set_cell("A1", "40", "carol", 106)
    print(fmt_cell("B1"))   // 72
    print(fmt_cell("B2"))   // 144

    // left-to-right arithmetic, mixed refs and literals
    let _ = set_cell("C1", "=A1+A2*2", "alice", 107)   // (40+20)*2 = 120
    print(fmt_cell("C1"))

    // errors are values, not crashes
    let _ = set_cell("C2", "=SUM(A1:Z9)", "alice", 108)
    print(fmt_cell("C2"))   // #ERR
    let _ = set_cell("C3", "=A1/0", "alice", 109)
    print(fmt_cell("C3"))   // #ERR

    // a cycle stabilizes at the depth cap instead of hanging
    let _ = set_cell("D1", "=D2+1", "alice", 110)
    let _ = set_cell("D2", "=D1+1", "alice", 111)
    print("cycle survived")

    // text labels
    let _ = set_cell("E1", "total:", "alice", 112)
    print(fmt_cell("E1"))

    print(render_grid())

    // the PASS criterion: why() on the formula cell names the human who
    // changed the INPUT (carol set A1=40; the Dirty cascade rewrote B1)
    let b1 = get_entity("B1")
    print(why(b1, Cell))
}

// Carry provenance of x -> 3x + 1 on exact big integers (base 2^24 limbs).
// For 3x = x + 2x the carry into bit p is decided at the nearest k < p with
// x_k == x_(k-1); the causal depth of bit p is the alternating run below it.
use "../collatz-steer/bigwalk.rad"

pub pure fn bits_of(a: list<int>) -> list<int> {
    let mut out: list<int> = []
    for limb in a {
        let mut v: int = limb
        for _ in range(24) { out = push(out, v % 2) v = int_div(v, 2) }
    }
    let mut n: int = len(out)
    while n > 1 and out[n - 1] == 0 { n = n - 1 }
    return slice(out, 0, n)
}

pub struct CarryStats {
    bits: int = 0
    longest_chain: int = 0      // longest alternating run anywhere (max causal depth)
    chain_at: int = 0           // position where it ends
    bottom_agreement: int = 0   // low bits agreeing with -1/3 = ...010101 (= nu2(3x+1) for odd x)
    chains_ge4: int = 0         // number of maximal alternating runs of length >= 4
    runs: int = 0               // number of maximal alternating runs
}

pub pure fn carry_stats(b: list<int>) -> CarryStats {
    let mut longest: int = 1
    let mut at: int = 0
    let mut current: int = 1
    let mut long_runs: int = 0
    let mut runs: int = 1
    for i in range(1, len(b)) {
        if b[i] != b[i - 1] { current = current + 1 } else {
            if current >= 4 { long_runs = long_runs + 1 }
            runs = runs + 1
            current = 1
        }
        if current > longest { longest = current at = i }
    }
    if current >= 4 { long_runs = long_runs + 1 }
    // -1/3 in Z_2 is ...0101 01 with bit 0 = 1, bit 1 = 0, alternating.
    let mut agree: int = 0
    let mut going: bool = true
    while going and agree < len(b) {
        if b[agree] == (if agree % 2 == 0 { 1 } else { 0 }) { agree = agree + 1 } else { going = false }
    }
    return CarryStats { bits: len(b), longest_chain: longest, chain_at: at, bottom_agreement: agree, chains_ge4: long_runs, runs: runs }
}

use "schema.rad"
use "owners/match_owner.rad"
use "systems/phase_engine.rad"
use "scenarios/production.rad"

fn main() -> nil {
    let receipt = summarize_match_batch(50000, 10000)
    set_resource(MatchFlowBatchReceipt, receipt)
    assert(res(MatchFlowBatchReceipt).alive == 40000, "alive population exact")
    assert(res(MatchFlowBatchReceipt).deaths == 10000, "death publication exact")
    print(f"matchflow-bench: players=50000 inputs=10000 alive={res(MatchFlowBatchReceipt).alive} deaths={res(MatchFlowBatchReceipt).deaths}")
}

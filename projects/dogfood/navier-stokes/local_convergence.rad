// Exact arithmetic certificate for LOCAL_CONVERGENCE.md.
// This checks the constants in an analytic argument; it does not evaluate a PDE.
pure fn norm_bound() -> int {
    // Bounds on rho, its inverse denominator, and the smooth step derivatives.
    let inverse1: int = 4*64
    let inverse2: int = 2*16*512+72*64
    let inverse3: int = 6*64*4096+6*4*72*512+3168*64
    let step1: int = 2*8+inverse1
    let step2: int = 36*8+4*inverse1+inverse2
    let step3: int = 1584*8+108*inverse1+6*inverse2+inverse3
    let b1: int = step1*8
    let b2: int = step2*64
    let b3: int = step3*512
    let k1: int = 1+2*b1
    let k2: int = 4*b1+2*b2+2*b1*b1
    let k3: int = 6*b2+2*b3+6*b1*b1+6*b1*b2
    let l: int = 1+26*k1+40*k2+8*k3
    assert(k1 == 4353 and k2 == 12333568 and k3 == 21568303104, "cutoff derivative arithmetic")
    assert(7*l == 1211279165117, "Sobolev bound arithmetic")
    return 7*l
}
pure fn power2(exponent: int) -> int {
    assert(exponent >= 0 and exponent <= 44, "norm exponent domain")
    let mut n: int = 1
    for _ in range(exponent) { n = 2*n }
    return n
}
resource ConvergenceSpec { norm_exponent: int = 41, iteration: int = 0, corrupt: bool = false }
component ConvergenceResult {
    norm_exponent: int = 0, iteration: int = 0,
    time_den_exponent: int = 0, error_exponent: int = 0
}
entity candidate { ConvergenceResult {} }
pure fn certificate(m: int, n: int, corrupt: bool) -> ConvergenceResult {
    assert(m >= 40 and m <= 43 and n >= 0 and n <= 64, "convergence portfolio domain")
    assert(power2(m) >= norm_bound(), "initial norm bound not covered")
    let time_exponent: int = if corrupt { 2*m+4 } else { 2*m+8 }
    // q <= 8*M*sqrt(T/nu). q<=1/2 follows from time_exponent>=2m+8.
    assert(time_exponent >= 2*m+8, "contraction bound not established")
    return ConvergenceResult { norm_exponent: m, iteration: n,
        time_den_exponent: time_exponent, error_exponent: m-2-n }
}
system CheckConvergence(result: mut ConvergenceResult, spec: ConvergenceSpec) {
    result = certificate(spec.norm_exponent, spec.iteration, spec.corrupt)
}
component ConvergenceAudit { certificates: int = 0 }
entity audit { ConvergenceAudit {} }
intent ConvergenceChecked { key target: entity, evidence: ConvergenceResult }
law SubmitConvergence(target: entity, evidence: ConvergenceResult) { propose ConvergenceChecked { target: target, evidence: evidence } }
resolver AssembleConvergence for ConvergenceChecked(target, proposals) {
    assert(len(proposals) == 12, "incomplete convergence portfolio")
    let mut seen: list<bool> = []
    for _ in range(12) { seen = push(seen, false) }
    for proposal in proposals {
        let row: ConvergenceResult = proposal.evidence
        assert(row == certificate(row.norm_exponent, row.iteration, false), "convergence certificate mismatch")
        assert(row.norm_exponent >= 41, "invalid norm portfolio")
        let index: int = if row.iteration == 0 { 0 } else if row.iteration == 8 { 1 }
            else if row.iteration == 32 { 2 } else if row.iteration == 64 { 3 } else { -1 }
        assert(index >= 0, "unexpected iteration")
        let slot: int = 4*(row.norm_exponent-41)+index
        assert(not seen[slot], "duplicate convergence certificate")
        seen[slot] = true
    }
    next(target, ConvergenceAudit { certificates: 12 })
}
fn main() -> nil {
    let args: list<str> = sys_args()
    if len(args) > 0 {
        if args[0] == "undersized-norm" {
            let rejected: ConvergenceResult = certificate(40, 0, false)
            assert(rejected.norm_exponent == 0, "undersized bound accepted")
        } else if args[0] == "oversized-time" {
            let rejected: ConvergenceResult = certificate(41, 0, true)
            assert(rejected.time_den_exponent == 0, "unproved timestep accepted")
        } else { assert(false, "unknown convergence probe") }
    }
    let live: str = world_digest()
    let base: world_fork = fork()
    let mut jobs: list<world_fork> = []
    for m in [41, 42, 43] {
        for n in [0, 8, 32, 64] { jobs = push(jobs, fork_with(base, ConvergenceSpec { norm_exponent: m, iteration: n })) }
    }
    let results: list<world_fork> = simulate_many(jobs, [system::CheckConvergence], 1, 20260908)
    let mut rows: list<ConvergenceResult> = []
    for i in range(12) {
        assert_only_changed(jobs[i], results[i], [ConvergenceResult])
        let restored: world_fork = fork_from_bytes(fork_to_bytes(results[i])) |> unwrap
        assert(world_digest(restored) == world_digest(results[i]), "convergence wire roundtrip")
        let row: ConvergenceResult = peek(results[i], candidate, ConvergenceResult) |> unwrap
        rows = push(rows, row)
        print(json_stringify(row))
    }
    assert(world_digest() == live, "convergence fork isolation")
    settle { for row in rows { SubmitConvergence(audit, row) } }
    print(why(audit, ConvergenceAudit))
    print("scope: arithmetic for a short-time Picard proof; no PDE iterates evaluated and no blowup certified")
}

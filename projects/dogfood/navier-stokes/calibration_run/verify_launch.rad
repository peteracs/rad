use "../calibration_round.rad"
fn main() -> nil {
    let requests: list<CalibrationRequest> = [
        CalibrationRequest { round:194,lane:0,p:6,q:-1,radius_eighths:9,method:1 },
        CalibrationRequest { round:194,lane:1,p:6,q:-1,radius_eighths:16,method:0 },
        CalibrationRequest { round:194,lane:2,p:4,q:4,radius_eighths:16,method:1 },
        CalibrationRequest { round:194,lane:3,p:8,q:0,radius_eighths:9,method:1 }
    ]
    run_calibration_round(requests,false)
}

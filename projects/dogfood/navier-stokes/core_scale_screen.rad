// Necessary scaling screen for CROSS_PAPER_ATTACK.md, never a PDE proof.
// All exponents use denominator 16; arithmetic domains are bounded below.
resource CoreSpec { radius: int = 16, strain: int = 1 }
component CoreResult {
    radius: int = 0, strain: int = 0
    exposure: int = 0, energy: int = 0, loss: int = 0
    feasible_scaling: bool = false
    fixed_profile_excluded: bool = false
}
entity core { CoreResult {} }

pure fn screen(r: int, s: int) -> CoreResult {
    assert(r > 0 and r <= 64 and s > 0 and s <= 176, "outside exact screen domain")
    let exposure: int = 2*r-s
    let energy: int = 2*s-5*r
    let loss: int = s-3*r
    return CoreResult { radius: r, strain: s, exposure: exposure,
        energy: energy, loss: loss,
        feasible_scaling: exposure < 0 and energy < 0 and loss < 0 and s > r,
        fixed_profile_excluded: 2*r < s and 2*s < 5*r }
}
system EvaluateCore(result: mut CoreResult, spec: CoreSpec) {
    result = screen(spec.radius, spec.strain)
}

component CorePortfolio {
    cases: int = 0, scale_feasible: int = 0, fixed_profile_excluded: int = 0
}
entity forward { CorePortfolio {} }
entity reversed { CorePortfolio {} }
intent CoreChecked { key target: entity, evidence: CoreResult }
law SubmitCore(target: entity, evidence: CoreResult) {
    propose CoreChecked { target: target, evidence: evidence }
}
resolver AssembleCores for CoreChecked(target, proposals) {
    assert(len(proposals) == 704, "incomplete proposal portfolio")
    let mut seen: list<bool> = []
    for _ in range(704) { seen = push(seen, false) }
    let mut feasible: int = 0
    let mut excluded: int = 0
    for proposal in proposals {
        let row: CoreResult = proposal.evidence
        assert(row.radius % 16 == 0, "unexpected radius grid")
        assert(row == screen(row.radius, row.strain), "forged candidate evidence")
        let slot: int = (int_div(row.radius, 16)-1)*176 + row.strain-1
        assert(not seen[slot], "duplicate candidate evidence")
        seen[slot] = true
        if row.feasible_scaling { feasible = feasible+1 }
        if row.fixed_profile_excluded { excluded = excluded+1 }
    }
    next(target, CorePortfolio { cases: len(proposals), scale_feasible: feasible,
        fixed_profile_excluded: excluded })
}
constraint CompleteCorePortfolio for CorePortfolio(subject, proposed) {
    require proposed.cases == 704 else "ns.incomplete_scale_portfolio"
    require proposed.scale_feasible == 76 else "ns.scale_count_mismatch"
    require proposed.fixed_profile_excluded == proposed.scale_feasible
        else "ns.fixed_profile_energy_obstruction_missing"
}
fn main() -> nil {
    assert(2*47-1 == 93, "Boussinesq exposure exponent mismatch")
    assert(not screen(47, 1).feasible_scaling, "published schedule passed shielding")
    assert(screen(32, 72).feasible_scaling, "strict 3D scale window lost")
    assert(not screen(32, 64).feasible_scaling, "critical diffusion admitted as vanishing")
    assert(not screen(32, 80).feasible_scaling, "constant energy admitted as vanishing")
    let live: str = world_digest()
    let base: world_fork = fork()
    let mut jobs: list<world_fork> = []
    for r in [16, 32, 48, 64] {
        for s in range(1, 177) { jobs = push(jobs, fork_with(base, CoreSpec { radius: r, strain: s })) }
    }
    let results: list<world_fork> = simulate_many(jobs, [system::EvaluateCore], 1, 20260908)
    assert(len(results) == 704, "incomplete scale portfolio")
    let mut feasible: int = 0
    let mut evidence: list<CoreResult> = []
    for i in range(len(results)) {
        assert_only_changed(jobs[i], results[i], [CoreResult])
        let result: CoreResult = peek(results[i], core, CoreResult) |> unwrap
        let spec: CoreSpec = peek_resource(jobs[i], CoreSpec) |> unwrap
        assert(result == screen(spec.radius, spec.strain), "parallel evidence disagrees")
        let restored: world_fork = fork_from_bytes(fork_to_bytes(results[i])) |> unwrap
        assert(world_digest(restored) == world_digest(results[i]), "serialized result changed")
        evidence = push(evidence, result)
        if result.feasible_scaling { feasible = feasible + 1 }
        print(json_stringify(result))
    }
    assert(world_digest() == live, "scale search changed authoritative world")
    // Negative acceptance probes: these corrupt only the pending evidence.
    let args: list<str> = sys_args()
    if len(args) > 0 {
        if args[0] == "duplicate" {
            evidence[0] = evidence[1]
        } else if args[0] == "forged" {
            evidence[0] = CoreResult { radius: 16, strain: 1 }
        } else if args[0] == "missing" {
            let mut incomplete: list<CoreResult> = []
            for i in range(703) { incomplete = push(incomplete, evidence[i]) }
            evidence = incomplete
        } else { assert(false, "unknown negative probe") }
    }
    settle { for result in evidence { SubmitCore(forward, result) } }
    settle { for i in range(len(evidence)) { SubmitCore(reversed, evidence[len(evidence)-1-i]) } }
    assert(require(forward, CorePortfolio) == require(reversed, CorePortfolio), "proposal order changed audit")
    print("portfolio", json_stringify(require(forward, CorePortfolio)))
    print(why(forward, CorePortfolio))
    print("scaling candidates", feasible, "of", len(results))
    print("scope: exponent screen only; profile, pressure, matching and smooth force unproved")
}

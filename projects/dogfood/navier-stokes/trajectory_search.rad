use "trajectory_fixture.rad"
resource TrajectorySpec { lane: int = 0 }
component TrajectoryEvidence { lane: int = 0, seam_closed: bool = false,
    left_force_bound: int = 0, right_force_bound: int = 0,
    initial_e8: int = 0, final_e8: int = 0,
    finite_force_smooth: bool = false, infinite_budget_proved: bool = false }
entity trajectory { TrajectoryEvidence {} }
pure fn evaluate_path(spec: TrajectorySpec) -> TrajectoryEvidence {
    assert(spec.lane == 0 or spec.lane == 1,"trajectory proposal domain")
    let left: SmoothStage = fixture_stage()
    let mut right: SmoothStage = carry_stage(left,left.b,1)
    if spec.lane == 0 { right.a = [right.a[0],fixture_bank(0),fixture_bank(0)] }
    let joined: bool = stage_join(left,right)
    let lb: StageBound = stage_bound(left)
    let rb: StageBound = stage_bound(right)
    return TrajectoryEvidence { lane: spec.lane,seam_closed: joined,
        left_force_bound: lb.force_sup_upper,right_force_bound: rb.force_sup_upper,
        initial_e8: lb.start_enstrophy8,final_e8: rb.end_enstrophy8,
        finite_force_smooth: joined,infinite_budget_proved: false }
}
system EvaluateTrajectory(row: mut TrajectoryEvidence, spec: TrajectorySpec) { row = evaluate_path(spec) }
component TrajectoryDecision { lane: int = -1, finite_trajectory_checked: bool = false,
    force_smooth_on_finite_interval: bool = false, infinite_stage_closure_proved: bool = false }
entity trajectory_decision { TrajectoryDecision {} }
intent TrajectoryChecked { key target: entity, spec: TrajectorySpec, evidence: TrajectoryEvidence }
law SubmitTrajectory(target: entity, spec: TrajectorySpec, evidence: TrajectoryEvidence) {
    propose TrajectoryChecked { target: target,spec: spec,evidence: evidence }
}
resolver ChooseTrajectory for TrajectoryChecked(target, proposals) {
    assert(len(proposals) == 2,"trajectory portfolio coverage")
    let mut seen: list<bool> = [false,false]
    let mut selected: int = -1
    for proposal in proposals {
        assert(proposal.spec.lane >= 0 and proposal.spec.lane < 2,"trajectory lane")
        assert(not seen[proposal.spec.lane],"duplicate trajectory")
        seen[proposal.spec.lane] = true
        assert(proposal.evidence == evaluate_path(proposal.spec),"forged trajectory certificate")
        if proposal.evidence.seam_closed and proposal.evidence.final_e8 > proposal.evidence.initial_e8 {
            selected = proposal.spec.lane
        }
    }
    assert(selected == 1,"trajectory closure selection")
    next(target,TrajectoryDecision { lane: selected,finite_trajectory_checked: true,
        force_smooth_on_finite_interval: true,infinite_stage_closure_proved: false })
}
fn main() -> nil {
    let base: world_fork = fork()
    let digest: str = world_digest()
    let jobs: list<world_fork> = [fork_with(base,TrajectorySpec { lane: 0 }),fork_with(base,TrajectorySpec { lane: 1 })]
    let results: list<world_fork> = simulate_many(jobs,[system::EvaluateTrajectory],1,20260908)
    let mut evidence: list<TrajectoryEvidence> = []
    for i in range(2) {
        assert_only_changed(jobs[i],results[i],[TrajectoryEvidence])
        let row: TrajectoryEvidence = peek(results[i],trajectory,TrajectoryEvidence) |> unwrap
        evidence = push(evidence,row)
        print("evidence",json_stringify(row))
    }
    assert(world_digest() == digest,"trajectory fork isolation")
    let args: list<str> = sys_args()
    if len(args) > 0 {
        assert(args[0] == "forge-infinite","unknown trajectory probe")
        let mut forged: TrajectoryEvidence = evidence[1]
        forged.infinite_budget_proved = true
        evidence[1] = forged
    }
    settle { for i in range(2) { SubmitTrajectory(trajectory_decision,TrajectorySpec { lane: i },evidence[i]) } }
    print("decision",json_stringify(require(trajectory_decision,TrajectoryDecision)))
    print(why(trajectory_decision,TrajectoryDecision))
}

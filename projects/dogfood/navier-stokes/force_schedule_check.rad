use "smooth_force_schedule.rad"
fn main() -> nil {
    for q in [1,2,3,8,64,1000000] {
        print("atom",json_stringify(force_atom(q,[1,1,1])))
        assert(5-q*q+2*q == 6-(q-1)*(q-1),"actual H2 force bound exponent")
    }
    let mut count: int = 0
    for a in range(13) {
        for m in range(13) {
            for q in [1,a+m+1,a+m+2,1000000] {
                let exponent: int = verify_force_tail(a,m,q)
                assert(exponent <= 5+int_div((a+m)*(a+m),4),"force derivative budget")
                count = count+1
            }
        }
    }
    assert(count == 676,"force budget coverage")
    // Arithmetic for the written full-PDE Picard certificate at nu=1:
    // ||u0||H2^2=384<20^2, ||f||H2<=64, T=2^-28,
    // linear norm <=21, radius=42, bilinear norm <=1/256.
    assert(384 < 20*20 and 64 <= 268435456,"linear solution bound")
    assert(64*256 == 16384,"heat bilinear constant")
    assert(21*256+42*42 <= 42*256,"Picard ball invariance")
    assert(2*42*2 <= 256,"Picard contraction at most one half")
    let summary: map<str, any> = { "actual_force_budget_checks": count,
        "local_time_denominator": 268435456,"H2_ball_radius": 42,
        "analytic_fixed_bump_lemma_required": true,"analytic_Sobolev_and_heat_bounds_required": true,
        "blowup_proved": false }
    print("summary",json_stringify(summary))
    let controls: list<int> = [1,1,1]
    for mode in dictated_velocity_rate(cyclic_bank([8,8,8]),first_pulse_peak(controls),1,1) {
        print("rhs",json_stringify(mode))
    }
}

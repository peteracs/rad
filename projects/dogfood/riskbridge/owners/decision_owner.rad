use "../schema.rad"

pub component CustomerRiskState owned {
    indexed customer: CustomerId = CustomerId(u64(0)),
    decisions: int = 0,
}

pub component TransactionAttempt owned {
    indexed transaction: TransactionId = TransactionId(u64(0)),
    ordered indexed submission_order: u64 = u64(0),
    customer: CustomerId = CustomerId(u64(0)),
    amount: MoneyCents = MoneyCents(i64(0)),
}

pub component RiskSignal owned { bits: RiskSignals = RiskSignals(u64(0)) }
pub component ModelRequest owned { model: ModelId = ModelId(u32(0)) }
pub component PluginGeneration owned { generation: u32 = u32(0) }
pub component ModelScore owned { score: f32 = f32(0.0), reason_mask: u64 = u64(0) }

pub component PolicyDecision owned {
    disposition: u8 = u8(0),
    model_version: u32 = u32(0),
    source: u8 = u8(0),
}

pub component ManualReviewCase owned {
    ordered indexed urgency: (u64, u64) = (u64(0), u64(0)),
}

pub component DecisionLedger owned {
    transaction: TransactionId = TransactionId(u64(0)),
    model_version: u32 = u32(0),
    committed: bool = false,
}

pub component IdempotencyRecord owned { transaction: TransactionId = TransactionId(u64(0)) }
pub component HostCallRecord owned {
    model: ModelId = ModelId(u32(0)),
    generation: u32 = u32(0),
    effect_class: u8 = u8(0),
    outcome: u8 = u8(0),
}

pub resource ActivePluginGeneration owned {
    generation: u32 = u32(17),
    plugin_digest: str = "riskbridge-model-v17",
}

// Production keeps a bounded online decision window. Completed attempts are
// folded into this deterministic receipt before their operational rows are
// retired; the count and checksum make archival part of replay identity
// instead of a benchmark-only deletion shortcut.
pub resource ArchivedDecisionReceipt owned {
    decisions: int = 0,
    transaction_xor: u64 = u64(0),
}

pub resource BatchDecisionReceipt owned {
    decisions: int = 0,
    allows: int = 0,
    reviews: int = 0,
    denies: int = 0,
    score_points: int = 0,
    reason_xor: u64 = u64(0),
    transaction_xor: u64 = u64(0),
}

pub materialized view ManualReviewQueue {
    depends [TransactionAttempt, PolicyDecision, ManualReviewCase]
    key TransactionAttempt.transaction
}

pub fn register_customer(id: CustomerId) -> entity writes owned [CustomerRiskState] {
    return spawn(CustomerRiskState { customer: id, decisions: 0 })
}

pub transaction CommitDecision(
    customer: entity,
    request: RiskInput,
    output: RiskOutput,
    started_generation: u32,
    source: u8,
    order: u64,
)
    writes owned [CustomerRiskState, TransactionAttempt, RiskSignal, ModelRequest, PluginGeneration, ModelScore, PolicyDecision, ManualReviewCase, DecisionLedger, IdempotencyRecord, HostCallRecord]
{
    requires is_none(lookup(TransactionAttempt, "transaction", request.transaction))
    requires output.model_version == started_generation
    changes_only ["$entities", "$entity_identity", CustomerRiskState, TransactionAttempt, RiskSignal, ModelRequest, PluginGeneration, ModelScore, PolicyDecision, ManualReviewCase, DecisionLedger, IdempotencyRecord, HostCallRecord]

    let state: CustomerRiskState = require(customer, CustomerRiskState)
    set(customer, CustomerRiskState { customer: state.customer, decisions: state.decisions + 1 })
    // Publish the stable decision shape in one archetype transition. The
    // transaction owns the spawn, so failed contracts still roll the entity,
    // indexes, and allocator generation back atomically.
    let attempt = spawn(
        TransactionAttempt {
            transaction: request.transaction,
            submission_order: order,
            customer: request.customer,
            amount: request.amount,
        },
        RiskSignal { bits: request.signals },
        ModelRequest { model: request.model },
        PluginGeneration { generation: started_generation },
        ModelScore { score: output.score, reason_mask: output.reason_mask },
        PolicyDecision {
            disposition: output.disposition,
            model_version: output.model_version,
            source: source,
        },
        DecisionLedger {
            transaction: request.transaction,
            model_version: output.model_version,
            committed: true,
        },
        IdempotencyRecord { transaction: request.transaction },
        HostCallRecord {
            model: request.model,
            generation: started_generation,
            effect_class: u8(0),
            outcome: u8(0),
        },
    )
    if output.disposition == u8(1) {
        set(attempt, ManualReviewCase {
            urgency: (u64(request.transaction), u64(request.transaction)),
        })
    }

    ensures is_some(lookup(TransactionAttempt, "transaction", request.transaction))
    ensures has(lookup(TransactionAttempt, "transaction", request.transaction) |> unwrap, PolicyDecision)
    ensures require(lookup(TransactionAttempt, "transaction", request.transaction) |> unwrap, DecisionLedger).committed
    ensures require(lookup(TransactionAttempt, "transaction", request.transaction) |> unwrap, PluginGeneration).generation == started_generation
    post_commit {
        emit next DecisionCommitted {
            attempt: lookup(TransactionAttempt, "transaction", request.transaction) |> unwrap,
            disposition: output.disposition,
            model_version: output.model_version,
        }
        if output.disposition == u8(1) {
            emit next ManualReviewQueued {
                attempt: lookup(TransactionAttempt, "transaction", request.transaction) |> unwrap,
            }
        }
    }
}

pub transaction ArchiveDecision(attempt: entity)
    writes owned [ArchivedDecisionReceipt, TransactionAttempt, RiskSignal, ModelRequest, PluginGeneration, ModelScore, PolicyDecision, ManualReviewCase, DecisionLedger, IdempotencyRecord, HostCallRecord]
{
    requires has(attempt, TransactionAttempt)
    requires require(attempt, DecisionLedger).committed
    changes_only [ArchivedDecisionReceipt, TransactionAttempt, RiskSignal, ModelRequest, PluginGeneration, ModelScore, PolicyDecision, ManualReviewCase, DecisionLedger, IdempotencyRecord, HostCallRecord]

    let transaction = require(attempt, DecisionLedger).transaction
    let had_review = has(attempt, ManualReviewCase)
    update(ArchivedDecisionReceipt) {
        decisions = res(ArchivedDecisionReceipt).decisions + 1,
        transaction_xor = res(ArchivedDecisionReceipt).transaction_xor ^ u64(transaction),
    }
    let removed = remove_many(attempt, [
        TransactionAttempt,
        RiskSignal,
        ModelRequest,
        PluginGeneration,
        ModelScore,
        PolicyDecision,
        ManualReviewCase,
        DecisionLedger,
        IdempotencyRecord,
        HostCallRecord,
    ])
    assert(removed == if had_review { 10 } else { 9 }, "the archived shape is complete")

    ensures not has(attempt, TransactionAttempt)
}

pub transaction CommitDecisionBatch(customer: entity, summary: RiskBatchSummary)
    writes owned [CustomerRiskState, ArchivedDecisionReceipt, BatchDecisionReceipt]
{
    requires summary.decisions > 0
    requires summary.allows + summary.reviews + summary.denies == summary.decisions
    changes_only [CustomerRiskState, ArchivedDecisionReceipt, BatchDecisionReceipt]

    let state = require(customer, CustomerRiskState)
    set(customer, CustomerRiskState {
        customer: state.customer,
        decisions: state.decisions + summary.decisions,
    })
    update(ArchivedDecisionReceipt) {
        decisions = res(ArchivedDecisionReceipt).decisions + summary.decisions,
        transaction_xor = res(ArchivedDecisionReceipt).transaction_xor ^ summary.transaction_xor,
    }
    update(BatchDecisionReceipt) {
        decisions = res(BatchDecisionReceipt).decisions + summary.decisions,
        allows = res(BatchDecisionReceipt).allows + summary.allows,
        reviews = res(BatchDecisionReceipt).reviews + summary.reviews,
        denies = res(BatchDecisionReceipt).denies + summary.denies,
        score_points = res(BatchDecisionReceipt).score_points + summary.score_points,
        reason_xor = res(BatchDecisionReceipt).reason_xor ^ summary.reason_xor,
        transaction_xor = res(BatchDecisionReceipt).transaction_xor ^ summary.transaction_xor,
    }

    ensures res(BatchDecisionReceipt).decisions >= summary.decisions
    ensures res(ArchivedDecisionReceipt).decisions >= summary.decisions
    post_commit {
        emit next DecisionBatchCommitted {
            decisions: summary.decisions,
            reviews: summary.reviews,
        }
    }
}

pub readonly fn attempt_by_transaction(id: TransactionId) -> entity {
    return lookup(TransactionAttempt, "transaction", id) |> unwrap
}

pub fn activate_generation(generation: u32, digest: str) -> nil
    writes owned [ActivePluginGeneration]
{
    update(ActivePluginGeneration) { generation = generation, plugin_digest = digest }
}

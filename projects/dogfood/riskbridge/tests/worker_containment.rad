use "../negative/fixture_adapter.rad"
use "../owners/decision_owner.rad" as decisions

test "a crashed plugin does not corrupt the world or another generation" {
    match fixture_probe_result("target/riskbridge-fixtures/crash.dll") {
        Err(message) => {
            assert(contains(message, "HostCallFailure"), "crash is a typed host failure")
        }
        Ok(_) => { assert(false, "crashing plugin unexpectedly returned") }
    }

    let output = score_native(fixture_request())
    assert(output.model_version == u32(17), "healthy generation remains callable")
}

test "a timed out plugin does not corrupt the world or another generation" {
    match fixture_probe_result("target/riskbridge-fixtures/timeout.dll") {
        Err(message) => {
            assert(contains(message, "native-call timeout"), "timeout is a typed host failure")
        }
        Ok(_) => { assert(false, "hanging plugin unexpectedly returned") }
    }

    let output = score_native(fixture_request())
    assert(output.model_version == u32(17), "healthy generation remains callable")
}

test "a host failure is data and cannot partially commit a decision" {
    let request = fixture_request()
    let customer = decisions.register_customer(request.customer)
    match fixture_score_result("target/riskbridge-fixtures/host_failure.dll") {
        Err(message) => {
            assert(contains(message, "typed fixture host failure"), "native error is retained")
        }
        Ok(_) => { assert(false, "failing plugin unexpectedly returned") }
    }
    assert(len(entities(decisions.TransactionAttempt)) == 0, "failed host call published no attempt")
    assert(len(entities(decisions.PolicyDecision)) == 0, "failed host call committed no decision")
    assert(len(entities(decisions.DecisionLedger)) == 0, "failed host call committed no ledger")

    let output = score_reference(request)
    decisions.CommitDecision(customer, request, output, u32(17), u8(1), u64(1))
    let attempt = decisions.attempt_by_transaction(request.transaction)
    assert(has(attempt, decisions.DecisionLedger), "the service processes the next decision")
}

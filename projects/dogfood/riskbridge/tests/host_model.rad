use "../schema.rad"
use "../owners/decision_owner.rad"
use "../owners/decision_owner.rad" as decisions
use "../host/risk_model.rad" as model
use "../negative/fixture_adapter.rad"

let model_customer: entity = decisions.register_customer(CustomerId(u64(8800)))
component DecisionObserved {}

fn model_request() -> RiskInput {
    return RiskInput {
        customer: CustomerId(u64(8800)),
        transaction: TransactionId(u64(9900)),
        amount: MoneyCents(i64(4200)),
        merchant_category: u16(5411),
        country: u16(156),
        signals: RiskSignals(u64(2)),
        model: ModelId(u32(17)),
    }
}

fn decode_fixture(path: str) -> RiskOutput {
    return model.decode_risk_output(fixture_score(path))
}

fn ensure_generation_safe_decision() -> nil {
    let request: RiskInput = model_request()
    if not has(model_customer, DecisionObserved) {
        let started: u32 = res(decisions.ActivePluginGeneration).generation
        let output: RiskOutput = model.score_reference(request)
        decisions.activate_generation(u32(18), "riskbridge-model-v18")
        decisions.CommitDecision(
            spawn(),
            model_customer,
            request,
            output,
            started,
            u8(1),
            u64(1),
        )
        let attempt: entity = decisions.attempt_by_transaction(request.transaction)
        assert(
            require(attempt, decisions.PluginGeneration).generation == started,
            "decision remains pinned to its starting generation",
        )
        set(model_customer, DecisionObserved {})
    }
}

fn malformed_host_response() -> nil {
    let before: int = len(entities(decisions.TransactionAttempt))
    match host_try(decode_fixture, "target/riskbridge-fixtures/malformed_output.dll") {
        Err(message) => {
            assert(contains(message, "valid JSON"), "malformed response remains typed")
        }
        Ok(_) => { assert(false, "malformed native output was accepted") }
    }
    assert(
        len(entities(decisions.TransactionAttempt)) == before,
        "malformed host output publishes no attempt",
    )
    ensure_generation_safe_decision()
}

fn generation_safe_decision() -> nil {
    ensure_generation_safe_decision()
}

model HostBoundaryModel {
    commands [malformed_host_response, generation_safe_decision]
    invariant {
        for (attempt, _identity) in query { TransactionAttempt } {
            if not has(attempt, decisions.DecisionLedger) { return false }
            if not has(attempt, decisions.PolicyDecision) { return false }
        }
        if has(model_customer, DecisionObserved) {
            if len(entities(decisions.DecisionLedger)) != 1 { return false }
        }
        return true
    }
    temporal {
        exactly_once DecisionObserved,
    }
    runs 20
    max_commands 10
    seed 8820
}

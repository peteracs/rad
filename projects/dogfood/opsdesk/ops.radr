{"seed":9710467467424360753,"source":"// -- \\\\?\\H:\\Projects\\rad-lang\\dogfood\\opsdesk\\main.rad --\n// OpsDesk — an incident console that runs all seven primitives as ONE\r\n// machine, in one program:\r\n//\r\n//   #5 migrate      yesterday's v1 save loads through a schema migration\r\n//   #1 speculate    fork() + simulate() forecast SLA breaches, untouched world\r\n//   #7 merge        two concurrent shifts reconciled field-by-field,\r\n//                   WITH an in-flight event that survives the merge\r\n//   #3 blast radius diff() + assert_only_changed() fence the merge\r\n//   #4 causality    why() explains a status through the handler chain,\r\n//                   and discloses the commit seam honestly\r\n//   #2 record       run it under `--record`, then `rad replay` the trace\r\n//\r\n//   rad dogfood/opsdesk/seed_v1.rad\r\n//   rad run dogfood/opsdesk/main.rad --record dogfood/opsdesk/ops.radr\r\n//   rad replay dogfood/opsdesk/ops.radr\r\n\r\ncomponent Incident { title: \"\", priority: 0, age: 0, status: \"open\" }\r\ncomponent Assignee { name: \"\" }\r\nresource Board { open: 0 }\r\nresource Audit { log: \"\" }\r\n\r\n// The v1 schema had `sev` and no `status` — the migration is the schema's\r\n// changelog, in the grammar.\r\nmigrate Incident(old) {\r\n    return Incident {\r\n        title: old[\"title\"],\r\n        priority: old[\"sev\"],\r\n        age: old[\"age\"],\r\n        status: \"open\",\r\n    }\r\n}\r\n\r\nevent StatusChange { inc, to }\r\non StatusChange(e) {\r\n    let i = get(e.inc, Incident) |> unwrap\r\n    set(e.inc, Incident { title: i.title, priority: i.priority, age: i.age, status: e.to })\r\n    let a = get_resource(Audit) |> unwrap\r\n    set_resource(Audit, Audit { log: a.log + f\"[{i.title} -> {e.to}] \" })\r\n    if e.to == \"resolved\" {\r\n        let b = get_resource(Board) |> unwrap\r\n        set_resource(Board, Board { open: b.open - 1 })\r\n    }\r\n}\r\n\r\nsystem Escalate(i: mut Incident) {\r\n    i = Incident { title: i.title, priority: i.priority, age: i.age + 1, status: i.status }\r\n}\r\n\r\n// ---- #5: load the v1 save through the migration --------------------------\r\nload_world(read_file(\"dogfood/opsdesk/world.json\"))\r\nlet inc1 = get_entity(\"INC-1\")\r\nlet inc2 = get_entity(\"INC-2\")\r\nlet inc3 = get_entity(\"INC-3\")\r\nlet i3 = get(inc3, Incident) |> unwrap\r\nprint(\"== opsdesk ==\")\r\nprint(f\"v1 save migrated: INC-3 '{i3.title}' priority {i3.priority} status '{i3.status}'\")\r\n\r\n// ---- #1: forecast — what breaches if nobody acts? -------------------------\r\nlet now = fork()\r\nlet later = simulate(now, [system::Escalate], 3)\r\nlet f3 = peek(later, inc3, Incident) |> unwrap\r\nlet live3 = get(inc3, Incident) |> unwrap\r\nprint(f\"forecast: in 3 ticks INC-3 ages {i3.age} -> {f3.age} (live world untouched: age {live3.age})\")\r\n\r\n// ---- #7: two shifts, one timeline -----------------------------------------\r\nlet base = fork()\r\n\r\n// Day shift: assigns INC-1, queues INC-3's resolution as an event, and\r\n// files a new incident. The StatusChange is IN FLIGHT when the shift ends —\r\n// it travels with the fork instead of being silently dropped.\r\nset(inc1, Assignee { name: \"maya\" })\r\nemit StatusChange { inc: inc3, to: \"resolved\" }\r\nlet _day_new = spawn(\"INC-4\", Incident { title: \"cert expiry\", priority: 2, age: 0, status: \"open\" })\r\nlet day = fork()\r\n\r\n// Night shift, from the same base: assigns INC-2 and files its own incident —\r\n// which lands on the SAME runtime id INC-4 took in the day branch.\r\ncommit(base)\r\nset(inc2, Assignee { name: \"raj\" })\r\nlet _night_new = spawn(\"INC-5\", Incident { title: \"queue backlog\", priority: 1, age: 0, status: \"open\" })\r\nlet night = fork()\r\n\r\ncommit(base)\r\nmatch merge_forks(base, day, night) {\r\n    Ok(merged) => {\r\n        // ---- #3: fence the merge before adopting it.\r\n        let d = diff(base, merged)\r\n        print(f\"merge blast radius: {d}\")\r\n        assert_only_changed(base, merged, [Incident, Assignee])\r\n        commit(merged)\r\n    }\r\n    Err(msg) => { print(f\"merge refused: {msg}\") }\r\n}\r\n\r\n// Both shifts' incidents exist — the id collision was remapped, not lost.\r\nlet four = get_entity(\"INC-4\")\r\nlet five = get_entity(\"INC-5\")\r\nprint(f\"INC-4 and INC-5 both filed: {four != five}\")\r\n\r\n// The day shift's in-flight resolution fires on the merged timeline.\r\nflush_events()\r\nlet r3 = get(inc3, Incident) |> unwrap\r\nlet board = get_resource(Board) |> unwrap\r\nlet audit = get_resource(Audit) |> unwrap\r\nprint(f\"INC-3 status '{r3.status}' | board open: {board.open} | audit: {audit.log}\")\r\n\r\n// ---- #4: why is INC-3 resolved? why is INC-1 assigned? --------------------\r\nprint(\"-- why(INC-3, Incident) --\")\r\nprint(why(inc3, Incident))\r\nprint(\"-- why(INC-1, Assignee) -- (note the disclosed commit seam)\")\r\nprint(why(inc1, Assignee))\r\n\r\n// ---- persist v2 for tomorrow ----------------------------------------------\r\nwrite_file(\"dogfood/opsdesk/world.json\", save_world())\r\nprint(\"v2 world saved\")\r\n","source_hash":"d854cb682387e9376a4f3c4e44deb442b9116061bfcc848351443b96aa8a4c35","t":"header","version":1}
{"a":"e0f695b8d3f559e4","b":"read_file","f":0,"r":{"t":"str","v":"{\"entities\":[{\"components\":{\"Incident\":{\"age\":{\"t\":\"int\",\"v\":4},\"sev\":{\"t\":\"int\",\"v\":2},\"title\":{\"t\":\"str\",\"v\":\"db latency\"}}},\"name\":\"INC-1\"},{\"components\":{\"Incident\":{\"age\":{\"t\":\"int\",\"v\":1},\"sev\":{\"t\":\"int\",\"v\":1},\"title\":{\"t\":\"str\",\"v\":\"login 500s\"}}},\"name\":\"INC-2\"},{\"components\":{\"Incident\":{\"age\":{\"t\":\"int\",\"v\":9},\"sev\":{\"t\":\"int\",\"v\":3},\"title\":{\"t\":\"str\",\"v\":\"disk full on ci-7\"}}},\"name\":\"INC-3\"}],\"resources\":{\"Board\":{\"open\":{\"t\":\"int\",\"v\":3}}},\"schema\":{\"Board\":[\"open\"],\"Incident\":[\"title\",\"sev\",\"age\"]},\"version\":1}"},"s":0,"t":"io"}

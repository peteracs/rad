component Balance { value: int = 0 }
component MerchantRiskProfile { score: int = 0 }
fn hidden(target: entity) { set(target, MerchantRiskProfile { score: 99 }) }
transaction Capture(target: entity) {
    requires has(target, Balance)
    changes_only [Balance]
    update(target, Balance) { value = 1 }
    hidden(target)
    ensures has(target, Balance)
}
let target = spawn(Balance {}, MerchantRiskProfile {})
Capture(target)

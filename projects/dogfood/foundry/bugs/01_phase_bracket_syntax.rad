// BUG 01: spec §3.5.1 documents `phase <Name> [<System>, ...]` with BRACKETS,
// but the parser (core/vm/src/parser/decl.rs::parse_phase_decl) expects BRACES.
//
// Expected: this file runs (it is copied verbatim from the spec's own example
//           shape, and `schedule [...]` uses brackets, so brackets are the
//           consistent spelling).
// Actual:   parse error "Expected LBrace, got LBracket" at the phase line,
//           followed by "Running unknown system 'Front'".
//
// Swap the brackets for braces (`phase Front { A, B }`) and it runs, so only
// the surface syntax diverges from the documented grammar.

component Widget { n: 0 }

resource Tally { a: 0, b: 0 }

system Alpha(w: Widget, t: mut Tally) {
    t.a = t.a + w.n
}

system Beta(t: mut Tally) after Alpha {
    t.b = t.b + 1
}

phase Front [Alpha, Beta]

spawn(Widget { n: 5 })

schedule [Front]

print(f"a={res(Tally).a} b={res(Tally).b}")

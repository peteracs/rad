// Regression 01: phase declarations have one canonical brace-delimited form.
// Scheduling remains list-shaped because it is an invocation list, while a
// phase is a declaration body.

component Widget { n: 0 }

resource Tally { a: 0, b: 0 }

system Alpha(w: Widget, t: mut Tally) {
    t.a = t.a + w.n
}

system Beta(t: mut Tally) after Alpha {
    t.b = t.b + 1
}

phase Front { Alpha, Beta }

spawn(Widget { n: 5 })

schedule [Front]

print(f"a={res(Tally).a} b={res(Tally).b}")

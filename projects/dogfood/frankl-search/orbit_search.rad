// Heuristic search over closures generated by several complete cyclic orbits.
//
// Rotation is transitive on the 13 coordinates, so every generated family is
// coordinate-regular. A strict negative density margin would therefore be a
// counterexample immediately. RAD owns the alternative universes, seeded
// mutation, deterministic selection, settlement, and causal explanation; the
// project extension owns only generic Boolean-lattice closure statistics.

use "structure_lib.rad"
use "../native-math-kernels/math_kernels.rad"

let WIDTH = 13
let MIN_FAMILY_SIZE = 51
let OUTPUT_PATH = "projects/dogfood/frankl-search/out/orbit-search.json"

resource OrbitCandidate {
    basis: list = [1, 3, 5]
    frequencies: list = []
    members: int = 0
    frequency: int = 0
    margin: int = 0
    signature: int = 0
    separating: bool = false
    generation: int = 0
}

resource OrbitSearchConfig {
    representatives: list = []
    local_trials: int = 32
}

resource OrbitTelemetry {
    evaluated: int = 0
    negative: int = 0
    equality: int = 0
    positive: int = 0
}

component OrbitSearchCertificate {
    members: int = 0
    frequency: int = 0
    margin: int = 0
    uniform: bool = false
    closed: bool = false
    separating: bool = false
}

component RegularDeletionCertificate {
    deleted_sets: int = 0
    deleted_rank_sum: int = 0
    deleted_incidence_per_coordinate: int = 0
    margin: int = 0
}

intent OrbitSearchEvidence {
    key target: entity
    members: int
    frequency: int
    margin: int
    uniform: bool
    closed: bool
    separating: bool
}

intent MissingOrbitEvidence {
    key target: entity
    representative: int
    orbit_size: int
    rank_sum: int
}

law SubmitOrbitSearchEvidence(
    target: entity,
    members: int,
    frequency: int,
    margin: int,
    uniform: bool,
    closed: bool,
    separating: bool,
) {
    propose OrbitSearchEvidence {
        target: target,
        members: members,
        frequency: frequency,
        margin: margin,
        uniform: uniform,
        closed: closed,
        separating: separating,
    }
}

law SubmitMissingOrbitEvidence(
    target: entity,
    representative: int,
    orbit_size: int,
    rank_sum: int,
) {
    propose MissingOrbitEvidence {
        target: target,
        representative: representative,
        orbit_size: orbit_size,
        rank_sum: rank_sum,
    }
}

resolver ResolveOrbitSearchEvidence for OrbitSearchEvidence(target, proposals) {
    let p = proposals[0]
    next(target, OrbitSearchCertificate {
        members: p.members,
        frequency: p.frequency,
        margin: p.margin,
        uniform: p.uniform,
        closed: p.closed,
        separating: p.separating,
    })
}

resolver ResolveMissingOrbitEvidence for MissingOrbitEvidence(target, proposals) {
    let mut deleted_sets = 0
    let mut deleted_rank_sum = 0
    for proposal in proposals {
        deleted_sets = deleted_sets + proposal.orbit_size
        deleted_rank_sum = deleted_rank_sum + proposal.rank_sum
    }
    let deleted_incidence = deleted_rank_sum / WIDTH
    next(target, RegularDeletionCertificate {
        deleted_sets: deleted_sets,
        deleted_rank_sum: deleted_rank_sum,
        deleted_incidence_per_coordinate: deleted_incidence,
        margin: deleted_sets - deleted_incidence * 2,
    })
}

constraint ValidOrbitSearchCertificate for OrbitSearchCertificate(subject, proposed) {
    require proposed.members >= MIN_FAMILY_SIZE
    else "frankl.orbit.family_below_open_boundary"
    require proposed.margin == proposed.frequency * 2 - proposed.members
    else "frankl.orbit.margin_mismatch"
    require proposed.uniform else "frankl.orbit.nonuniform"
    require proposed.closed else "frankl.orbit.not_closed"
    require proposed.separating else "frankl.orbit.not_separating"
}

constraint ValidRegularDeletionCertificate
for RegularDeletionCertificate(subject, proposed)
watches OrbitSearchCertificate
{
    let search = candidate(subject, OrbitSearchCertificate)
    require proposed.deleted_rank_sum % WIDTH == 0
    else "frankl.orbit.nontransitive_deleted_incidence"
    require proposed.deleted_sets == shl(1, WIDTH) - search.members
    else "frankl.orbit.deleted_partition_mismatch"
    require proposed.margin == search.margin
    else "frankl.orbit.dual_margin_identity_mismatch"
}

entity orbit_judge {
    OrbitSearchCertificate {}
    RegularDeletionCertificate {}
}

event OrbitSearchCompleted {
    evaluated: int
    margin: int
}

resource OrbitJournal {
    summary: str = "not-run"
}

on OrbitSearchCompleted(evt) {
    set_resource(OrbitJournal, OrbitJournal {
        summary: f"evaluated {evt.evaluated} regular closures; best margin {evt.margin}"
    })
}

pure fn orbit_generators(basis: list<int>) -> list<int> {
    let mut generators = []
    for representative in basis {
        generators = extend(generators, bitmask_rotation_orbit(representative, WIDTH))
    }
    return generators
}

pure fn canonical_orbit_basis(basis: list<int>) -> list<int> {
    let mut result = []
    for representative in sort(basis) {
        if not contains(result, representative) {
            result = push(result, representative)
        }
    }
    return result
}

pure fn mask_rank(mask: int) -> int {
    let mut rank = 0
    for bit in range(WIDTH) {
        if (mask & shl(1, bit)) != 0 {
            rank = rank + 1
        }
    }
    return rank
}

pure fn analyze_orbit_basis(basis: list<int>, generation: int) -> OrbitCandidate {
    let canonical_basis = canonical_orbit_basis(basis)
    let stats = lattice_profile(orbit_generators(canonical_basis), WIDTH)
    let frequencies = stats["frequencies"]
    let frequency = max_int(frequencies)
    return OrbitCandidate {
        basis: canonical_basis,
        frequencies: frequencies,
        members: stats["size"],
        frequency: frequency,
        margin: frequency * 2 - stats["size"],
        signature: stats["signature"],
        separating: stats["separating"],
        generation: generation,
    }
}

pure fn orbit_better(left: OrbitCandidate, right: OrbitCandidate) -> bool {
    if left.separating != right.separating {
        return left.separating
    }
    let left_open = left.members >= MIN_FAMILY_SIZE
    let right_open = right.members >= MIN_FAMILY_SIZE
    if left_open != right_open {
        return left_open
    }
    if not left_open and left.members != right.members {
        return left.members > right.members
    }
    let left_counterexample = left.margin < 0
    let right_counterexample = right.margin < 0
    if left_counterexample != right_counterexample {
        return left_counterexample
    }
    let left_nonfull = left.members < shl(1, WIDTH)
    let right_nonfull = right.members < shl(1, WIDTH)
    if left_nonfull != right_nonfull {
        return left_nonfull
    }
    let left_ratio = left.frequency * right.members
    let right_ratio = right.frequency * left.members
    if left_ratio != right_ratio {
        return left_ratio < right_ratio
    }
    if left.members != right.members {
        return left.members > right.members
    }
    for index in range(min(len(left.basis), len(right.basis))) {
        if left.basis[index] != right.basis[index] {
            return left.basis[index] < right.basis[index]
        }
    }
    return len(left.basis) < len(right.basis)
}

system ExploreOrbitBases(
    candidate: mut OrbitCandidate,
    config: OrbitSearchConfig,
    telemetry: mut OrbitTelemetry,
) {
    let mut best = candidate
    let mut have_distinct = false
    let mut negative = 0
    let mut equality = 0
    let mut positive = 0
    for _trial in range(config.local_trials) {
        let mut basis = candidate.basis
        if rand_int(0, 11) == 0 {
            for slot in range(len(basis)) {
                basis[slot] = config.representatives[rand_int(0, len(config.representatives) - 1)]
            }
        } else {
            let edits = rand_int(1, min(3, len(basis)))
            for _edit in range(edits) {
                let slot = rand_int(0, len(basis) - 1)
                basis[slot] = config.representatives[rand_int(0, len(config.representatives) - 1)]
            }
        }
        let explored = analyze_orbit_basis(basis, candidate.generation + 1)
        if explored.margin < 0 {
            negative = negative + 1
        } else if explored.margin == 0 {
            equality = equality + 1
        } else {
            positive = positive + 1
        }
        let distinct = explored.signature != candidate.signature
        or explored.members != candidate.members
        or explored.frequencies != candidate.frequencies
        if distinct and (not have_distinct or orbit_better(explored, best)) {
            best = explored
            have_distinct = true
        }
    }
    candidate = best
    telemetry = OrbitTelemetry {
        evaluated: config.local_trials,
        negative: negative,
        equality: equality,
        positive: positive,
    }
}

pure fn same_orbit_family(left: OrbitCandidate, right: OrbitCandidate) -> bool {
    return left.signature == right.signature
    and left.members == right.members
    and left.frequencies == right.frequencies
}

fn insert_orbit_world(
    beam: list<world_fork>,
    candidate_world: world_fork,
    width: int,
) -> list<world_fork> {
    let candidate = peek_resource(candidate_world, OrbitCandidate) |> unwrap
    for existing in beam {
        let incumbent = peek_resource(existing, OrbitCandidate) |> unwrap
        if same_orbit_family(candidate, incumbent) {
            return beam
        }
    }
    let mut result = []
    let mut inserted = false
    for existing in beam {
        let incumbent = peek_resource(existing, OrbitCandidate) |> unwrap
        if not inserted and orbit_better(candidate, incumbent) {
            result = push(result, candidate_world)
            inserted = true
        }
        result = push(result, existing)
    }
    if not inserted {
        result = push(result, candidate_world)
    }
    if len(result) > width {
        result = drop_last(result)
    }
    return result
}

fn main() -> nil {
    let argv = sys_args()
    let generations = if len(argv) > 0 { int(argv[0]) } else { 32 }
    let beam_width = if len(argv) > 1 { int(argv[1]) } else { 8 }
    let children = if len(argv) > 2 { int(argv[2]) } else { 8 }
    let local_trials = if len(argv) > 3 { int(argv[3]) } else { 32 }
    let orbit_slots = if len(argv) > 4 { int(argv[4]) } else { 4 }
    let output_path = if len(argv) > 5 { argv[5] } else { OUTPUT_PATH }
    assert(generations > 0 and beam_width > 0, "positive search shape required")
    assert(children > 0 and local_trials > 0, "positive rollout shape required")
    assert(orbit_slots >= 3, "search starts beyond the exact two-orbit class")

    let representatives = bitmask_rotation_representatives(WIDTH)
        |> filter(fn(mask) { return mask != 0 and mask != shl(1, WIDTH) - 1 })
    let search_representatives = filter(representatives, fn(representative) {
        // The singleton orbit generates the complete cube by itself. It is an
        // exact equality case, already classified by cyclic_universes.rad,
        // and otherwise swallows every positive non-full search frontier.
        return representative != 1
    })
    let mut initial_basis = []
    for slot in range(orbit_slots) {
        initial_basis = push(initial_basis, representatives[slot + 1])
    }
    let initial = analyze_orbit_basis(initial_basis, 0)
    set_resource(OrbitCandidate, initial)
    set_resource(OrbitSearchConfig, OrbitSearchConfig {
        representatives: search_representatives,
        local_trials: local_trials,
    })

    let live_digest = world_digest()
    let root = fork()
    let mut beam = [root]
    let mut best_world = root
    let mut best = initial
    let mut evaluated = 1
    let mut negative = 0
    let mut equality = if initial.margin == 0 { 1 } else { 0 }
    let mut positive = if initial.margin > 0 { 1 } else { 0 }

    print(f"regular orbit search slots={orbit_slots} representatives={len(representatives)}")
    for generation in range(generations) {
        let mut inputs = []
        for parent in beam {
            for _child in range(children) {
                inputs = push(inputs, fork_with(parent, OrbitTelemetry {}))
            }
        }
        let futures = simulate_many(
            inputs,
            [system::ExploreOrbitBases],
            1,
            1979 + generation * 1009,
        )
        let mut next = []
        for future in futures {
            let batch = peek_resource(future, OrbitTelemetry) |> unwrap
            evaluated = evaluated + batch.evaluated
            negative = negative + batch.negative
            equality = equality + batch.equality
            positive = positive + batch.positive
            let candidate = peek_resource(future, OrbitCandidate) |> unwrap
            if orbit_better(candidate, best) {
                best = candidate
                best_world = future
            }
            next = insert_orbit_world(next, future, beam_width)
        }
        beam = next
        if generation == 0 or (generation + 1) % 4 == 0 {
            let frontier = peek_resource(beam[0], OrbitCandidate) |> unwrap
            print(f"generation={generation + 1} family={frontier.members} frequency={frontier.frequency} margin={frontier.margin}")
        }
    }

    best = peek_resource(best_world, OrbitCandidate) |> unwrap
    assert(world_digest() == live_digest, "orbit universes mutated the live world")
    let generators = orbit_generators(best.basis)
    let family = lattice_closure(generators)
    let frequencies = lattice_frequencies(family, WIDTH)
    let uniform = min_int(frequencies) == max_int(frequencies)
    let closed = lattice_is_closed(family)
    let separating = family_is_separating(family, WIDTH)
    let mut present = bitset_new()
    for member in family {
        present = bitset_set(present, member)
    }
    let mut missing_orbits = 0
    settle {
        SubmitOrbitSearchEvidence(
            orbit_judge,
            len(family),
            max_int(frequencies),
            max_int(frequencies) * 2 - len(family),
            uniform,
            closed,
            separating,
        )
        for representative in representatives {
            if not bitset_has(present, representative) {
                let orbit = rotation_orbit(representative, WIDTH)
                missing_orbits = missing_orbits + 1
                SubmitMissingOrbitEvidence(
                    orbit_judge,
                    representative,
                    len(orbit),
                    len(orbit) * mask_rank(representative),
                )
            }
        }
    }
    emit OrbitSearchCompleted { evaluated: evaluated, margin: best.margin }
    flush_events()

    print(f"evaluated={evaluated} negative={negative} equality={equality} positive={positive}")
    print(f"best basis={best.basis} family={best.members} frequency={best.frequency} margin={best.margin}")
    print(why(orbit_judge, OrbitSearchCertificate))
    print(why(orbit_judge, RegularDeletionCertificate))
    print(f"journal={res(OrbitJournal).summary}")
    let certificate: map<str, any> = {
        "schema": "rad.frankl.regular-orbit-search.v1",
        "width": WIDTH,
        "orbit_slots": orbit_slots,
        "evaluated": evaluated,
        "negative": negative,
        "equality": equality,
        "positive": positive,
        "basis": best.basis,
        "generators": generators,
        "family_size": best.members,
        "frequencies": best.frequencies,
        "frequency": best.frequency,
        "margin": best.margin,
        "signature": best.signature,
        "uniform": uniform,
        "union_closed": closed,
        "separating": separating,
        "counterexample": best.margin < 0,
        "missing_orbits": missing_orbits,
        "deleted_sets": require(orbit_judge, RegularDeletionCertificate).deleted_sets,
        "deleted_rank_sum": require(orbit_judge, RegularDeletionCertificate).deleted_rank_sum,
        "deleted_average_rank_numerator": require(orbit_judge, RegularDeletionCertificate).deleted_rank_sum,
        "deleted_average_rank_denominator": require(orbit_judge, RegularDeletionCertificate).deleted_sets,
        "dual_counterexample_pressure": require(orbit_judge, RegularDeletionCertificate).deleted_rank_sum * 2
        - WIDTH * require(orbit_judge, RegularDeletionCertificate).deleted_sets,
    }
    write_file(output_path, json_stringify(certificate))
    print(f"certificate={output_path}")
}

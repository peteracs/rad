// Exact structural search at N=13.
//
// Instead of sampling arbitrary generator bases, this program exhausts every
// union-closed family generated by one or two complete cyclic orbits. Cyclic
// symmetry makes every element frequency identical, so any negative margin
// would immediately be a Frankl counterexample. Separate COW universes own
// disjoint lanes; one Causal-Laws settlement combines their evidence.

use "structure_lib.rad"
use "../native-math-kernels/math_kernels.rad"

let WIDTH = 13
let LANE_COUNT = 8
let REPRESENTATIVE_COUNT = 630
let EXPECTED_FAMILIES = 198765 // 630 * 631 / 2, including repeated pairs.
let MIN_COUNTEREXAMPLE_SIZE = 51
let OUTPUT_PATH = "projects/dogfood/frankl-search/out/cyclic-universes.json"

resource CyclicLane {
    lane_index: int = 0
    lane_count: int = 1
    representatives: list = []
    evaluated: int = 0
    equality_families: int = 0
    diagonal_equality_families: int = 0
    off_diagonal_equality_families: int = 0
    full_cube_families: int = 0
    equality_non_full_families: int = 0
    positive_families: int = 0
    negative_families: int = 0
    separating_families: int = 0
    best_generators: list = []
    best_frequencies: list = []
    best_members: int = 0
    best_max_frequency: int = 0
    best_margin: int = 999999999
    best_signature: int = 0
}

component StructuralEvidence {
    evaluated: int = 0
    equality_families: int = 0
    diagonal_equality_families: int = 0
    off_diagonal_equality_families: int = 0
    full_cube_families: int = 0
    equality_non_full_families: int = 0
    positive_families: int = 0
    negative_families: int = 0
    separating_families: int = 0
    best_generators: list = []
    best_frequencies: list = []
    best_members: int = 0
    best_max_frequency: int = 0
    best_margin: int = 0
    best_signature: int = 0
}

intent LaneStudy {
    key target: entity
    lane_index: int
    evaluated: int
    equality_families: int
    diagonal_equality_families: int
    off_diagonal_equality_families: int
    full_cube_families: int
    equality_non_full_families: int
    positive_families: int
    negative_families: int
    separating_families: int
    best_generators: list
    best_frequencies: list
    best_members: int
    best_max_frequency: int
    best_margin: int
    best_signature: int
}

law SubmitLaneStudy(target: entity, lane: CyclicLane) {
    propose LaneStudy {
        target: target,
        lane_index: lane.lane_index,
        evaluated: lane.evaluated,
        equality_families: lane.equality_families,
        diagonal_equality_families: lane.diagonal_equality_families,
        off_diagonal_equality_families: lane.off_diagonal_equality_families,
        full_cube_families: lane.full_cube_families,
        equality_non_full_families: lane.equality_non_full_families,
        positive_families: lane.positive_families,
        negative_families: lane.negative_families,
        separating_families: lane.separating_families,
        best_generators: lane.best_generators,
        best_frequencies: lane.best_frequencies,
        best_members: lane.best_members,
        best_max_frequency: lane.best_max_frequency,
        best_margin: lane.best_margin,
        best_signature: lane.best_signature,
    }
}

resolver ResolveLaneStudies for LaneStudy(target, proposals) {
    let mut evaluated = 0
    let mut equality_families = 0
    let mut diagonal_equality_families = 0
    let mut off_diagonal_equality_families = 0
    let mut full_cube_families = 0
    let mut equality_non_full_families = 0
    let mut positive_families = 0
    let mut negative_families = 0
    let mut separating_families = 0
    let mut best_generators = []
    let mut best_frequencies = []
    let mut best_members = 0
    let mut best_max_frequency = 0
    let mut best_margin = 0
    let mut best_signature = 0

    for proposal in proposals {
        evaluated = evaluated + proposal.evaluated
        equality_families = equality_families + proposal.equality_families
        diagonal_equality_families = diagonal_equality_families + proposal.diagonal_equality_families
        off_diagonal_equality_families = off_diagonal_equality_families + proposal.off_diagonal_equality_families
        full_cube_families = full_cube_families + proposal.full_cube_families
        equality_non_full_families = equality_non_full_families + proposal.equality_non_full_families
        positive_families = positive_families + proposal.positive_families
        negative_families = negative_families + proposal.negative_families
        separating_families = separating_families + proposal.separating_families
        let left = proposal.best_max_frequency * best_members
        let right = best_max_frequency * proposal.best_members
        let better = proposal.best_members > 0 and (
            best_members == 0
            or left < right
            or (left == right and proposal.best_members > best_members)
        )
        if better {
            best_generators = proposal.best_generators
            best_frequencies = proposal.best_frequencies
            best_members = proposal.best_members
            best_max_frequency = proposal.best_max_frequency
            best_margin = proposal.best_margin
            best_signature = proposal.best_signature
        }
    }

    next(target, StructuralEvidence {
        evaluated: evaluated,
        equality_families: equality_families,
        diagonal_equality_families: diagonal_equality_families,
        off_diagonal_equality_families: off_diagonal_equality_families,
        full_cube_families: full_cube_families,
        equality_non_full_families: equality_non_full_families,
        positive_families: positive_families,
        negative_families: negative_families,
        separating_families: separating_families,
        best_generators: best_generators,
        best_frequencies: best_frequencies,
        best_members: best_members,
        best_max_frequency: best_max_frequency,
        best_margin: best_margin,
        best_signature: best_signature,
    })
}

constraint ExactCyclicStudy for StructuralEvidence(subject, proposed) {
    require proposed.evaluated == EXPECTED_FAMILIES
        else "frankl.cyclic.incomplete_enumeration"
    require proposed.equality_families + proposed.positive_families + proposed.negative_families
        == proposed.evaluated
        else "frankl.cyclic.classification_mismatch"
    require proposed.diagonal_equality_families + proposed.off_diagonal_equality_families
        == proposed.equality_families
        else "frankl.cyclic.equality_partition_mismatch"
    require proposed.full_cube_families + proposed.equality_non_full_families
        == proposed.equality_families
        else "frankl.cyclic.equality_shape_mismatch"
    require proposed.best_members >= MIN_COUNTEREXAMPLE_SIZE
        else "frankl.cyclic.best_below_open_size"
    require proposed.best_margin == proposed.best_max_frequency * 2 - proposed.best_members
        else "frankl.cyclic.margin_mismatch"
}

entity structure_judge { StructuralEvidence {} }

pure fn stats_are_better(
    members: int,
    maximum: int,
    separating: bool,
    best_members: int,
    best_maximum: int,
) -> bool {
    if not separating or members < MIN_COUNTEREXAMPLE_SIZE {
        return false
    }
    if best_members == 0 {
        return true
    }
    let left = maximum * best_members
    let right = best_maximum * members
    if left != right {
        return left < right
    }
    return members > best_members
}

system EnumerateCyclicLane(lane: mut CyclicLane) {
    let representatives = lane.representatives
    let mut evaluated = 0
    let mut equality_families = 0
    let mut diagonal_equality_families = 0
    let mut off_diagonal_equality_families = 0
    let mut full_cube_families = 0
    let mut equality_non_full_families = 0
    let mut positive_families = 0
    let mut negative_families = 0
    let mut separating_families = 0
    let mut best_generators = []
    let mut best_frequencies = []
    let mut best_members = 0
    let mut best_max_frequency = 0
    let mut best_margin = 999999999
    let mut best_signature = 0

    for left in range(lane.lane_index, len(representatives), lane.lane_count) {
        let left_orbit = rotation_orbit(representatives[left], WIDTH)
        for right in range(left, len(representatives)) {
            let generators = extend(left_orbit, rotation_orbit(representatives[right], WIDTH))
            let stats = lattice_profile(generators, WIDTH)
            let members = stats["size"]
            let frequencies = stats["frequencies"]
            let maximum = max_int(frequencies)
            let margin = maximum * 2 - members
            evaluated = evaluated + 1
            if stats["separating"] {
                separating_families = separating_families + 1
            }
            if margin < 0 {
                negative_families = negative_families + 1
            } else if margin == 0 {
                equality_families = equality_families + 1
                if left == right {
                    diagonal_equality_families = diagonal_equality_families + 1
                } else {
                    off_diagonal_equality_families = off_diagonal_equality_families + 1
                }
                if members == shl(1, WIDTH) {
                    full_cube_families = full_cube_families + 1
                } else {
                    equality_non_full_families = equality_non_full_families + 1
                }
            } else {
                positive_families = positive_families + 1
            }
            if stats_are_better(members, maximum, stats["separating"], best_members, best_max_frequency) {
                best_generators = generators
                best_frequencies = frequencies
                best_members = members
                best_max_frequency = maximum
                best_margin = margin
                best_signature = stats["signature"]
            }
        }
    }

    lane = CyclicLane {
        lane_index: lane.lane_index,
        lane_count: lane.lane_count,
        representatives: representatives,
        evaluated: evaluated,
        equality_families: equality_families,
        diagonal_equality_families: diagonal_equality_families,
        off_diagonal_equality_families: off_diagonal_equality_families,
        full_cube_families: full_cube_families,
        equality_non_full_families: equality_non_full_families,
        positive_families: positive_families,
        negative_families: negative_families,
        separating_families: separating_families,
        best_generators: best_generators,
        best_frequencies: best_frequencies,
        best_members: best_members,
        best_max_frequency: best_max_frequency,
        best_margin: best_margin,
        best_signature: best_signature,
    }
}

event StructuralStudyCompleted {
    evaluated: int
    negative_families: int
}

resource StudyJournal {
    summary: str = "not-run"
}

on StructuralStudyCompleted(evt) {
    set_resource(StudyJournal, StudyJournal {
        summary: f"exact cyclic class: {evt.evaluated} families, {evt.negative_families} counterexamples"
    })
}

fn main() -> nil {
    let representatives = necklace_representatives(WIDTH)
    assert(len(representatives) == REPRESENTATIVE_COUNT, "unexpected necklace count")

    let live_before = world_digest()
    let root = fork()
    let mut lane_forks = []
    for lane_index in range(LANE_COUNT) {
        lane_forks = push(lane_forks, fork_with(root, CyclicLane {
            lane_index: lane_index,
            lane_count: LANE_COUNT,
            representatives: representatives,
        }))
    }

    let futures = simulate_many(lane_forks, [system::EnumerateCyclicLane], 1, 1979)
    assert(world_digest() == live_before, "exact fork enumeration mutated the live universe")
    let mut lanes = []
    for future in futures {
        lanes = push(lanes, peek_resource(future, CyclicLane) |> unwrap)
    }

    // Eight independent exact enumerators become eight simultaneous causes.
    // Their proposal order carries no meaning; one resolver owns the fan-in.
    settle {
        for lane in lanes {
            SubmitLaneStudy(structure_judge, lane)
        }
    }
    let evidence = require(structure_judge, StructuralEvidence)
    let evidence_why = why(structure_judge, StructuralEvidence)

    let best_family = lattice_closure(evidence.best_generators)
    let deleted = complement_family(best_family, WIDTH)
    let deleted_surpluses = deletion_majority_surpluses(deleted, WIDTH)
    let best_union_violations = lattice_violation_count(best_family, WIDTH)
    assert(best_union_violations == 0, "closure-generated finalist must be union-closed")

    // The dual obstruction, made executable:
    // deleting every rank >= 7 set makes every deleted element abundant,
    // exactly what a counterexample needs. But the remaining low-rank family
    // has many missing unions. Closing it regenerates the full Boolean cube
    // and restores margin zero.
    let mut tempting_deleted = []
    for member in high_rank_family(WIDTH, 7) {
        // Any union-closed family covering [13] must retain its full union.
        if member != shl(1, WIDTH) - 1 {
            tempting_deleted = push(tempting_deleted, member)
        }
    }
    let tempting_remaining = complement_family(tempting_deleted, WIDTH)
    let tempting_surpluses = deletion_majority_surpluses(tempting_deleted, WIDTH)
    let tempting_violations = lattice_violation_count(tempting_remaining, WIDTH)
    let repaired = lattice_closure(tempting_remaining)
    let repaired_frequencies = lattice_frequencies(repaired, WIDTH)
    let repaired_margin = max_int(repaired_frequencies) * 2 - len(repaired)
    assert(min_int(tempting_surpluses) > 0, "high-rank deletion must satisfy strict dual majority")
    assert(tempting_violations > 0, "tempting dual majority must break union closure")
    assert(repaired_margin == 0, "closure repair should return to the equality wall")

    emit StructuralStudyCompleted {
        evaluated: evidence.evaluated,
        negative_families: evidence.negative_families,
    }
    flush_events()

    let certificate: map<str, any> = {
        "schema": "rad.frankl-structural-study.v1",
        "universe_size": WIDTH,
        "class": "closures generated by at most two cyclic rotation orbits",
        "necklace_representatives": len(representatives),
        "families_evaluated": evidence.evaluated,
        "equality_families": evidence.equality_families,
        "diagonal_equality_families": evidence.diagonal_equality_families,
        "off_diagonal_equality_families": evidence.off_diagonal_equality_families,
        "full_cube_families": evidence.full_cube_families,
        "equality_non_full_families": evidence.equality_non_full_families,
        "positive_families": evidence.positive_families,
        "negative_families": evidence.negative_families,
        "separating_families": evidence.separating_families,
        "best_generators": evidence.best_generators,
        "best_family": best_family,
        "best_frequencies": evidence.best_frequencies,
        "best_members": evidence.best_members,
        "best_max_frequency": evidence.best_max_frequency,
        "best_margin": evidence.best_margin,
        "best_rank_histogram": rank_histogram(best_family, WIDTH),
        "best_deleted_size": len(deleted),
        "best_deleted_majority_surpluses": deleted_surpluses,
        "best_union_violations": best_union_violations,
        "tempting_deleted_size": len(tempting_deleted),
        "tempting_deleted_majority_surpluses": tempting_surpluses,
        "tempting_remaining_size": len(tempting_remaining),
        "tempting_union_violations": tempting_violations,
        "repaired_size": len(repaired),
        "repaired_margin": repaired_margin,
        "causal_why": evidence_why,
        "journal_why": why_resource(StudyJournal),
    }
    create_dir("projects/dogfood/frankl-search/out")
    write_file(OUTPUT_PATH, json_stringify(certificate))

    print("Frankl structural study: exact cyclic universes")
    print(f"representatives={len(representatives)} exact_families={evidence.evaluated}")
    print(f"negative={evidence.negative_families} equality={evidence.equality_families} (full_cube={evidence.full_cube_families}, non_full={evidence.equality_non_full_families}) positive={evidence.positive_families}")
    print(f"best={evidence.best_max_frequency}/{evidence.best_members} margin={evidence.best_margin} deleted_dual_min={min_int(deleted_surpluses)}")
    print(f"tempting_dual_min={min_int(tempting_surpluses)} but_union_violations={tempting_violations}")
    print(f"closure_repair_size={len(repaired)} repaired_margin={repaired_margin}")
    print(evidence_why)
    print(why_resource(StudyJournal))
    print(f"certificate={OUTPUT_PATH}")
}

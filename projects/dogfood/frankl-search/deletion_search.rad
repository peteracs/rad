// Frankl search by legal deletion from the full Boolean cube.

use "../native-math-kernels/math_kernels.rad"
//
// Unlike generator mutation, every intermediate family is union-closed.
// `or_deletable_members` returns exactly the members whose removal cannot
// expose a missing union.  Thus every fork is a valid mathematical world and
// the search asks only whether its deletion frequencies can all become strict
// majorities.

use "structure_lib.rad"

let WIDTH = 13
let CUBE_SIZE = 8192
let MIN_FAMILY_SIZE = 51
let NEAR_MAX_FAMILY_SIZE = 4096
let OUTPUT_PATH = "projects/dogfood/frankl-search/out/deletion-near.json"

resource DeletionCandidate {
    deleted: list = []
    family_size: int = 8192
    frequencies: list = []
    deletion_surpluses: list = []
    frontier: list = []
    margin: int = 0
    depth: int = 0
    separating: bool = true
    regime: int = 0
}

resource DeletionConfig {
    rollout_steps: int = 8
    choices_per_step: int = 24
    minimum_density_per_mille: int = 0
    objective: str = "max_min"
    regime: int = 0
    forced_member: int = -1
    operation: str = "delete"
}

component DeletionCertificate {
    family_size: int = 0
    margin: int = 0
    union_closed: bool = false
    exact_partition: bool = false
    deletion_count: int = 0
    covers_universe: bool = false
    separating: bool = false
}

intent DeletionEvidence {
    key target: entity
    family_size: int
    margin: int
    union_closed: bool
    exact_partition: bool
    deletion_count: int
    covers_universe: bool
    separating: bool
}

law SubmitDeletionEvidence(
    target: entity,
    family_size: int,
    margin: int,
    union_closed: bool,
    exact_partition: bool,
    deletion_count: int,
    covers_universe: bool,
    separating: bool,
) {
    propose DeletionEvidence {
        target: target,
        family_size: family_size,
        margin: margin,
        union_closed: union_closed,
        exact_partition: exact_partition,
        deletion_count: deletion_count,
        covers_universe: covers_universe,
        separating: separating,
    }
}

resolver ResolveDeletionEvidence for DeletionEvidence(target, proposals) {
    let p = proposals[0]
    next(target, DeletionCertificate {
        family_size: p.family_size,
        margin: p.margin,
        union_closed: p.union_closed,
        exact_partition: p.exact_partition,
        deletion_count: p.deletion_count,
        covers_universe: p.covers_universe,
        separating: p.separating,
    })
}

constraint ValidDeletionCertificate for DeletionCertificate(subject, proposed) {
    require proposed.family_size >= MIN_FAMILY_SIZE
        else "frankl.deletion.family_too_small"
    require proposed.union_closed
        else "frankl.deletion.not_union_closed"
    require proposed.exact_partition
        else "frankl.deletion.partition_mismatch"
    require proposed.covers_universe
        else "frankl.deletion.incomplete_ground_set"
    require proposed.separating
        else "frankl.deletion.nonseparating"
}

entity deletion_judge { DeletionCertificate {} }

fn complement_from_deleted(deleted: list<int>) -> list<int> {
    let mut removed = bitset_new()
    for member in deleted {
        removed = bitset_set(removed, member)
    }
    let mut family = []
    for member in range(CUBE_SIZE) {
        if not bitset_has(removed, member) {
            family = push(family, member)
        }
    }
    return family
}

fn candidate_from(deleted: list<int>, depth: int) -> DeletionCandidate {
    let state = lattice_deletion_profile(deleted, WIDTH)
    return candidate_from_state(deleted, state, depth)
}

fn candidate_from_state(
    deleted: list<int>,
    state: map<str, any>,
    depth: int,
) -> DeletionCandidate {
    let family_size = state["family_size"]
    let frequencies = state["frequencies"]
    let surpluses = state["surpluses"]
    return DeletionCandidate {
        deleted: deleted,
        family_size: family_size,
        frequencies: frequencies,
        deletion_surpluses: surpluses,
        // The kernel has already intersected algebraic deletability with the
        // exact same-entity witnesses needed to preserve ground-set coverage
        // and coordinate separation.  Keeping this as one generic profile
        // avoids recomputing a full zeta transform for every rejected child.
        frontier: state["effective_frontier"],
        margin: max_int(frequencies) * 2 - family_size,
        depth: depth,
        separating: state["separating"],
        regime: 0,
    }
}

fn legal_frontier(
    candidate: DeletionCandidate,
    minimum_density_per_mille: int,
) -> list<int> {
    let mut result = []
    for member in candidate.frontier {
        // Keep the empty set: adjoining it never hurts Frankl's inequality,
        // and it provides a canonical representative of each family.
        let mut dense_enough = true
        for bit in range(WIDTH) {
            let next_frequency = candidate.frequencies[bit]
                - (if (member & shl(1, bit)) != 0 { 1 } else { 0 })
            if next_frequency * 1000
                < (candidate.family_size - 1) * minimum_density_per_mille {
                dense_enough = false
            }
        }
        if member != 0 and dense_enough {
            result = push(result, member)
        }
    }
    return result
}

fn profile_better(left: list<int>, right: list<int>) -> bool {
    for index in range(len(left)) {
        if left[index] != right[index] {
            return left[index] > right[index]
        }
    }
    return false
}

system ExploreLegalDeletions(candidate: mut DeletionCandidate, config: DeletionConfig) {
    assert(typeof(candidate) != "nil", "deletion candidate resource missing")
    assert(typeof(config) != "nil", "deletion config resource missing")
    // One explicitly seeded native call owns the dense incremental witness
    // tables for the whole rollout. RAD still owns the speculative world,
    // seed, branching, selection, and COW lifetime.
    let state = if config.forced_member >= 0 {
        lattice_apply_deletion(candidate.deleted, WIDTH, config.forced_member)
    } else if config.operation == "exchange" {
        lattice_exchange_rollout(
            candidate.deleted,
            WIDTH,
            config.rollout_steps,
            config.choices_per_step,
            rand_int(1, 2147483647),
            config.objective,
            config.minimum_density_per_mille,
        )
    } else {
        lattice_deletion_rollout(
            candidate.deleted,
            WIDTH,
            min(config.rollout_steps, candidate.family_size - MIN_FAMILY_SIZE),
            config.choices_per_step,
            rand_int(1, 2147483647),
            config.objective,
            config.minimum_density_per_mille,
        )
    }
    let deleted = state["deleted"]
    let next_depth = if config.operation == "exchange" {
        candidate.depth + config.rollout_steps
    } else {
        len(deleted)
    }
    let mut next = candidate_from_state(deleted, state, next_depth)
    next.regime = config.regime
    candidate = next
}

fn better(left: DeletionCandidate, right: DeletionCandidate) -> bool {
    if left.separating != right.separating {
        return left.separating
    }
    if left.family_size != right.family_size {
        return left.family_size < right.family_size
    }
    if left.margin != right.margin {
        return left.margin < right.margin
    }
    let left_peak = max_int(left.deletion_surpluses)
    let right_peak = max_int(right.deletion_surpluses)
    if left_peak != right_peak {
        return left_peak < right_peak
    }
    let left_profile = sort(left.deletion_surpluses)
    let right_profile = sort(right.deletion_surpluses)
    if left_profile != right_profile {
        return profile_better(left_profile, right_profile)
    }
    return len(left.frontier) > len(right.frontier)
}

fn same_candidate(left: DeletionCandidate, right: DeletionCandidate) -> bool {
    return left.deleted == right.deleted and left.regime == right.regime
}

fn dominates(left: DeletionCandidate, right: DeletionCandidate) -> bool {
    // A shallower world has not paid the same deletion budget and cannot
    // dominate a deeper one merely because its raw margins are smaller.
    if left.family_size != right.family_size or left.regime != right.regime {
        return false
    }
    let left_peak = max_int(left.deletion_surpluses)
    let right_peak = max_int(right.deletion_surpluses)
    return left.margin <= right.margin and left_peak <= right_peak
        and (left.margin < right.margin or left_peak < right_peak)
}

fn insert_pareto(
    beam: list<world_fork>,
    candidate_fork: world_fork,
    width: int,
) -> list<world_fork> {
    let candidate = peek_resource(candidate_fork, DeletionCandidate) |> unwrap
    for existing in beam {
        let current = peek_resource(existing, DeletionCandidate) |> unwrap
        if same_candidate(candidate, current) or dominates(current, candidate) {
            return beam
        }
    }
    let mut survivors = []
    for existing in beam {
        let current = peek_resource(existing, DeletionCandidate) |> unwrap
        if not dominates(candidate, current) {
            survivors = insert_beam(survivors, existing, width)
        }
    }
    return insert_beam(survivors, candidate_fork, width)
}

fn insert_beam(
    beam: list<world_fork>,
    candidate_fork: world_fork,
    width: int,
) -> list<world_fork> {
    let candidate = peek_resource(candidate_fork, DeletionCandidate) |> unwrap
    for existing in beam {
        let current = peek_resource(existing, DeletionCandidate) |> unwrap
        if same_candidate(candidate, current) {
            return beam
        }
    }
    let mut result = []
    let mut inserted = false
    for existing in beam {
        let current = peek_resource(existing, DeletionCandidate) |> unwrap
        if not inserted and better(candidate, current) {
            result = push(result, candidate_fork)
            inserted = true
        }
        result = push(result, existing)
    }
    if not inserted {
        result = push(result, candidate_fork)
    }
    if len(result) > width {
        result = drop_last(result)
    }
    return result
}

fn partition_is_exact(candidate: DeletionCandidate) -> bool {
    if candidate.family_size + len(candidate.deleted) != CUBE_SIZE {
        return false
    }
    let rebuilt = complement_from_deleted(candidate.deleted)
    return len(rebuilt) == candidate.family_size
}

fn main() -> nil {
    let argv = sys_args()
    let generations = if len(argv) > 0 { int(argv[0]) } else { 64 }
    let beam_width = if len(argv) > 1 { int(argv[1]) } else { 8 }
    let children = if len(argv) > 2 { int(argv[2]) } else { 8 }
    let rollout_steps = if len(argv) > 3 { int(argv[3]) } else { 8 }
    let choices = if len(argv) > 4 { int(argv[4]) } else { 24 }
    let target_family_size = if len(argv) > 6 { int(argv[6]) } else { 0 }
    let output_path = if len(argv) > 7 { argv[7] } else { OUTPUT_PATH }
    let minimum_density = if len(argv) > 8 { int(argv[8]) } else { 0 }
    let objective = if len(argv) > 9 { argv[9] } else { "max_min" }
    let selection = if len(argv) > 10 { argv[10] } else { "ordered" }
    let operation = if len(argv) > 11 { argv[11] } else { "delete" }
    assert(
        operation == "delete" or operation == "exchange",
        "operation must be delete or exchange",
    )
    assert(generations > 0 and beam_width > 0 and children > 0, "positive search dimensions required")

    let mut initial_deleted = []
    if len(argv) > 5 and argv[5] != "-" {
        let parsed = json_parse(read_file(argv[5]))
        assert(is_some(parsed), "resume certificate must contain valid JSON")
        let document = unwrap(parsed)
        assert(document["width"] == WIDTH, "resume certificate width mismatch")
        initial_deleted = document["deleted"]
    }
    let initial = candidate_from(initial_deleted, len(initial_deleted))
    set_resource(DeletionCandidate, initial)
    set_resource(DeletionConfig, DeletionConfig {
        rollout_steps: rollout_steps,
        choices_per_step: choices,
        minimum_density_per_mille: minimum_density,
        objective: objective,
        regime: 0,
        forced_member: -1,
        operation: operation,
    })
    let live_digest = world_digest()
    let root = fork()
    let mut beam = if selection == "pareto" { [] } else { [root] }
    if selection == "pareto" {
        for regime in range(10) {
            let portfolio_density = (regime % 5) * 100
            let portfolio_objective = if regime < 5 {
                "max_min"
            } else {
                "max_min_low_peak"
            }
            beam = push(beam, fork_with(root, DeletionConfig {
                rollout_steps: rollout_steps,
                choices_per_step: choices,
                minimum_density_per_mille: portfolio_density,
                objective: portfolio_objective,
                regime: regime,
                forced_member: -1,
                operation: operation,
            }))
        }
    }
    let mut evaluated = 1
    let mut have_near = false
    let mut near_fork = root
    let mut near_margin = 999999999
    let mut have_target = false
    let mut target_fork = root

    print(f"Frankl OR-closed search operation={operation}")
    print(f"initial family={initial.family_size} frontier={len(initial.frontier)} margin={initial.margin}")
    for generation in range(generations) {
        let mut inputs = []
        for parent in beam {
            if selection == "expand" {
                let parent_candidate = peek_resource(parent, DeletionCandidate) |> unwrap
                let parent_config = peek_resource(parent, DeletionConfig) |> unwrap
                for member in legal_frontier(
                    parent_candidate,
                    parent_config.minimum_density_per_mille,
                ) {
                    inputs = push(inputs, fork_with(parent, DeletionConfig {
                        rollout_steps: 1,
                        choices_per_step: 1,
                        minimum_density_per_mille: parent_config.minimum_density_per_mille,
                        objective: parent_config.objective,
                        regime: parent_config.regime,
                        forced_member: member,
                        operation: parent_config.operation,
                    }))
                }
            } else {
                for _child in range(children) {
                    inputs = push(inputs, parent)
                }
            }
        }
        let futures = simulate_many(
            inputs,
            [system::ExploreLegalDeletions],
            1,
            1979 + generation * 1009,
        )
        evaluated = evaluated + len(futures)
        let mut next = []
        for future in futures {
            next = if selection == "pareto" {
                insert_pareto(next, future, beam_width)
            } else {
                insert_beam(next, future, beam_width)
            }
        }
        beam = next
        let best = peek_resource(beam[0], DeletionCandidate) |> unwrap
        if best.family_size <= NEAR_MAX_FAMILY_SIZE and best.margin < near_margin {
            have_near = true
            near_fork = beam[0]
            near_margin = best.margin
        }
        if target_family_size > 0 and not have_target
            and best.family_size <= target_family_size {
            have_target = true
            target_fork = beam[0]
        }
        if generation == 0 or (generation + 1) % 4 == 0 {
            print(f"generation={generation + 1} depth={best.depth} family={best.family_size} margin={best.margin} min_dual={min_int(best.deletion_surpluses)} frontier={len(best.frontier)}")
        }
    }

    let terminal = peek_resource(beam[0], DeletionCandidate) |> unwrap
    let best = if have_target {
        peek_resource(target_fork, DeletionCandidate) |> unwrap
    } else if have_near {
        peek_resource(near_fork, DeletionCandidate) |> unwrap
    } else {
        terminal
    }
    assert(world_digest() == live_digest, "speculation mutated the live world")
    let finalist_family = complement_from_deleted(best.deleted)
    let closed = lattice_is_closed(finalist_family)
    let partition = partition_is_exact(best)
    let covers = min_int(best.frequencies) > 0
    let separating = best.separating and family_is_separating(finalist_family, WIDTH)
    let viable_frontier = legal_frontier(best, minimum_density)
    settle {
        SubmitDeletionEvidence(
            deletion_judge,
            best.family_size,
            best.margin,
            closed,
            partition,
            len(best.deleted),
            covers,
            separating,
        )
    }
    print(f"evaluated={evaluated} depth={best.depth} family={best.family_size} margin={best.margin}")
    print(f"deletion_surpluses={best.deletion_surpluses}")
    print(f"rank_histogram={rank_histogram(best.deleted, WIDTH)}")
    print(f"frontier={len(best.frontier)} viable_frontier={len(viable_frontier)} union_closed={closed} covers={covers} separating={separating} counterexample={best.margin < 0 and covers and separating}")
    print("terminal_world_spectrum:")
    for world in beam {
        let candidate = peek_resource(world, DeletionCandidate) |> unwrap
        print(f"  regime={candidate.regime} family={candidate.family_size} margin={candidate.margin} min_frequency={min_int(candidate.frequencies)} peak_dual={max_int(candidate.deletion_surpluses)} frontier={len(candidate.frontier)}")
    }
    print(why(deletion_judge, DeletionCertificate))
    let document: map<str, any> = {
        "kind": "rad.frankl.legal-deletion.v1",
        "width": WIDTH,
        "evaluated_worlds": evaluated,
        "deleted": best.deleted,
        "family_size": best.family_size,
        "frequencies": best.frequencies,
        "deletion_surpluses": best.deletion_surpluses,
        "rank_histogram": rank_histogram(best.deleted, WIDTH),
        "margin": best.margin,
        "frontier": best.frontier,
        "viable_frontier": viable_frontier,
        "union_closed": closed,
        "covers_universe": covers,
        "separating": separating,
        "counterexample": best.margin < 0 and covers and separating,
        "search_operation": operation,
        "terminal_depth": terminal.depth,
        "terminal_family_size": terminal.family_size,
        "terminal_margin": terminal.margin,
    }
    write_file(output_path, json_stringify(document))
    print(f"certificate={output_path}")
}

{"seed":9798705112926375337,"source":"// -- \\\\?\\H:\\Projects\\rad-lang\\dogfood\\timetravel\\main.rad --\n// Dogfood: List item #2, Phase 1 — trace recording.\r\n//\r\n// Run with:   rad dogfood/timetravel/main.rad --record dogfood/timetravel/trace.radr\r\n//\r\n// The trace logs only what crosses the determinism boundary: the RNG seed\r\n// (header), clock reads, and file io results. rand_int calls and prints are\r\n// NOT logged — they replay for free because the interpreter is deterministic.\r\n\r\ncomponent Health { hp: 100 }\r\ncomponent Gold   { amount: 0 }\r\n\r\nevent Loot { amount }\r\n\r\nsystem Decay(h: mut Health) {\r\n    h = Health { hp: h.hp - 3 }\r\n}\r\n\r\non Loot(e) {\r\n    let g = get_resource(Treasury) |> unwrap\r\n    set_resource(Treasury, Treasury { gold: g.gold + e.amount })\r\n}\r\n\r\nresource Treasury { gold: 0 }\r\n\r\nlet hero = spawn(\"hero\", Health { hp: 100 }, Gold { amount: 10 })\r\n\r\nprint(\"=== Time-Travel Phase 1: Recording ===\")\r\n\r\n// Boundary crossing #1: the clock.\r\nlet started = clock()\r\n\r\n// Boundary crossing #2: file io.\r\nlet config = read_file(\"dogfood/timetravel/loot_table.txt\")\r\nprint(f\"loot table: {config}\")\r\n\r\n// Deterministic interior: RNG, events, systems. None of this is recorded.\r\nfor _i in range(0, 3) {\r\n    emit Loot { amount: rand_int(10, 50) }\r\n    flush_events()\r\n}\r\n\r\nlet before = fork()\r\nlet after = simulate(before, [system::Decay], 5)\r\nprint(f\"decay diff: {diff(before, after)}\")\r\n\r\nlet t = get_resource(Treasury) |> unwrap\r\nlet h = get(hero, Health) |> unwrap\r\nprint(f\"treasury: {t.gold}, hero hp: {h.hp}\")\r\nprint(f\"elapsed: {clock() - started >= 0.0}\")\r\n","source_hash":"7fdfc1f5d1d30ae4c69e1b62db997b04cb9748495d6fcab86002b707acdeeb73","t":"header","version":1}

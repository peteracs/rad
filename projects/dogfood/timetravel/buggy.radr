{"seed":9730691270285867133,"source":"// -- \\\\?\\H:\\Projects\\rad-lang\\dogfood\\timetravel\\buggy.rad --\n// Dogfood: List item #2, Phase 3 — time-travel bug bisection.\r\n//\r\n// The bug: the Hit handler silently drains Gold once hp drops below 80.\r\n// Nobody noticed for four frames. Record it, then let the debugger (or an\r\n// agent) find the exact frame where Gold changed — without re-running io.\r\n//\r\n//   rad dogfood/timetravel/buggy.rad --record dogfood/timetravel/buggy.radr\r\n//   Get-Content dogfood/timetravel/bisect_session.jsonl |\r\n//       rad replay dogfood/timetravel/buggy.radr --serve\r\n\r\ncomponent Health { hp: 100 }\r\ncomponent Gold   { amount: 50 }\r\n\r\nevent Hit { amount }\r\n\r\nlet hero = spawn(\"hero\", Health { hp: 100 }, Gold { amount: 50 })\r\n\r\non Hit(e) {\r\n    let h = get(hero, Health) |> unwrap\r\n    set(hero, Health { hp: h.hp - e.amount })\r\n    if h.hp - e.amount < 80 {\r\n        set(hero, Gold { amount: 0 })   // <- the bug ships in this line\r\n    }\r\n}\r\n\r\nprint(\"=== Buggy run (the recording) ===\")\r\nfor _i in range(0, 4) {\r\n    emit Hit { amount: 10 }\r\n    flush_events()\r\n}\r\n\r\nlet h = get(hero, Health) |> unwrap\r\nlet g = get(hero, Gold) |> unwrap\r\nprint(f\"hero ends with hp={h.hp}, gold={g.amount}  (where did the gold go?)\")\r\n","source_hash":"150928965fcb5585d17019c0c3e02b1a8f1915245576b4e1077fca95fbc88360","t":"header","version":1}

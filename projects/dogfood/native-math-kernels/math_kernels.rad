// Deterministic exact-state beam for counterexample and invariant discovery.
// It returns witnesses, not an exhaustion certificate.
pub pure fn affine_frontier_profile(
    multiplier: int,
    addend: int,
    max_depth: int,
    max_input_ones: int,
    beam_per_support: int,
    objective: str,
    seed: int,
) -> map<str, any> {
    let encoded = AFFINE_FRONTIER_PROFILE_JSON(
        multiplier,
        addend,
        max_depth,
        max_input_ones,
        beam_per_support,
        objective,
        seed,
    )
    return decode_kernel_result(encoded, "affine_frontier_profile")
}


// Thin RAD adapter for the project-owned native extension.
//
// The VM provides only the generic load_extension/json bridge. Algorithms,
// limits, names, and output schemas remain owned by this dogfood project.

let MATH_KERNELS = load_extension("projects/dogfood/native-math-kernels/out/rad_dogfood_math_kernels")

// A loaded extension is intentionally `any` until its adapter declares a
// callable contract.  These symbols are deterministic, allocation-bounded
// functions over scalar/JSON values, so the project adapter narrows them to
// pure function values before any worker or causal code can call them.
let LATTICE_CLOSURE_JSON: pure fn(str) -> str = MATH_KERNELS["lattice_closure_json"]
let LATTICE_PROFILE_JSON: pure fn(str, int) -> str = MATH_KERNELS["lattice_profile_json"]
let LATTICE_FREQUENCIES_JSON: pure fn(str, int) -> str = MATH_KERNELS["lattice_frequencies_json"]
let BITMASK_ROTATION_ORBIT_JSON: pure fn(int, int) -> str = MATH_KERNELS["bitmask_rotation_orbit_json"]
let BITMASK_ROTATION_REPRESENTATIVES_JSON: pure fn(int) -> str = MATH_KERNELS["bitmask_rotation_representatives_json"]
let COLUMN_QUOTIENT_SCAN_JSON: pure fn(int, int, int, int, int) -> str = MATH_KERNELS["column_quotient_scan_json"]
let COLUMN_QUOTIENT_PROFILE_JSON: pure fn(str, int) -> str = MATH_KERNELS["column_quotient_profile_json"]
let COLUMN_QUOTIENT_PROFILES_JSON: pure fn(str, int) -> str = MATH_KERNELS["column_quotient_profiles_json"]
let COLUMN_QUOTIENT_MUTATION_LANE_JSON: pure fn(str, int, int, int, int, int, int) -> str = MATH_KERNELS["column_quotient_mutation_lane_json"]
let COLUMN_QUOTIENT_RANGE_SCAN_JSON: pure fn(int, int, int, int, int, int) -> str = MATH_KERNELS["column_quotient_range_scan_json"]
let LATTICE_IS_CLOSED_JSON: pure fn(str) -> str = MATH_KERNELS["lattice_is_closed_json"]
let LATTICE_VIOLATION_COUNT_JSON: pure fn(str, int) -> str = MATH_KERNELS["lattice_violation_count_json"]
let LATTICE_DELETABLE_JSON: pure fn(str, int) -> str = MATH_KERNELS["lattice_deletable_json"]
let LATTICE_DELETION_PROFILE_JSON: pure fn(str, int) -> str = MATH_KERNELS["lattice_deletion_profile_json"]
let LATTICE_DELETION_ROLLOUT_JSON: pure fn(str, int, int, int, int, str, int) -> str = MATH_KERNELS["lattice_deletion_rollout_json"]
let LATTICE_APPLY_DELETION_JSON: pure fn(str, int, int) -> str = MATH_KERNELS["lattice_apply_deletion_json"]
let LATTICE_EXCHANGE_ROLLOUT_JSON: pure fn(str, int, int, int, int, str, int, str, int) -> str = MATH_KERNELS["lattice_exchange_rollout_json"]
let AFFINE_RESIDUE_PROFILE_JSON: pure fn(int, int, int, int, int, int) -> str = MATH_KERNELS["affine_residue_profile_json"]
let AFFINE_RESIDUE_PROFILES_JSON: pure fn(int, int, int, int, int) -> str = MATH_KERNELS["affine_residue_profiles_json"]
let AFFINE_NATURAL_TAIL_PROFILES_JSON: pure fn(int, int, int, int, int, int) -> str = MATH_KERNELS["affine_natural_tail_profiles_json"]
let AFFINE_SPARSE_SUPPORT_PROFILE_JSON: pure fn(int, int, int, int, int) -> str = MATH_KERNELS["affine_sparse_support_profile_json"]
let AFFINE_SPARSE_SUPPORT_SUMMARY_JSON: pure fn(int, int, int, int, int) -> str = MATH_KERNELS["affine_sparse_support_summary_json"]
let AFFINE_SPARSE_SLOPE_SUPPORT_SUMMARY_JSON: pure fn(int, int, int, int) -> str = MATH_KERNELS["affine_sparse_slope_support_summary_json"]
let AFFINE_SPARSE_SLOPE_SUPPORT_LANE_JSON: pure fn(int, int, int, int, int, int) -> str = MATH_KERNELS["affine_sparse_slope_support_lane_json"]
let AFFINE_FRONTIER_PROFILE_JSON: pure fn(int, int, int, int, int, str, int) -> str = MATH_KERNELS["affine_frontier_profile_json"]
let AFFINE_CYCLE_PROFILE_JSON: pure fn(int, int, int, int) -> str = MATH_KERNELS["affine_cycle_profile_json"]
let ZETA_COVER_LANE_JSON: pure fn(str, int, int) -> str = MATH_KERNELS["zeta_cover_lane_json"]
let ZETA_PREPARE_COVER_JSON: pure fn(str) -> str = MATH_KERNELS["zeta_prepare_cover_json"]
let ZETA_PREPARED_COVER_LANE_JSON: pure fn(str, int, int) -> str = MATH_KERNELS["zeta_prepared_cover_lane_json"]
let ZETA_EQUISPACED_BLOCK_JSON: pure fn(int, int) -> str = MATH_KERNELS["zeta_equispaced_block_json"]
let ZETA_EVEN_SPACING_BOUND_JSON: pure fn(int) -> str = MATH_KERNELS["zeta_even_spacing_bound_json"]
let ZETA_INTEGER_SPACING_BOUND_JSON: pure fn(int, int) -> str = MATH_KERNELS["zeta_integer_spacing_bound_json"]
let ZETA_MT_BANDWIDTH_SCOUT_JSON: pure fn(int) -> str = MATH_KERNELS["zeta_mt_bandwidth_scout_json"]
let ZETA_FOURTH_MOMENT_TRANSFER_SCOUT_JSON: pure fn(int, int, int) -> str = MATH_KERNELS["zeta_fourth_moment_transfer_scout_json"]
let ZETA_COSINE_PAIR_SCOUT_JSON: pure fn(int) -> str = MATH_KERNELS["zeta_cosine_pair_scout_json"]
let ZETA_COSINE_DIRECT_SUM_SCOUT_JSON: pure fn(int, int) -> str = MATH_KERNELS["zeta_cosine_direct_sum_scout_json"]
let ZETA_PERTURBED_WINDOW_SCOUT_JSON: pure fn(int) -> str = MATH_KERNELS["zeta_perturbed_window_scout_json"]
let ZETA_PERTURBED_WINDOW_TWO_MODE_SCOUT_JSON: pure fn(int, int) -> str = MATH_KERNELS["zeta_perturbed_window_two_mode_scout_json"]
let ZETA_PERIODIC_DENSITY_SCOUT_JSON: pure fn(int, int) -> str = MATH_KERNELS["zeta_periodic_density_scout_json"]

pure fn decode_kernel_result(encoded: str, operation: str) -> any {
    let decoded = json_parse(encoded)
    assert(is_some(decoded), f"{operation} returned invalid JSON")
    return unwrap(decoded)
}

pub pure fn lattice_closure(members: list<int>) -> list<int> {
    let encoded = LATTICE_CLOSURE_JSON(json_stringify(members))
    return decode_kernel_result(encoded, "lattice_closure")
}

pub pure fn lattice_profile(members: list<int>, width: int) -> map<str, any> {
    let encoded = LATTICE_PROFILE_JSON(json_stringify(members), width)
    return decode_kernel_result(encoded, "lattice_profile")
}

pub pure fn lattice_frequencies(members: list<int>, width: int) -> list<int> {
    let encoded = LATTICE_FREQUENCIES_JSON(json_stringify(members), width)
    return decode_kernel_result(encoded, "lattice_frequencies")
}


        multiplier,
        addend,
        max_odd_steps,
        max_total_divisions,
    )
    return decode_kernel_result(encoded, "affine_cycle_profile")
}

// Exact integer replay of one partition of the Arb-backed zeta cover.  The
// native module caches only the parsed immutable certificate; lane outputs
// remain deterministic functions of these three arguments.
pub pure fn zeta_cover_lane(
    certificate_json: str,
    lane_index: int,
    lane_count: int,
) -> map<str, any> {
    return decode_kernel_result(
        ZETA_COVER_LANE_JSON(certificate_json, lane_index, lane_count),
        "zeta_cover_lane",
    )
}

pub pure fn zeta_prepare_cover(certificate_json: str) -> str {
    let result = decode_kernel_result(
        ZETA_PREPARE_COVER_JSON(certificate_json),
        "zeta_prepare_cover",
    )
    return result["certificate_digest"]
}

pub pure fn zeta_prepared_cover_lane(
    certificate_digest: str,
    lane_index: int,
    lane_count: int,
) -> map<str, any> {
    return decode_kernel_result(
        ZETA_PREPARED_COVER_LANE_JSON(certificate_digest, lane_index, lane_count),
        "zeta_prepared_cover_lane",
    )
}


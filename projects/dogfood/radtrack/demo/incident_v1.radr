{"a":"d6a8dfbfb0cae9dd","b":"tcp_read","f":2,"r":{"t":"str","v":"PULL alice\n"},"s":2,"t":"io"}
{"a":"2ee90aa1af48e1de","b":"tcp_write","f":2,"r":{"t":"nil"},"s":3,"t":"io"}
{"a":"130ea4a8e01c74f0","b":"tcp_close","f":2,"r":{"t":"nil"},"s":4,"t":"io"}
{"a":"a2a6f2215d177d3f","b":"tcp_accept","f":2,"r":{"t":"int","v":3},"s":5,"t":"io"}
{"a":"a83aac1e6a9b8155","b":"tcp_read","f":2,"r":{"t":"str","v":"PULL bob\n"},"s":6,"t":"io"}
{"a":"36c14745d46eec6e","b":"tcp_write","f":2,"r":{"t":"nil"},"s":7,"t":"io"}

{"seed":9774461009307243965,"source":"// -- \\\\?\\H:\\Projects\\rad-lang\\dogfood\\radtrack\\server.rad --\n// RADTRACK sync server — the shared timeline.\r\n//\r\n//   rad dogfood/radtrack/server.rad [-- <savefile>]\r\n//   rad --record incident.radr dogfood/radtrack/server.rad -- <savefile>\r\n//\r\n// Offline-first sync, the rad way: a client PULLs the world once (full fork\r\n// bytes, base remembered by digest), works disconnected for hours, then\r\n// SYNCs a fork_delta of everything it did. The server reconstructs the\r\n// client's world, three-way merges it against its own current state with\r\n// the pulled base as ancestor, and answers with the delta from the client's\r\n// pushed state to the merged world. Both sides converge byte-for-byte —\r\n// digests are compared to prove it.\r\n//\r\n// Conflicts are DATA, not prose. merge_forks reports them as `Conflict` sum\r\n// values; server policy (in rad) auto-resolves bookkeeping collisions\r\n// (`Ticket.updated` -> max wins) and ships everything else to the human as\r\n// json. The client answers RESOLVE with per-conflict picks.\r\n//\r\n// Line protocol (one request per connection, \"\\n\"-terminated):\r\n//   PULL <user>                       -> fork bytes\r\n//   SYNC <user> <base_digest>\\t<delta>\r\n//                                     -> MERGED <digest>\\t<down_delta>\r\n//                                      | CONFLICTS\\t<json RS json RS ...>\r\n//                                      | ERROR ...\r\n//   RESOLVE <user> <i:server|yours,...>\\t<delta>\r\n//                                     -> MERGED <digest>\\t<down_delta> | ERROR\r\n//   WHY <T-n>                         -> provenance, newlines as \" | \"\r\n//   LIST                              -> ticket count + open rows\r\n//   SHUTDOWN                          -> BYE (persists first)\r\n\r\nuse \"lib_track.rad\"\r\n\r\nlet PORT = 7979\r\n\r\nfn persist(save_path: str) -> nil {\r\n    write_file(save_path, save_world())\r\n}\r\n\r\n// Policy: `updated` is bookkeeping, not intent — both sides bumping it is\r\n// not a real conflict. Take the later timestamp. Everything else is a\r\n// human decision.\r\nfn auto_resolutions(conflicts: list<Conflict>) -> list<(Conflict, any)> {\r\n    let mut picks = []\r\n    for c in conflicts {\r\n        match c {\r\n            FieldConflict { ent, name, comp, field, base, ours, theirs } => {\r\n                if comp == \"Ticket\" and field == \"updated\" {\r\n                    picks << (c, max(ours, theirs))\r\n                }\r\n            }\r\n            ResourceFieldConflict { res, field, base, ours, theirs } => {\r\n                // Both sides minted ticket ids: next_id collides. The ids\r\n                // themselves were already remapped by the merge (spawn\r\n                // collision handling); the counter takes the max.\r\n                if res == \"Tracker\" and field == \"next_id\" {\r\n                    picks << (c, max(ours, theirs))\r\n                }\r\n            }\r\n            _ => {}\r\n        }\r\n    }\r\n    return picks\r\n}\r\n\r\nfn conflict_json(c: Conflict) -> str {\r\n    match c {\r\n        FieldConflict { ent, name, comp, field, base, ours, theirs } => {\r\n            return json_stringify({\r\n                \"kind\": \"field\", \"name\": name, \"comp\": comp, \"field\": field,\r\n                \"base\": base, \"ours\": ours, \"theirs\": theirs\r\n            })\r\n        }\r\n        ResourceFieldConflict { res, field, base, ours, theirs } => {\r\n            return json_stringify({\r\n                \"kind\": \"resfield\", \"res\": res, \"field\": field,\r\n                \"base\": base, \"ours\": ours, \"theirs\": theirs\r\n            })\r\n        }\r\n        _ => {\r\n            return json_stringify({ \"kind\": \"structural\", \"detail\": \"see server log\" })\r\n        }\r\n    }\r\n}\r\n\r\n// The conflicts a human still has to look at, after policy.\r\nfn human_conflicts(conflicts: list<Conflict>) -> list<Conflict> {\r\n    let mut out = []\r\n    for c in conflicts {\r\n        match c {\r\n            FieldConflict { ent, name, comp, field, base, ours, theirs } => {\r\n                if comp == \"Ticket\" and field == \"updated\" { continue }\r\n                out << c\r\n            }\r\n            ResourceFieldConflict { res, field, base, ours, theirs } => {\r\n                if res == \"Tracker\" and field == \"next_id\" { continue }\r\n                out << c\r\n            }\r\n            _ => { out << c }\r\n        }\r\n    }\r\n    return out\r\n}\r\n\r\nfn main() -> nil {\r\n    let argv = sys_args()\r\n    let mut save_path = \"dogfood/radtrack/server_world.radw\"\r\n    if len(argv) >= 1 { save_path = argv[0] }\r\n\r\n    if file_exists(save_path) {\r\n        let n = load_world(read_file(save_path))\r\n        print(f\"radtrack server: restored {n} entities from {save_path}\")\r\n    } else {\r\n        // A fresh tracker is born with the backlog every project starts with.\r\n        let t0 = now_unix_s()\r\n        new_ticket(\"Set up CI\", \"founder\", t0)\r\n        new_ticket(\"Write onboarding doc\", \"founder\", t0)\r\n        print(f\"radtrack server: fresh world, seeded {len(ticket_ids(\\\"all\\\"))} tickets\")\r\n    }\r\n\r\n    let listener = tcp_listen(\"127.0.0.1\", PORT)\r\n    print(f\"listening on 127.0.0.1:{PORT}\")\r\n\r\n    // Base forks clients might still sync against, by digest. A real server\r\n    // would expire these; we cap the map and a stale client re-pulls.\r\n    let mut bases = {}\r\n    // Pending RESOLVE state per user: the conflicts and forks of the SYNC\r\n    // that just refused, so picks can be applied to the same merge.\r\n    let mut pending = {}\r\n\r\n    let mut running = true\r\n    while running {\r\n        let conn = tcp_accept(listener)\r\n        let msg = read_msg(conn)\r\n        let parts = split(msg, \" \")\r\n        let cmd = parts[0]\r\n\r\n        if cmd == \"PULL\" {\r\n            if len(keys(bases)) > 32 { bases = {} }\r\n            let base = fork()\r\n            let bytes = fork_to_bytes(base)\r\n            bases[digest_of(base)] = base\r\n            send_msg(conn, bytes)\r\n            let user = parts[1]\r\n            print(f\"PULL {user}: served {digest_of(base)} ({len(bytes)} B)\")\r\n        }\r\n        if cmd == \"SYNC\" or cmd == \"RESOLVE\" {\r\n            let user = parts[1]\r\n            let rest = join(slice(parts, 2, len(parts)), \" \")\r\n            let dparts = split(rest, \"\\t\")\r\n            let mut reply = \"ERROR malformed request\"\r\n\r\n            let mut base = fork()      // placeholder, replaced below\r\n            let mut have_base = false\r\n            let mut picks_spec = \"\"\r\n            if cmd == \"SYNC\" and len(dparts) == 2 and contains(keys(bases), dparts[0]) {\r\n                base = bases[dparts[0]]\r\n                have_base = true\r\n            }\r\n            if cmd == \"RESOLVE\" and len(dparts) == 2 and contains(keys(pending), user) {\r\n                base = pending[user]\r\n                have_base = true\r\n                picks_spec = dparts[0]\r\n            }\r\n\r\n            if !have_base {\r\n                reply = \"ERROR unknown base (pull again)\"\r\n            } else {\r\n                match fork_apply(base, dparts[1]) {\r\n                    Ok(theirs) => {\r\n                        let ours = fork()\r\n                        let mut auto = []\r\n                        let mut merged_ok = false\r\n                        let mut merged = ours\r\n                        match merge_forks(base, ours, theirs) {\r\n                            Ok(m) => {\r\n                                merged = m\r\n                                merged_ok = true\r\n                            }\r\n                            Err(conflicts) => {\r\n                                auto = auto_resolutions(conflicts)\r\n                                let humans = human_conflicts(conflicts)\r\n                                if cmd == \"RESOLVE\" {\r\n                                    // i:server keeps ours, i:yours keeps theirs\r\n                                    let mut chosen = auto\r\n                                    for spec in split(picks_spec, \",\") {\r\n                                        let kv = split(spec, \":\")\r\n                                        let idx = int(kv[0])\r\n                                        let c = humans[idx]\r\n                                        match c {\r\n                                            FieldConflict { ent, name, comp, field, base, ours, theirs } => {\r\n                                                let mut v = theirs\r\n                                                if kv[1] == \"server\" { v = ours }\r\n                                                chosen << (c, v)\r\n                                            }\r\n                                            _ => {}\r\n                                        }\r\n                                    }\r\n                                    match merge_forks_with(base, ours, theirs, chosen) {\r\n                                        Ok(m) => {\r\n                                            merged = m\r\n                                            merged_ok = true\r\n                                        }\r\n                                        Err(remaining) => {\r\n                                            reply = f\"ERROR {len(remaining)} conflicts survived resolution\"\r\n                                        }\r\n                                    }\r\n                                } else if len(humans) == 0 {\r\n                                    // policy resolved everything mechanical\r\n                                    match merge_forks_with(base, ours, theirs, auto) {\r\n                                        Ok(m) => {\r\n                                            merged = m\r\n                                            merged_ok = true\r\n                                        }\r\n                                        Err(remaining) => {\r\n                                            reply = f\"ERROR {len(remaining)} conflicts survived policy\"\r\n                                        }\r\n                                    }\r\n                                } else {\r\n                                    let mut blobs = []\r\n                                    for c in humans { blobs << conflict_json(c) }\r\n                                    pending[user] = base\r\n                                    reply = \"CONFLICTS\\t\" + join(blobs, chr(30))\r\n                                    print(f\"SYNC {user}: {len(humans)} conflicts for the human, {len(auto)} auto-resolved pending\")\r\n                                }\r\n                            }\r\n                        }\r\n                        if merged_ok {\r\n                            commit(merged)\r\n                            flush_events()\r\n                            persist(save_path)\r\n                            let new_base = fork()\r\n                            let nd = digest_of(new_base)\r\n                            bases[nd] = new_base\r\n                            pending = remove_key(pending, user)\r\n                            let down = fork_delta(theirs, new_base)\r\n                            reply = f\"MERGED {nd}\\t\" + down\r\n                            let upb = len(dparts[1])\r\n                            print(f\"{cmd} {user}: merged -> {nd} ({upb} B up, {len(down)} B down)\")\r\n                        }\r\n                    }\r\n                    Err(m) => { reply = f\"ERROR delta: {m}\" }\r\n                }\r\n            }\r\n            send_msg(conn, reply)\r\n        }\r\n        if cmd == \"WHY\" {\r\n            let ent = get_entity(parts[1])\r\n            if ent == nil {\r\n                send_msg(conn, f\"no ticket {parts[1]}\")\r\n            } else {\r\n                send_msg(conn, replace(why(ent, Ticket), \"\\n\", \" | \"))\r\n            }\r\n        }\r\n        if cmd == \"DIGEST\" {\r\n            send_msg(conn, world_digest())\r\n        }\r\n        if cmd == \"LIST\" {\r\n            let ids = ticket_ids(\"all\")\r\n            let mut rows = []\r\n            for id in ids { rows << fmt_row(id, now_unix_s()) }\r\n            send_msg(conn, f\"{len(ids)} tickets | \" + join(rows, \" | \"))\r\n        }\r\n        if cmd == \"SHUTDOWN\" {\r\n            persist(save_path)\r\n            send_msg(conn, \"BYE\")\r\n            running = false\r\n        }\r\n        tcp_close(conn)\r\n    }\r\n    tcp_close(listener)\r\n    print(\"server down, world persisted\")\r\n}\r\n\n// -- \\\\?\\H:\\Projects\\rad-lang\\dogfood\\radtrack\\lib_track.rad --\n// lib_track — the shared brain of RADTRACK, an offline-first issue tracker.\r\n//\r\n// Imported by track.rad (the offline CLI client), server.rad (the sync\r\n// server), and the migration/demo harnesses. Where RADTACTICS stressed\r\n// frames, speculation, and adversaries, RADTRACK stresses the other half of\r\n// the language: long-lived persistent state, concurrent *legitimate* edits,\r\n// three-way merge with human-visible conflicts, schema migration against\r\n// organically grown saves, and time measured in days.\r\n//\r\n// Every mutation flows through an event carrying WHO and WHEN — so\r\n// why(ticket, Ticket) answers \"who closed my ticket?\" with a name, even for\r\n// edits that arrived over the wire from another machine.\r\n\r\n// Ticket fields that merge field-by-field live in Ticket. The body is its\r\n// own component so a title edit never drags kilobytes of description into a\r\n// delta (ent_patch keeps them apart), and Tags is separate for the same\r\n// reason.\r\npub component Ticket {\r\n    title: str = \"\",\r\n    status: str = \"open\",       // open | closed\r\n    priority: int = 3,          // P1 (urgent) .. P4 (someday)\r\n    assignee: str = \"\",\r\n    created: int = 0,           // unix seconds\r\n    updated: int = 0\r\n}\r\npub component Body { text: str = \"\" }\r\npub component Tags { csv: str = \"\" }\r\n\r\npub resource Tracker { next_id: int = 1, site: str = \"radtrack\" }\r\n\r\npub event Opened   { ticket: entity, title: str, by: str, at: int }\r\npub event Changed  { ticket: entity, field: str, to: str, by: str, at: int }\r\npub event Closed   { ticket: entity, by: str, at: int }\r\npub event Reopened { ticket: entity, by: str, at: int }\r\n\r\n// ---------------------------------------------------------------------------\r\n// The evented mutation path. Handlers are the ONLY writers of ticket state\r\n// after spawn — provenance therefore names the event (and the event names\r\n// the human) for every field a ticket ever had.\r\n// ---------------------------------------------------------------------------\r\n\r\non Changed(e) {\r\n    if e.field == \"title\"    { update(e.ticket, Ticket) { title = e.to } }\r\n    if e.field == \"assignee\" { update(e.ticket, Ticket) { assignee = e.to } }\r\n    if e.field == \"priority\" {\r\n        match try_int(e.to) {\r\n            Some(p) => {\r\n                if p >= 1 and p <= 4 { update(e.ticket, Ticket) { priority = p } }\r\n            }\r\n            None => {}\r\n        }\r\n    }\r\n    if e.field == \"body\" { set(e.ticket, Body { text: e.to }) }\r\n    if e.field == \"tags\" { set(e.ticket, Tags { csv: e.to }) }\r\n    update(e.ticket, Ticket) { updated = e.at }\r\n}\r\n\r\non Closed(e) {\r\n    update(e.ticket, Ticket) { status = \"closed\", updated = e.at }\r\n}\r\n\r\non Reopened(e) {\r\n    update(e.ticket, Ticket) { status = \"open\", updated = e.at }\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// Commands (called by client and server alike)\r\n// ---------------------------------------------------------------------------\r\n\r\npub fn new_ticket(title: str, by: str, at: int) -> entity {\r\n    let tr = get_resource(Tracker) |> unwrap\r\n    let id = f\"T-{tr.next_id}\"\r\n    set_resource(Tracker, Tracker { next_id: tr.next_id + 1, site: tr.site })\r\n    let t = spawn(id,\r\n        Ticket { title: title, status: \"open\", priority: 3, assignee: \"\", created: at, updated: at },\r\n        Body { text: \"\" },\r\n        Tags { csv: \"\" })\r\n    emit Opened { ticket: t, title: title, by: by, at: at }\r\n    flush_events()\r\n    return t\r\n}\r\n\r\npub fn set_field(t: entity, field: str, to: str, by: str, at: int) -> nil {\r\n    emit Changed { ticket: t, field: field, to: to, by: by, at: at }\r\n    flush_events()\r\n}\r\n\r\npub fn close_ticket(t: entity, by: str, at: int) -> nil {\r\n    emit Closed { ticket: t, by: by, at: at }\r\n    flush_events()\r\n}\r\n\r\npub fn reopen_ticket(t: entity, by: str, at: int) -> nil {\r\n    emit Reopened { ticket: t, by: by, at: at }\r\n    flush_events()\r\n}\r\n\r\npub fn add_tag(t: entity, tag: str, by: str, at: int) -> nil {\r\n    let cur = (get(t, Tags) |> unwrap).csv\r\n    let mut tags = []\r\n    if cur != \"\" { tags = split(cur, \",\") }\r\n    if contains(tags, tag) { return }\r\n    tags << tag\r\n    set_field(t, \"tags\", join(sort(tags), \",\"), by, at)\r\n}\r\n\r\npub fn remove_tag(t: entity, tag: str, by: str, at: int) -> nil {\r\n    let cur = (get(t, Tags) |> unwrap).csv\r\n    if cur == \"\" { return }\r\n    let tags = filter(split(cur, \",\"), fn(x) { return x != tag })\r\n    set_field(t, \"tags\", join(tags, \",\"), by, at)\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// Queries. entities(Ticket) is a full scan — RADTRACK's first finding is\r\n// that an ECS-grammar language has no indexed or sorted query primitive;\r\n// every list below pays O(world) and sorts by hand.\r\n// ---------------------------------------------------------------------------\r\n\r\n// NB: there is no typed \"find a ticket\" wrapper here. `get_entity` returns\r\n// an untyped value compared against nil at call sites — a `-> entity`\r\n// return type cannot be nil-checked (GAP: no Option<entity>).\r\n\r\n// status filter: \"open\" | \"closed\" | \"all\"; returns ids sorted by priority\r\n// then ticket number.\r\npub fn ticket_ids(status: str) -> list<str> {\r\n    let mut rows = []\r\n    for t in entities(Ticket) {\r\n        let tk = get(t, Ticket) |> unwrap\r\n        if status != \"all\" and tk.status != status { continue }\r\n        let n = name_of(t)\r\n        // sortable key: priority * 100000 + numeric id\r\n        match try_int(slice(n, 2, len(n))) {\r\n            Some(num) => { rows << (tk.priority * 100000 + num, n) }\r\n            None => { rows << (999999999, n) }\r\n        }\r\n    }\r\n    let mut out = []\r\n    for r in sort_by(rows, fn(r) { return r[0] }) { out << r[1] }\r\n    return out\r\n}\r\n\r\npub fn search(needle: str) -> list<str> {\r\n    let q = to_lower(needle)\r\n    let mut out = []\r\n    for t in entities(Ticket) {\r\n        let tk = get(t, Ticket) |> unwrap\r\n        let body = (get(t, Body) |> unwrap).text\r\n        let tags = (get(t, Tags) |> unwrap).csv\r\n        let hay = to_lower(tk.title + \" \" + body + \" \" + tags + \" \" + tk.assignee)\r\n        if contains(hay, q) { out << name_of(t) }\r\n    }\r\n    return sort(out)\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// Rendering. No date type, no strftime: ages are humanized by hand.\r\n// ---------------------------------------------------------------------------\r\n\r\npub fn fmt_age(now: int, ts: int) -> str {\r\n    let d = now - ts\r\n    if d < 60 { return \"just now\" }\r\n    if d < 3600 { return f\"{d / 60}m ago\" }\r\n    if d < 86400 { return f\"{d / 3600}h ago\" }\r\n    return f\"{d / 86400}d ago\"\r\n}\r\n\r\npub fn fmt_row(id: str, now: int) -> str {\r\n    let t = get_entity(id)\r\n    let tk = get(t, Ticket) |> unwrap\r\n    let mut mark = \" \"\r\n    if tk.status == \"closed\" { mark = \"x\" }\r\n    let mut who = tk.assignee\r\n    if who == \"\" { who = \"-\" }\r\n    let tags = (get(t, Tags) |> unwrap).csv\r\n    let mut tagstr = \"\"\r\n    if tags != \"\" { tagstr = f\" [{tags}]\" }\r\n    return f\"[{mark}] {id}  P{tk.priority}  {tk.title}{tagstr}  ({who}, {fmt_age(now, tk.updated)})\"\r\n}\r\n\r\npub fn fmt_ticket(id: str, now: int) -> str {\r\n    let t = get_entity(id)\r\n    let tk = get(t, Ticket) |> unwrap\r\n    let body = (get(t, Body) |> unwrap).text\r\n    let tags = (get(t, Tags) |> unwrap).csv\r\n    let mut who = tk.assignee\r\n    if who == \"\" { who = \"(unassigned)\" }\r\n    let mut out = f\"{id}: {tk.title}\\n\"\r\n    out = out + f\"  status   {tk.status}\\n\"\r\n    out = out + f\"  priority P{tk.priority}\\n\"\r\n    out = out + f\"  assignee {who}\\n\"\r\n    out = out + f\"  tags     {tags}\\n\"\r\n    out = out + f\"  created  {fmt_age(now, tk.created)}, updated {fmt_age(now, tk.updated)}\\n\"\r\n    if body != \"\" {\r\n        let ind = replace(body, \"\\n\", \"\\n  \")\r\n        out = out + f\"  ---\\n  {ind}\\n\"\r\n    }\r\n    return out\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// Wire helpers shared by client and server\r\n// ---------------------------------------------------------------------------\r\n\r\npub fn digest_of(f: world_fork) -> str {\r\n    return split(fork_to_bytes(f), \" \")[1]\r\n}\r\n\r\npub fn read_msg(conn: int) -> str {\r\n    let mut buf = \"\"\r\n    while true {\r\n        let chunk = tcp_read(conn, 262144)\r\n        if len(chunk) == 0 { break }\r\n        buf = buf + chunk\r\n        if ends_with(buf, \"\\n\") { break }\r\n    }\r\n    return trim(buf)\r\n}\r\n\r\npub fn send_msg(conn: int, line: str) -> nil {\r\n    tcp_write(conn, line + \"\\n\")\r\n}\r\n\r\n// NB: conflict serialization lives in server.rad, not here — the built-in\r\n// `Conflict` sum type may not appear in a pub fn signature (GAP: checker\r\n// flags it as a private-type leak).\r\n","source_hash":"86e1256bfb53220e5b27cece7f47b612426e23244c71eb62c869d02c28bd2b3b","t":"header","version":1}
{"a":"af1349b9f5f9a1a6","b":"sys_args","f":0,"r":{"t":"list","v":[{"t":"str","v":"dogfood\\radtrack\\demo\\server_world.radw"}]},"s":0,"t":"io"}

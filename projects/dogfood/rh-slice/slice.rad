// Collapse an RH pillar's editable slice into one Solution.lean over the frozen interface.
//
//   rad slice.rad -- <statement .lean> <entry full name> <output .lean> <source .lean>...
//
// The statement file is the frozen challenge file (its theorem ends in `sorry`). Each source is
// one editable module of the real proof, named `<Module.Name>.lean`. The sources are ordered by
// their imports, and every top-level declaration is parsed with the docstrings, attributes and
// `open ... in` lines in front of it. A declaration is kept only when it is reachable from the
// entry theorem through the names its text mentions, and a repeated full name keeps its first
// definition. Each source keeps its own namespaces and `open` lines inside a `section`, and the
// whole slice sits under `<Core>.Slice`, where Lean still resolves the sources' relative names.
// The frozen theorem is then closed by the entry.

use "tokens.rad"

struct Item { kind: str, full: str, short: str, text: str }

struct Source { module: str, imports: list<str>, items: list<Item> }

fn is_ident_char(ch: str) -> bool {
    return (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_" or ch == "." or ch == "'"
}

// Every identifier in `text` with each of its dotted suffixes (`A.B.c` gives `A.B.c`, `B.c`, `c`).
fn names_in(text: str) -> list<str> {
    let mut out = []
    let mut cur = ""
    for ch in chars(text + " ") {
        if is_ident_char(ch) {
            cur = cur + ch
        } else {
            if len(cur) > 0 {
                let parts = split(cur, ".")
                for k in range(len(parts)) { out = push(out, join(slice(parts, k, len(parts)), ".")) }
            }
            cur = ""
        }
    }
    return out
}

// The declared name after the keyword, skipping modifiers such as `private` or `@[simp]`.
fn decl_name(line: str) -> str {
    let kinds = ["theorem", "lemma", "def", "abbrev", "instance", "structure", "class", "inductive"]
    let words = split(trim(line), " ")
    for k in range(len(words) - 1) {
        if contains(kinds, words[k]) {
            return split(split(split(words[k + 1], ":")[0], "(")[0], "{")[0]
        }
    }
    return ""
}

fn is_top(line: str) -> bool {
    return len(line) > 0 and slice(line, 0, 1) != " "
}

fn is_dropped(line: str) -> bool {
    return line == "module" or starts_with(line, "import ") or starts_with(line, "public import ") or ends_with(line, "section") and not starts_with(line, "end")
}

fn is_prefix(line: str) -> bool {
    return (starts_with(line, "@[") and decl_name(line) == "") or (starts_with(line, "open ") and ends_with(trim(line), " in")) or starts_with(line, "/-") or starts_with(line, "--")
}

fn module_of(path: str) -> str {
    let parts = split(replace(path, "\\", "/"), "/")
    let base = parts[len(parts) - 1]
    return slice(base, 0, len(base) - 5)
}

fn parse(path: str) -> Source {
    let lines = split(replace(read_file(path), "\r", ""), "\n")
    let mut stack = []
    let mut imports = []
    let mut items = []
    let mut prefix = ""
    let mut k = 0
    while k < len(lines) {
        let line = lines[k]
        let mut j = k + 1
        if starts_with(line, "/-") {
            while not contains_str(lines[j - 1], "-/") { j = j + 1 }
        } else {
            while j < len(lines) and not is_top(lines[j]) { j = j + 1 }
        }
        let text = trim(join(slice(lines, k, j), "\n"))
        if not is_top(line) {
            k = j
        } else if starts_with(line, "import ") or starts_with(line, "public import ") {
            imports = push(imports, trim(split(line, "import ")[1]))
        } else if is_dropped(line) {
        } else if is_prefix(line) {
            prefix = prefix + text + "\n"
        } else if decl_name(line) != "" {
            let short = decl_name(line)
            let mut full = short
            if len(stack) > 0 { full = join(stack, ".") + "." + short }
            items = push(items, Item { kind: "decl", full: full, short: short, text: prefix + text })
            prefix = ""
        } else {
            if starts_with(line, "namespace ") { stack = push(stack, trim(slice(line, 10, len(line)))) }
            if starts_with(line, "end ") and len(stack) > 0 { stack = slice(stack, 0, len(stack) - 1) }
            items = push(items, Item { kind: "keep", full: "", short: "", text: prefix + text })
            prefix = ""
        }
        k = j
    }
    return Source { module: module_of(path), imports: imports, items: items }
}

fn contains_str(text: str, part: str) -> bool {
    return len(split(text, part)) > 1
}

// Sources in import order: a module comes after every source module it imports.
fn ordered(sources: list<Source>) -> list<Source> {
    let mut out = []
    let mut placed = []
    while len(out) < len(sources) {
        for src in sources {
            if not contains(placed, src.module) {
                let mut ready = true
                for m in src.imports {
                    if not contains(placed, m) and any_module(sources, m) { ready = false }
                }
                if ready {
                    out = push(out, src)
                    placed = push(placed, src.module)
                }
            }
        }
    }
    return out
}

fn any_module(sources: list<Source>, m: str) -> bool {
    for src in sources {
        if src.module == m { return true }
    }
    return false
}

// Drop `namespace X` ... `end X` pairs left with nothing in them.
fn prune_empty(lines: list<str>) -> list<str> {
    let mut out = []
    for line in lines {
        let n = len(out)
        let mut opener = ""
        if n > 0 { opener = out[n - 1] }
        let closes_ns = starts_with(line, "end ") and opener == "namespace " + slice(line, 4, len(line))
        if closes_ns {
            out = slice(out, 0, n - 1)
        } else {
            out = push(out, line)
        }
    }
    return out
}

fn main() -> nil {
    let args = sys_args()
    let statement = read_file(args[0])
    let entry_name = args[1]
    let mut raw = []
    for k in range(3, len(args)) { raw = push(raw, parse(args[k])) }
    let sources = ordered(raw)
    let mut decls = []
    for src in sources {
        for item in src.items {
            if item.kind == "decl" { decls = push(decls, item) }
        }
    }
    // Index declarations by short and full name; a repeated full name keeps its first definition.
    let mut by_name = {}
    let mut firsts = []
    for j in range(len(decls)) {
        let d = decls[j]
        if not contains(firsts, d.full) {
            firsts = push(firsts, d.full)
            by_name = merge(by_name, { d.short: push(get_or(by_name, d.short, []), j) })
            if d.full != d.short { by_name = merge(by_name, { d.full: push(get_or(by_name, d.full, []), j) }) }
        }
    }
    let mut entry = -1
    for j in range(len(decls)) {
        if decls[j].full == entry_name and entry < 0 { entry = j }
    }
    if entry < 0 {
        print(f"entry {entry_name} not found among {len(decls)} declarations")
        return
    }
    let mut seen = filled(len(decls), false)
    seen = set_at(seen, entry, true)
    let mut queue = [entry]
    let mut head = 0
    while head < len(queue) {
        let d = decls[queue[head]]
        head = head + 1
        for name in names_in(d.text) {
            for j in get_or(by_name, name, []) {
                if not seen[j] {
                    seen = set_at(seen, j, true)
                    queue = push(queue, j)
                }
            }
        }
    }
    let core = split(split(statement, "namespace ")[1], "\n")[0]
    let head_text = trim(split(statement, f"namespace {core}")[0])
    let theorem = split(split(statement, f"namespace {core}")[1], f"end {core}")[0]
    let close = trim(split(theorem, ":= by")[0])
    let mut extra = []
    for src in sources {
        for m in src.imports {
            let external = not any_module(sources, m) and not (starts_with(m, "Mathlib") and contains_str(head_text, "import Mathlib\n"))
            if external and not contains(extra, m) and not contains_str(head_text, "import " + m + "\n") { extra = push(extra, m) }
        }
    }
    let mut lines = [f"namespace {core}.Slice"]
    let mut index = 0
    let mut kept = 0
    for src in sources {
        let mut chunk = ["section"]
        let mut used = 0
        for item in src.items {
            if item.kind == "keep" {
                chunk = push(chunk, item.text)
            } else {
                if seen[index] {
                    chunk = push(chunk, item.text)
                    used = used + 1
                }
                index = index + 1
            }
        }
        // A source none of whose declarations is reached contributes nothing, not even its opens.
        if used > 0 { lines = extend(lines, push(chunk, "end")) }
        kept = kept + used
    }
    lines = prune_empty(push(lines, f"end {core}.Slice"))
    let mut out = [head_text]
    for m in extra { out = push(out, "import " + m) }
    out = extend(out, ["", "-- found by RAD: github.com/peteracs/rad-lang", "-- RAD kept the declarations reachable from the entry theorem; the rest of the slice is unused.", "", "noncomputable section", ""])
    out = extend(out, lines)
    out = extend(out, ["", f"namespace {core}", "", f"{close} :=", f"  @Slice.{entry_name}", "", f"end {core}", "", "end"])
    let text = join(push(out, ""), "\n")
    write_file(args[2], text)
    print(f"{len(sources)} sources, {len(decls)} declarations parsed, {kept} kept, {count_tokens(text)} tokens")
    print(f"wrote {args[2]}")
}

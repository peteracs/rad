// Collapse an RH pillar's editable slice into one Solution.lean over the frozen interface.
//
//   rad slice.rad -- <statement .lean> <entry full name> <output .lean> <source .lean or dir>...
//
// The statement file is the frozen challenge file (its theorem ends in `sorry`). Each source is
// one editable module of the real proof, named `<Module.Name>.lean`. Sources are ordered by their
// imports and parsed with Lean's scoping: namespaces, sections, `open` and `variable` lines, and
// the docstrings, attributes and `open ... in` lines in front of each declaration.
//
// A declaration is kept when it is reachable from the entry theorem. A name in a declaration (or
// in the `variable` lines in force for it) resolves the way Lean resolves it: as written, under
// the current namespace and every enclosing one, or under an open namespace; `Foo.mk` falls back
// to `Foo`; dot-notation on a local (`G.amp`, `.foo`) may mean any declaration of that last name.
// Instances, declarations with attributes that act without being named (`simp`, `ext`, ...), and
// the names in kept `attribute`, notation and anonymous-instance lines are roots as well.
//
// Every source keeps its own namespaces in its own `section`; a source with nothing kept is
// dropped, and a namespace that an emitted `open` needs but only a dropped source declared is
// re-registered with an empty `namespace ... end`. The frozen theorem is closed by the entry.

use "tokens.rad"

struct Scope { ns: str, opens: list<str>, vars: list<str>, closer: str }

struct Item { kind: str, full: str, short: str, text: str, ns: str, opens: list<str>, vars: str, root: bool }

struct Source { module: str, imports: list<str>, items: list<Item> }

struct Decls { decls: list<Item>, keeps: list<Item>, fulls: list<str>, shorts: list<str> }

// The identifiers in `text`, each once, dotted names whole (`A.B.c`, `.foo`).
fn names_in(text: str) -> list<str> {
    let mut spaced = text
    for sep in separators() { spaced = replace(spaced, sep, " ") }
    return distinct(filter(split(spaced, " "), fn(w: str) -> bool { return len(w) > 0 }))
}

// Characters that end an identifier: ASCII punctuation, whitespace and Lean's symbol letters.
fn separators() -> list<str> {
    return extend(["\n", "\t", "(", ")", "[", "]", "{", "}", ",", ":", ";", "=", "+", "-", "*", "/", "<", ">", "|", "&", "!", "?", "^", "%", "#", "@", "$", "~", "`", "\"", "\\"], symbols())
}

fn symbols() -> list<str> {
    return ["→", "↔", "≤", "≥", "≠", "⊢", "⟨", "⟩", "∀", "∃", "λ", "↦", "∧", "∨", "¬", "∈", "∉", "⊆", "∪", "∩", "∑", "∏", "∫", "‖", "⁻", "¹", "•", "∘", "↑", "⇑", "≃", "×", "⊓", "⊔", "≫", "⋯", "·",
        "⌈", "⌉", "⌊", "⌋", "‹", "›", "«", "»", "⦃", "⦄", "⟦", "⟧", "⟪", "⟫", "∣", "≡", "⊤", "⊥", "√", "∞", "⊗", "⊕", "≅", "≪", "∖", "⁅", "⁆", "⊂", "⊃", "⊇", "∆", "≈", "⟶", "⥤", "⋆", "∗", "⊞", "⊠", "†", "ᵀ", "ᴴ", "⬝", "∠", "⨆", "⨅", "⋃", "⋂", "∮", "∂", "∇"]
}

// The declared name after the keyword, skipping modifiers such as `private` or `@[simp]`.
fn decl_name(line: str) -> str {
    let kinds = ["theorem", "lemma", "def", "abbrev", "instance", "structure", "class", "inductive", "alias"]
    let words = split(trim(line), " ")
    for k in range(len(words) - 1) {
        if contains(kinds, words[k]) {
            return split(split(split(words[k + 1], ":")[0], "(")[0], "{")[0]
        }
    }
    return ""
}

// Instances and attributes that act without being named make a declaration a root.
fn is_root(head: str) -> bool {
    if contains_str(head, "instance ") { return true }
    if not contains_str(head, "@[") { return false }
    for attr in ["simp", "ext", "instance", "grind", "cast", "fun_prop", "aesop", "gcongr", "positivity", "continuity", "measurability", "bound", "mono", "trans", "symm", "refl", "congr", "norm_num", "coe"] {
        if contains_str(head, attr) { return true }
    }
    return false
}

// A line starting at column 0 begins a command, except a proof's `by` written flush left.
fn is_top(line: str) -> bool {
    return len(line) > 0 and slice(line, 0, 1) != " " and line != "by" and not starts_with(line, "by ")
}

fn is_dropped(line: str) -> bool {
    return line == "module" or line == "example" or starts_with(line, "example ") or starts_with(line, "example:")
}

// Module-system section markers as plain sections: `@[expose] public section` is `section` and
// `public noncomputable section` is `noncomputable section`. A source may close them with its own
// `end` or leave them open to the end of the file, so they are kept as scopes, never dropped.
fn plain_section(line: str) -> str {
    let mut out = line
    if starts_with(out, "@[expose] ") { out = slice(out, 10, len(out)) }
    if starts_with(out, "public ") and is_section(slice(out, 7, len(out))) { out = slice(out, 7, len(out)) }
    return out
}

fn is_section(line: str) -> bool {
    return line == "section" or starts_with(line, "section ") or line == "noncomputable section" or starts_with(line, "noncomputable section ")
}

// The `end` that closes a scope opened by `line`.
fn closer_of(line: str) -> str {
    let words = split(trim(line), " ")
    if words[0] == "namespace" { return "end " + words[1] }
    let name = words[len(words) - 1]
    if name == "section" { return "end" }
    return "end " + name
}

// Lines that belong to the next declaration: docstrings, comments, attributes, and command
// modifiers such as `set_option maxHeartbeats 800000 in` (kept or dropped with it).
fn is_prefix(line: str) -> bool {
    return (starts_with(line, "@[") and decl_name(line) == "") or is_modifier(line) or starts_with(line, "/-") or starts_with(line, "--")
}

fn is_modifier(line: str) -> bool {
    if not ends_with(trim(line), " in") { return false }
    for kw in ["open ", "set_option ", "variable ", "variable(", "include ", "omit ", "attribute "] {
        if starts_with(line, kw) { return true }
    }
    return false
}

// A kept line that refers to declarations without declaring any: its names are roots.
fn is_substantive(line: str) -> bool {
    for kw in ["attribute ", "instance", "notation", "infix", "prefix", "postfix", "macro", "syntax", "elab", "scoped ", "local ", "export "] {
        if starts_with(line, kw) { return true }
    }
    return false
}

// Namespaces named by `open A B (x) hiding ...` or `open scoped A ... in`.
// `line` may be a whole block: an `open` can continue on indented lines.
fn open_names(line: str) -> list<str> {
    let mut out = []
    let words = split(trim(replace(line, "\n", " ")), " ")
    for w in slice(words, 1, len(words)) {
        if w == "in" or w == "hiding" or w == "renaming" or starts_with(w, "(") { return out }
        if w != "scoped" and len(w) > 0 { out = push(out, w) }
    }
    return out
}

// `A.B.f` gives `A.B`; a name with no dot gives "".
fn parent_of(name: str) -> str {
    let parts = split(name, ".")
    return join(slice(parts, 0, len(parts) - 1), ".")
}

fn last_part(name: str) -> str {
    let parts = split(name, ".")
    return parts[len(parts) - 1]
}

fn module_of(path: str) -> str {
    let parts = split(replace(path, "\\", "/"), "/")
    let base = parts[len(parts) - 1]
    return slice(base, 0, len(base) - 5)
}

fn current_ns(scopes: list<Scope>) -> str {
    let mut parts = []
    for s in scopes {
        if len(s.ns) > 0 { parts = push(parts, s.ns) }
    }
    return join(parts, ".")
}

fn parse(path: str) -> Source {
    let lines = split(replace(read_file(path), "\r", ""), "\n")
    let mut scopes = [Scope { ns: "", opens: [], vars: [], closer: "" }]
    let mut imports = []
    let mut items = []
    let mut prefix = ""
    let mut prefix_opens = []
    let mut k = 0
    while k < len(lines) {
        let line = plain_section(lines[k])
        let mut j = k + 1
        if starts_with(line, "/-") {
            while j <= len(lines) and not contains_str(lines[j - 1], "-/") { j = j + 1 }
            j = min(j, len(lines))
        } else {
            while j < len(lines) and not is_top(lines[j]) { j = j + 1 }
        }
        let mut text = trim(join(slice(lines, k, j), "\n"))
        if is_section(line) { text = line }
        let top = len(scopes) - 1
        if not is_top(line) {
        } else if starts_with(line, "import ") or starts_with(line, "public import ") {
            imports = push(imports, trim(split(line, "import ")[1]))
        } else if is_dropped(line) {
            prefix = ""
            prefix_opens = []
        } else if is_prefix(line) or is_modifier(text) {
            // A modifier can span lines (`omit [..]\n  [..] in`): its ` in` ends the whole block.
            prefix = prefix + text + "\n"
            if starts_with(line, "open ") { prefix_opens = extend(prefix_opens, open_names(text)) }
        } else if decl_name(line) != "" {
            let mut written = decl_name(line)
            // An anonymous `instance [..] : C X` or `instance (priority := n) : ...` has no name to
            // index; a unique one keeps it apart from the others (nothing refers to it by name).
            for b in ["[", "(", "{", "⦃"] {
                if starts_with(written, b) { written = "anon_" + replace(module_of(path), ".", "_") + "_" + str(len(items)) }
            }
            let ns = current_ns(scopes)
            let mut full = written
            if len(ns) > 0 { full = ns + "." + written }
            let short = last_part(written)
            let mut opens = prefix_opens
            let mut vars = []
            for s in scopes {
                opens = extend(opens, s.opens)
                vars = extend(vars, s.vars)
            }
            items = push(items, Item { kind: "decl", full: full, short: short, text: prefix + text, ns: ns, opens: distinct(opens), vars: join(vars, "\n"), root: is_root(prefix + line) })
            prefix = ""
            prefix_opens = []
        } else {
            if starts_with(line, "namespace ") {
                scopes = push(scopes, Scope { ns: trim(slice(line, 10, len(line))), opens: [], vars: [], closer: closer_of(line) })
            } else if is_section(line) {
                scopes = push(scopes, Scope { ns: "", opens: [], vars: [], closer: closer_of(line) })
            } else if (line == "end" or starts_with(line, "end ")) and len(scopes) > 1 {
                scopes = slice(scopes, 0, top)
            } else if starts_with(line, "open ") {
                let s = scopes[top]
                scopes = set_at(scopes, top, Scope { ns: s.ns, opens: extend(s.opens, open_names(text)), vars: s.vars, closer: s.closer })
            } else if starts_with(line, "variable") {
                let s = scopes[top]
                scopes = set_at(scopes, top, Scope { ns: s.ns, opens: s.opens, vars: push(s.vars, text), closer: s.closer })
            }
            let mut opens = []
            for s in scopes { opens = extend(opens, s.opens) }
            items = push(items, Item { kind: "keep", full: "", short: "", text: prefix + text, ns: current_ns(scopes), opens: distinct(opens), vars: "", root: is_substantive(line) or (starts_with(line, "open ") and contains_str(line, "(")) })
            prefix = ""
            prefix_opens = []
        }
        k = j
    }
    // Close what the file left open, innermost first, so the next source starts at top level.
    let mut depth = len(scopes) - 1
    while depth > 0 {
        items = push(items, Item { kind: "keep", full: "", short: "", text: scopes[depth].closer, ns: "", opens: [], vars: "", root: false })
        depth = depth - 1
    }
    return Source { module: module_of(path), imports: imports, items: items }
}

// The distinct strings of `xs`, sorted.
fn distinct(xs: list<str>) -> list<str> {
    let mut out = []
    let mut prev = ""
    for x in sort(xs) {
        if x != prev { out = push(out, x) }
        prev = x
    }
    return out
}

fn contains_str(text: str, part: str) -> bool {
    return len(split(text, part)) > 1
}

// Sources in import order: a module comes after every source module it imports, and as late as
// that allows (just before the first module that needs it). In one file everything earlier is
// visible, so a module placed early could shadow names (an `export` into an enclosing
// namespace) for a module that never imported it.
fn ordered(sources: list<Source>) -> list<Source> {
    let mut modules = {}
    for src in sources { modules = merge(modules, { src.module: true }) }
    // How many unplaced sources still import each module.
    let mut waiting = {}
    for src in sources {
        for m in distinct(src.imports) {
            if get_or(modules, m, false) { waiting = merge(waiting, { m: get_or(waiting, m, 0) + 1 }) }
        }
    }
    let late = shadowing(sources, modules)
    // Fill from the end: a module goes in once everything importing it is placed. Modules in
    // `late` go first (so they end up last), so a module that does not import them never sees
    // their names.
    let mut back = []
    let mut placed = {}
    let mut prefer = true
    while len(back) < len(sources) {
        let before = len(back)
        let mut k = len(sources) - 1
        while k >= 0 {
            let src = sources[k]
            if not get_or(placed, src.module, false) and get_or(waiting, src.module, 0) == 0 and get_or(late, src.module, false) == prefer {
                back = push(back, src)
                placed = merge(placed, { src.module: true })
                for m in distinct(src.imports) {
                    if get_or(modules, m, false) { waiting = merge(waiting, { m: waiting[m] - 1 }) }
                }
            }
            k = k - 1
        }
        // Back to the late modules as soon as one is ready again.
        if len(back) == before { prefer = not prefer } else { prefer = true }
    }
    let mut out = []
    let mut j = len(back) - 1
    while j >= 0 {
        out = push(out, back[j])
        j = j - 1
    }
    return out
}

// Modules with an `export` line (it adds names to an enclosing namespace, which Lean
// prefers to an opened one) and every module importing one of them.
fn shadowing(sources: list<Source>, modules: map<str, bool>) -> map<str, bool> {
    let mut late = {}
    for src in sources {
        for item in src.items {
            if starts_with(item.text, "export ") { late = merge(late, { src.module: true }) }
        }
    }
    let mut grew = true
    while grew {
        grew = false
        for src in sources {
            if not get_or(late, src.module, false) {
                for m in src.imports {
                    if get_or(late, m, false) and not get_or(late, src.module, false) {
                        late = merge(late, { src.module: true })
                        grew = true
                    }
                }
            }
        }
    }
    return late
}

// `A.B.C` gives `A.B.C`, `A.B`, `A`.
fn prefixes(ns: str) -> list<str> {
    if len(ns) == 0 { return [] }
    let parts = split(ns, ".")
    let mut out = []
    let mut k = len(parts)
    while k > 0 {
        out = push(out, join(slice(parts, 0, k), "."))
        k = k - 1
    }
    return out
}

// The full names `name` can mean inside namespace `ns` with `opens` open.
// The namespaces a name is looked up under inside `ns` with `opens` open (the root first).
fn bases_of(ns: str, opens: list<str>) -> list<str> {
    let pre = prefixes(ns)
    let via_opens = flat_map(opens, fn(o: str) -> list<str> {
        return push(map(pre, fn(p: str) -> str { return p + "." + o }), o)
    })
    return extend(pre, via_opens)
}

// The full names `name` can mean under `bases`.
fn candidates(name: str, bases: list<str>) -> list<str> {
    let mut out = [name]
    for b in bases { out = push(out, b + "." + name) }
    return out
}

// Declarations a name in declaration context (`ns`, `opens`) may refer to.
fn resolve(name: str, bases: list<str>, by_full: map<str, list<int>>, by_short: map<str, list<int>>, spaces: map<str, list<str>>, known_parts: map<str, list<str>>) -> list<int> {
    let mut n = name
    if starts_with(n, "_root_.") { n = slice(n, 7, len(n)) }
    let parts = split(n, ".")
    let mut possible = false
    for p in parts {
        if len(get_or(known_parts, p, [])) > 0 { possible = true }
    }
    if not possible { return [] }
    if len(parts[0]) == 0 {
        return get_or(by_short, parts[len(parts) - 1], [])
    }
    // The longest prefix of the dotted name that names a declaration (`Foo.mk` -> `Foo`).
    let mut k = len(parts)
    while k > 0 {
        let head = join(slice(parts, 0, k), ".")
        for c in candidates(head, bases) {
            let hit = get_or(by_full, c, [])
            if len(hit) > 0 { return extend(hit, fields_after(parts, k, by_short)) }
        }
        k = k - 1
    }
    // Not a declaration: dot-notation on a local, so any later component may name a declaration
    // through its type's namespace. A local can share its name with a namespace (`S.Zhat` with a
    // namespace `S` in scope), so a namespace head does not rule this out.
    return fields_after(parts, 1, by_short)
}

// Later components of `x.f.g` after the part that resolved may be dot-notation fields (`D` a
// local sharing a declaration's name).
fn fields_after(parts: list<str>, k: int, by_short: map<str, list<int>>) -> list<int> {
    let mut out = []
    for p in slice(parts, k, len(parts)) { out = extend(out, get_or(by_short, p, [])) }
    return out
}

// The names the explicit `open X (a b)` and `export X (a b)` lines of `text` bring in, as `X.a`
// and `X.b`.
fn explicit_opens(text: str) -> list<str> {
    let mut out = []
    for line in split(text, "\n") {
        if (starts_with(line, "open ") or starts_with(line, "export ")) and contains_str(line, "(") {
            let inside = split(split(line, "(")[1], ")")[0]
            for o in open_names(line) {
                for n in split(inside, " ") {
                    if len(n) > 0 { out = push(out, o + "." + n) }
                }
            }
        }
    }
    return out
}

// Closures live in small helpers: a function holding a closure copies its lists on update, and a
// closure taking a struct copies it on every call.
// Declarations and root lines of all sources in order, with their full and short names.
fn collect(sources: list<Source>) -> Decls {
    let mut decls = []
    let mut keeps = []
    let mut fulls = []
    let mut shorts = []
    for src in sources {
        for it in src.items {
            if it.kind == "decl" {
                decls = push(decls, it)
                fulls = push(fulls, it.full)
                shorts = push(shorts, it.short)
            } else if it.root {
                keeps = push(keeps, it)
            }
        }
    }
    return Decls { decls: decls, keeps: keeps, fulls: fulls, shorts: shorts }
}

fn as_set(xs: list<str>) -> map<str, list<str>> {
    return group_by(xs, fn(x: str) -> str { return x })
}

// The index of the first occurrence of each name, in order.
fn first_indices(names: list<str>) -> list<int> {
    let grouped = index_pairs(pairs_at(names, range(len(names))))
    let mut out = []
    for name in keys(grouped) { out = push(out, grouped[name][0]) }
    return sort(out)
}

fn pairs_at(names: list<str>, at: list<int>) -> list<list<any>> {
    let mut out = []
    for j in at { out = push(out, [names[j], j]) }
    return out
}

fn all_prefixes(names: list<str>, at: list<int>) -> list<str> {
    let mut out = []
    for j in at { out = extend(out, prefixes(names[j])) }
    return out
}

// `seen` grown by the declarations reachable from `start` and from the names in `keeps` lines.
fn reach(decls: list<Item>, keeps: list<Item>, start: list<int>, seen0: list<bool>, full_index: map<str, list<int>>, short_index: map<str, list<int>>, spaces: map<str, list<str>>, known_parts: map<str, list<str>>) -> list<bool> {
    let mut seen = seen0
    let mut queue = []
    for j in start {
        if not seen[j] {
            seen = set_at(seen, j, true)
            queue = push(queue, j)
        }
    }
    // Names in kept attribute, notation and instance lines are reached as well.
    for item in keeps {
        let bases = bases_of(item.ns, item.opens)
        for name in extend(names_in(item.text), explicit_opens(item.text)) {
            for j in resolve(name, bases, full_index, short_index, spaces, known_parts) {
                if not seen[j] {
                    seen = set_at(seen, j, true)
                    queue = push(queue, j)
                }
            }
        }
    }
    let mut head = 0
    while head < len(queue) {
        let d = decls[queue[head]]
        head = head + 1
        // Lean resolves names in `def A.B.f` under `A.B` as well as the current namespace.
        let bases = bases_of(parent_of(d.full), d.opens)
        for name in extend(names_in(d.text + "\n" + d.vars), explicit_opens(d.text)) {
            for j in resolve(name, bases, full_index, short_index, spaces, known_parts) {
                if not seen[j] {
                    seen = set_at(seen, j, true)
                    queue = push(queue, j)
                }
            }
        }
    }
    return seen
}

// The modules of sources with at least one kept declaration (those are emitted).
fn emitted_sources(sources: list<Source>, seen: list<bool>, full_index: map<str, list<int>>) -> map<str, bool> {
    let mut out = {}
    let mut index = 0
    for src in sources {
        for item in src.items {
            if item.kind == "decl" {
                if seen[index] and get_or(full_index, item.full, [-1])[0] == index { out = merge(out, { src.module: true }) }
                index = index + 1
            }
        }
    }
    return out
}

// The `variable` lines of emitted sources not yet in `done`.
fn new_variable_lines(sources: list<Source>, seen: list<bool>, full_index: map<str, list<int>>, done: map<str, bool>) -> list<Item> {
    let emitted = emitted_sources(sources, seen, full_index)
    let mut out = []
    for src in sources {
        if get_or(emitted, src.module, false) and not get_or(done, src.module, false) {
            for item in src.items {
                if item.kind == "keep" and starts_with(item.text, "variable") { out = push(out, item) }
            }
        }
    }
    return out
}

// `[[key, index], ...]` as a map from key to its indices, in order.
fn index_pairs(pairs: list<list<any>>) -> map<str, list<int>> {
    let grouped = group_by(pairs, fn(e: list<any>) -> str { return e[0] })
    let mut out = {}
    for k in keys(grouped) {
        out = merge(out, { k: map(grouped[k], fn(e: list<any>) -> int { return e[1] }) })
    }
    return out
}

// `needed` plus the namespaces that `item`'s `open` lines (its own or an `open ... in` prefix)
// name but no kept declaration keeps alive.
fn needs_of(item: Item, spaces: map<str, list<str>>, alive: map<str, list<str>>, needed: list<str>) -> list<str> {
    let mut out = needed
    let lines = split(item.text, "\n")
    for i in range(len(lines)) {
        if starts_with(lines[i], "open ") {
            // The open runs on over indented lines; open_names stops at its `in`.
            for o in open_names(join(slice(lines, i, len(lines)), "\n")) {
                for c in candidates(o, prefixes(item.ns)) {
                    // Registered even when a kept declaration lives in it: that one may come
                    // after this `open`, and a repeated `namespace X end X` is harmless.
                    if len(get_or(spaces, c, [])) > 0 and not contains(out, c) { out = push(out, c) }
                }
            }
        }
    }
    return out
}

// Source arguments are `.lean` files or directories of them (a directory keeps the command line
// short when a proof has hundreds of modules).
fn source_paths(args: list<str>) -> list<str> {
    let mut out = []
    for a in args {
        if ends_with(a, ".lean") {
            out = push(out, a)
        } else {
            for name in sort(list_dir(a)) {
                if ends_with(name, ".lean") and not starts_with(name, "_") { out = push(out, a + "/" + name) }
            }
        }
    }
    return out
}

fn main() -> nil {
    let args = sys_args()
    let statement = replace(read_file(args[0]), "\r", "")
    let entry_name = args[1]
    let mut raw = []
    for path in source_paths(slice(args, 3, len(args))) { raw = push(raw, parse(path)) }
    let sources = ordered(raw)
    let found = collect(sources)
    let decls = found.decls
    let keeps = found.keeps
    let fulls = found.fulls
    let shorts = found.shorts
    let firsts = first_indices(fulls)
    let full_pairs = pairs_at(fulls, firsts)
    let short_pairs = pairs_at(shorts, firsts)
    let spaces = as_set(all_prefixes(fulls, firsts))
    let known_parts = as_set(flat_map(fulls, fn(f: str) -> list<str> { return split(f, ".") }))
    let full_index = index_pairs(full_pairs)
    let short_index = index_pairs(short_pairs)
    if len(get_or(full_index, entry_name, [])) == 0 {
        print(f"entry {entry_name} not found among {len(decls)} declarations")
        return
    }
    let start = push(filter(firsts, fn(j: int) -> bool { return decls[j].root }), full_index[entry_name][0])
    let mut seen = reach(decls, keeps, start, filled(len(decls), false), full_index, short_index, spaces, known_parts)
    // An emitted source brings all its `variable` lines, and Lean elaborates each one: reach
    // their names too, until no further source is emitted.
    let mut done_sources = {}
    let mut grew = true
    while grew {
        let lines = new_variable_lines(sources, seen, full_index, done_sources)
        done_sources = merge(done_sources, emitted_sources(sources, seen, full_index))
        grew = len(lines) > 0
        if grew { seen = reach(decls, lines, [], seen, full_index, short_index, spaces, known_parts) }
    }
    // Namespaces that still hold a kept declaration.
    let alive = as_set(all_prefixes(fulls, filter(firsts, fn(j: int) -> bool { return seen[j] })))
    let core = split(split(statement, "namespace ")[1], "\n")[0]
    let before = split(statement, f"namespace {core}")[0]
    let theorem = split(split(statement, f"namespace {core}")[1], f"end {core}")[0]
    let close = trim(split(theorem, ":= by")[0])
    let mut header = []
    let mut statement_opens = []
    for line in split(before, "\n") {
        if starts_with(line, "import ") { header = push(header, line) }
        if starts_with(line, "open ") { statement_opens = push(statement_opens, line) }
    }
    let mut module_set = {}
    for src in sources { module_set = merge(module_set, { src.module: true }) }
    let imports_mathlib = contains(header, "import Mathlib")
    for src in sources {
        for m in src.imports {
            let line = "import " + m
            let own = get_or(module_set, m, false)
            if not own and not (starts_with(m, "Mathlib") and imports_mathlib) and not contains(header, line) { header = push(header, line) }
        }
    }
    let mut body = []
    let mut needed = []
    let mut index = 0
    let mut kept = 0
    for src in sources {
        let mut chunk = [f"-- from {src.module}", "section"]
        let mut used = 0
        for item in src.items {
            if item.kind == "keep" {
                chunk = push(chunk, item.text)
                needed = needs_of(item, spaces, alive, needed)
            } else {
                if seen[index] and get_or(full_index, decls[index].full, [-1])[0] == index {
                    needed = needs_of(item, spaces, alive, needed)
                    chunk = push(chunk, item.text)
                    used = used + 1
                }
                index = index + 1
            }
        }
        if used > 0 { body = extend(body, push(chunk, "end")) }
        kept = kept + used
    }
    let mut out = header
    out = extend(out, ["", "-- found by RAD: github.com/peteracs/rad-lang", "-- RAD kept only the declarations the entry theorem reaches; the rest of the slice is unused.", "", "noncomputable section", ""])
    for ns in needed { out = push(out, f"namespace {ns} end {ns}") }
    out = extend(out, body)
    out = extend(out, ["", "-- statement", "section"])
    out = extend(out, statement_opens)
    out = extend(out, ["", f"namespace {core}", "", f"{close} :=", f"  @{entry_name}", "", f"end {core}", "", "end", "", "end"])
    let text = join(push(out, ""), "\n")
    write_file(args[2], text)
    print(f"{len(sources)} sources, {len(decls)} declarations parsed, {kept} kept, {count_tokens(text)} tokens")
    print(f"wrote {args[2]}")
}

dd275bdb\"],[0,2,\"red-mage\",\"Team\",\"{ side: \\\"red\\\" }\",1,[0],\"wire dd275bdb\"],[0,3,\"red-cleric\",\"Intent\",\"{ kind: \\\"wait\\\", tx: 3, ty: 3, target: \\\"\\\" }\",0,[0],null],[0,3,\"red-cleric\",\"Pos\",\"{ x: 3, y: 3 }\",0,[0],null],[0,3,\"red-cleric\",\"Stats\",\"{ cls: \\\"cleric\\\", hp: 18, max_hp: 18, atk: 4, rng: 2, mov: 2 }\",1,[0],\"wire dd275bdb\"],[0,3,\"red-cleric\",\"Team\",\"{ side: \\\"red\\\" }\",1,[0],\"wire dd275bdb\"]],[]]}\n"},"s":18,"t":"io"}

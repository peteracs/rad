{"a":"8c8c7a91687ee0f1","b":"tcp_read","f":0,"r":{"t":"str","v":"ORDERS blue 1 dd275bdb5190124a8935eaa88c64799896e1e82dc2b03422aa8e3520b19c83af\tRADDELTA1 167470305a5ba0793c942ef8109b5325d811644165035dcc30d4532d1340d53d {\"check\":[8,8,0],\"despawns\":[],\"upserts\":[],\"ent_patch\":[[4,[[\"Intent\",[[\"kind\",\"move\"],[\"tx\",6],[\"ty\",4]]],[\"Pos\",[[\"x\",6],[\"y\",4]]]],[]],[5,[[\"Intent\",[[\"kind\",\"attack\"],[\"tx\",6],[\"ty\",2],[\"target\",\"red-cleric\"]]],[\"Pos\",[[\"x\",6],[\"y\",2]]]],[]],[6,[[\"Intent\",[[\"kind\",\"attack\"],[\"tx\",5],[\"ty\",5],[\"target\",\"red-mage\"]]],[\"Pos\",[[\"x\",5]]]],[]],[7,[[\"Intent\",[[\"tx\",6],[\"ty\",3]]]],[]]],\"events\":[],\"free_ids\":[],\"next_id\":8,\"resources\":[],\"res_patch\":[[\"Battle\",[[\"futures\",210]]]],\"schema\":[[\"Intent\",[\"kind\",\"tx\",\"ty\",\"target\"]],[\"Pos\",[\"x\",\"y\"]]],\"prov\":[[[0,null,null,\"Battle\",\"{ round: 0, winner: \\\"\\\", log: \\\"\\\", futures: 210 }\",4,[0],null],[0,4,\"blue-knight\",\"Intent\",\"{ kind: \\\"move\\\", tx: 6, ty: 4, target: \\\"\\\" }\",0,[0],null],[0,4,\"blue-knight\",\"Pos\",\"{ x: 6, y: 4 }\",0,[0],null],[0,4,\"blue-knight\",\"Stats\",\"{ cls: \\\"knight\\\", hp: 34, max_hp: 34, atk: 6, rng: 1, mov: 3 }\",1,[0],\"wire dd275bdb\"],[0,4,\"blue-knight\",\"Team\",\"{ side: \\\"blue\\\" }\",1,[0],\"wire dd275bdb\"],[0,5,\"blue-archer\",\"Intent\",\"{ kind: \\\"attack\\\", tx: 6, ty: 2, target: \\\"red-cleric\\\" }\",0,[0],null],[0,5,\"blue-archer\",\"Pos\",\"{ x: 6, y: 2 }\",0,[0],null],[0,5,\"blue-archer\",\"Stats\",\"{ cls: \\\"archer\\\", hp: 20, max_hp: 20, atk: 5, rng: 4, mov: 3 }\",1,[0],\"wire dd275bdb\"],[0,5,\"blue-archer\",\"Team\",\"{ side: \\\"blue\\\" }\",1,[0],\"wire dd275bdb\"],[0,6,\"blue-mage\",\"Intent\",\"{ kind: \\\"attack\\\", tx: 5, ty: 5, target: \\\"red-mage\\\" }\",0,[0],null],[0,6,\"blue-mage\",\"Pos\",\"{ x: 5, y: 5 }\",0,[0],null],[0,6,\"blue-mage\",\"Stats\",\"{ cls: \\\"mage\\\", hp: 16, max_hp: 16, atk: 8, rng: 3, mov: 2 }\",1,[0],\"wire dd275bdb\"],[0,6,\"blue-mage\",\"Team\",\"{ side: \\\"blue\\\" }\",1,[0],\"wire dd275bdb\"],[0,7,\"blue-cleric\",\"Intent\",\"{ kind: \\\"wait\\\", tx: 6, ty: 3, target: \\\"\\\" }\",0,[0],null],[0,7,\"blue-cleric\",\"Pos\",\"{ x: 6, y: 3 }\",0,[0],null],[0,7,\"blue-cleric\",\"Stats\",\"{ cls: \\\"cleric\\\", hp: 18, max_hp: 18, atk: 4, rng: 2, mov: 2 }\",1,[0],\"wire dd275bdb\"],[0,7,\"blue-cleric\",\"Team\",\"{ side: \\\"blue\\\" }\",1,[0],\"wire dd275bdb\"]],[]]}\n"},"s":20,"t":"io"}

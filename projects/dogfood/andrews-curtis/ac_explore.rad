// Andrews-Curtis search, written on `explore`.
//
//   rad ac_explore.rad -- solve <r1> <r2> [worlds] [max_total] [descent|level]
//   rad ac_explore.rad -- reach <r1> <r2> [worlds] [max_total] [descent|level]
//   rad ac_explore.rad -- path  <r1> <r2> <pair> [worlds] [max_total] [descent|level]
//
// `solve` looks for a path to <x, y> and prints it in the format verify.py
// reads. `reach` prints every pair of relators the search reaches within its
// budget of worlds. `path` prints the path to one of those pairs. Two
// presentations whose `reach` lists share a pair are trivializable together
// or not at all; explore_meet.py finds such pairs and assembles the chains.
//
// The same two steps and the same lazy level order as ac_levels.rad, which
// keeps its frontier, its visited set and its parent pointers in entities and
// reads the path back out of the ledger. Here the world is one presentation,
// `Steps` offers the presentations one step away, and `explore` owns the
// frontier, the visited set and the path. It expands worlds in parallel and
// returns the same answer at any thread count. Pairs waiting at one level are
// taken in the order they arrived, which is not always the order ac_levels.rad
// reads them back from its index: on the 79 presentations both solve, 71
// paths are identical and 8 are one step longer here.
//
// A world is a pair of cyclic words and the level it will produce next.
// A pair queued at level t is asked only for its product children of total
// exactly t, then offered again at its next level under the label "wait".
// The score is the level, so `explore` visits the lowest level first.
//
// `descent` (the default) applies a Whitehead automorphism only when it
// shortens the pair. `level` also offers the automorphisms that keep its
// length, which reach the other shortest pairs of the same orbit.
//
// The budget is a number of worlds, not a wall clock: the same arguments give
// the same result on any machine, and `path` reaches a pair exactly when
// `reach` listed it under the same budget.

resource Node { a: str = "", b: str = "", level: int = 0, fresh: bool = true, pair: str = "", key: str = "", solved: bool = false }

let ARGS = sys_args()
let MODE = if len(ARGS) > 0 { ARGS[0] } else { "" }
// The optional arguments start after the presentation, or after the pair.
let REST = if MODE == "path" { 4 } else { 3 }
// The pair a search stops at. `reach` stops at none.
let TARGET = if MODE == "solve" { "X,Y" } else { if MODE == "path" and len(ARGS) > 3 { ARGS[3] } else { "" } }
let WORLDS = if len(ARGS) > REST { int(ARGS[REST]) } else { 200000 }
let MAX_TOTAL = if len(ARGS) > REST + 1 { int(ARGS[REST + 1]) } else { 40 }
let LEVEL_MOVES = len(ARGS) > REST + 2 and ARGS[REST + 2] == "level"

fn inverse(w: str) -> str {
    let r = join(reverse(chars(w)), "")
    let a = replace(replace(replace(r, "x", "1"), "X", "x"), "1", "X")
    return replace(replace(replace(a, "y", "2"), "Y", "y"), "2", "Y")
}

// Least rotation of w or of its inverse.
fn canon(w: str) -> str {
    let n = len(w)
    if n <= 1 {
        if w == "x" { return "X" }
        if w == "y" { return "Y" }
        return w
    }
    let ww = w + w
    let v = inverse(w)
    let vv = v + v
    let mut best = w
    let mut i = 0
    while i < n {
        let c = slice(ww, i, i + n)
        if c < best { best = c }
        let d = slice(vv, i, i + n)
        if d < best { best = d }
        i = i + 1
    }
    return best
}

fn cyclic(w: str) -> str {
    let mut lo = 0
    let mut hi = len(w)
    while hi - lo >= 2 and abs(byte_at(w, lo) - byte_at(w, hi - 1)) == 32 {
        lo = lo + 1
        hi = hi - 1
    }
    return slice(w, lo, hi)
}

// Cyclic reduction of the free product u * v (u and v freely reduced).
fn product(u: str, v: str) -> str {
    let mut a = len(u)
    let mut b = 0
    let m = len(v)
    while a > 0 and b < m and abs(byte_at(u, a - 1) - byte_at(v, b)) == 32 {
        a = a - 1
        b = b + 1
    }
    return cyclic(slice(u, 0, a) + slice(v, b, m))
}

// Free and cyclic reduction of an arbitrary word.
fn reduce(w: str) -> str {
    let mut s = w
    let mut before = len(s) + 1
    while len(s) < before {
        before = len(s)
        s = replace(replace(replace(replace(s, "xX", ""), "Xx", ""), "yY", ""), "Yy", "")
    }
    return cyclic(s)
}

// The four Whitehead automorphisms of F(x, y) that act on cyclic words:
// 0: y -> yx   1: y -> yX   2: x -> xy   3: x -> xY
fn whitehead(w: str, kind: int) -> str {
    if kind == 0 { return reduce(replace(replace(replace(replace(w, "y", "1"), "Y", "2"), "1", "yx"), "2", "XY")) }
    if kind == 1 { return reduce(replace(replace(replace(replace(w, "y", "1"), "Y", "2"), "1", "yX"), "2", "xY")) }
    if kind == 2 { return reduce(replace(replace(replace(replace(w, "x", "1"), "X", "2"), "1", "xy"), "2", "YX")) }
    return reduce(replace(replace(replace(replace(w, "x", "1"), "X", "2"), "1", "xY"), "2", "yX"))
}

fn key_of(a: str, b: str) -> str {
    if a <= b { return a + "," + b }
    return b + "," + a
}

// The lowest level above `after` at which the pair of lengths (n0, n1) has
// product children, or -1. Replacing the relator of length n by a product
// with the one of length m at cancellation c gives total n + 2m - 2c.
fn next_level(n0: int, n1: int, after: int) -> int {
    let lo0 = n0 + 2 * n1 - 2 * min(n0, n1)
    let lo1 = n1 + 2 * n0 - 2 * min(n0, n1)
    let hi0 = n0 + 2 * n1 - 2
    let hi1 = n1 + 2 * n0 - 2
    let mut t = max(after + 1, min(lo0, lo1))
    while t <= MAX_TOTAL and t <= max(hi0, hi1) {
        if t >= lo0 and t <= hi0 and (hi0 - t) % 2 == 0 { return t }
        if t >= lo1 and t <= hi1 and (hi1 - t) % 2 == 0 { return t }
        t = t + 1
    }
    return -1
}

// A pair that can produce nothing within MAX_TOTAL still has to be reached
// (it may be the goal); it waits behind every level that can.
fn first_level(a: str, b: str) -> int {
    let level = next_level(len(a), len(b), 0)
    if level == -1 { return MAX_TOTAL + 1 }
    return level
}

fn node_of(a: str, b: str, level: int, fresh: bool) -> Node {
    let pair = key_of(a, b)
    let parts = split(pair, ",")
    let key = if fresh { pair } else { f"{pair}@{level}" }
    return Node { a: parts[0], b: parts[1], level: level, fresh: fresh, pair: pair, key: key, solved: pair == TARGET }
}

ecs fn place(a: str, b: str, level: int, fresh: bool, label: str) -> nil {
    set_resource(Node, node_of(a, b, level, fresh))
    offer(label)
}

system Steps(node: Node, writes Node) {
    let n0 = len(node.a)
    let n1 = len(node.b)
    let here = key_of(node.a, node.b)
    let level = node.level

    if node.fresh {
        // Whitehead descent: if an automorphism shortens the pair, the
        // shorter pair is the only successor.
        let mut kind = 0
        while kind < 4 {
            let p = whitehead(node.a, kind)
            let q = whitehead(node.b, kind)
            if len(p) + len(q) < n0 + n1 and len(p) > 0 and len(q) > 0 {
                let ca = canon(p)
                let cb = canon(q)
                place(ca, cb, first_level(ca, cb), true, f"aut{kind} {key_of(ca, cb)}")
                return nil
            }
            kind = kind + 1
        }
        // No automorphism shortens the pair. With `level`, the automorphisms
        // that keep its length are moves too: they lead to the other
        // shortest pairs of the same orbit, which multiply differently.
        if LEVEL_MOVES {
            let mut turned = 0
            while turned < 4 {
                let p = whitehead(node.a, turned)
                let q = whitehead(node.b, turned)
                if len(p) + len(q) == n0 + n1 and len(p) > 0 and len(q) > 0 {
                    let ca = canon(p)
                    let cb = canon(q)
                    if key_of(ca, cb) != here {
                        place(ca, cb, first_level(ca, cb), true, f"aut{turned} {key_of(ca, cb)}")
                    }
                }
                turned = turned + 1
            }
        }
    }

    if level <= MAX_TOTAL {
        let mut offered = {}
        let mut side = 0
        while side < 2 {
            let a = if side == 0 { node.a } else { node.b }
            let b = if side == 0 { node.b } else { node.a }
            let n = len(a)
            let m = len(b)
            let twice = n + 2 * m - level
            if twice >= 2 and twice % 2 == 0 and twice <= 2 * min(n, m) and twice < n + m {
                let c = int_div(twice, 2)
                let wanted = n + m - twice
                let aa = a + a
                // Rotations of a, by their last c letters.
                let mut ends = {}
                let mut i = 0
                while i < n {
                    let g = slice(aa, i + n - c, i + n)
                    ends[g] = push(get_or(ends, g, []), i)
                    i = i + 1
                }
                let mut turn = 0
                while turn < 2 {
                    let other = if turn == 0 { b } else { inverse(b) }
                    let oo = other + other
                    let io = inverse(oo)
                    let mut j = 0
                    while j < m {
                        // The inverse of the first c letters of this rotation.
                        let q = slice(io, 2 * m - j - c, 2 * m - j)
                        if contains(ends, q) {
                            let v = slice(oo, j, j + m)
                            for at in ends[q] {
                                let w = product(slice(aa, at, at + n), v)
                                // Shorter than `wanted` when taking the piece
                                // out lets the two sides of it cancel as well.
                                if len(w) <= wanted and len(w) > 0 {
                                    let cw = canon(w)
                                    let pair = key_of(cw, b)
                                    if pair != here and not contains(offered, pair) {
                                        offered[pair] = true
                                        place(cw, b, first_level(cw, b), true, pair)
                                    }
                                }
                            }
                        }
                        j = j + 1
                    }
                    turn = turn + 1
                }
            }
            side = side + 1
        }
        let later = next_level(n0, n1, level)
        if later != -1 { place(node.a, node.b, later, false, "wait") }
    }
}

fn usage() -> nil {
    print("usage: rad ac_explore.rad -- solve <r1> <r2> [worlds] [max_total] [descent|level]")
    print("       rad ac_explore.rad -- reach <r1> <r2> [worlds] [max_total] [descent|level]")
    print("       rad ac_explore.rad -- path  <r1> <r2> <pair> [worlds] [max_total] [descent|level]")
}

fn main() -> nil {
    if not (MODE == "solve" or MODE == "reach" or MODE == "path") or len(ARGS) < REST {
        usage()
        return nil
    }
    let started = now_unix_ms()

    let a0 = canon(reduce(ARGS[1]))
    let b0 = canon(reduce(ARGS[2]))
    let start = key_of(a0, b0)
    set_resource(Node, node_of(a0, b0, first_level(a0, b0), true))
    let root = fork()

    let mut options: map<str, any> = {"score": "Node.level", "key": "Node.key", "limit": WORLDS}
    if MODE == "reach" {
        options["collect"] = "Node.pair"
    } else {
        options["goal"] = "Node.solved"
    }
    let found = explore(root, [system::Steps], options)
    let elapsed = now_unix_ms() - started
    let counts = f"expanded={found["expanded"]} seen={found["seen"]} ms={elapsed}"

    if MODE == "reach" {
        // A pair that waits at a later level is the same pair again.
        let mut listed = {}
        let mut pairs = []
        for pair in found["collected"] {
            if not contains(listed, pair) {
                listed[pair] = true
                pairs = push(pairs, pair)
            }
        }
        print(f"REACHED {start} status={found["status"]} pairs={len(pairs)} max_total={MAX_TOTAL} {counts}")
        for pair in pairs {
            print(pair)
        }
        return nil
    }

    if found["status"] != "goal" {
        print(f"UNSOLVED {start} status={found["status"]} max_total={MAX_TOTAL} {counts}")
        return nil
    }

    // The path is a certificate inside Rad as well: `follow` runs the steps
    // again from the start and has to arrive at the pair.
    let arrived = peek_resource(follow(root, [system::Steps], found["path"]), Node) |> unwrap
    let mut lines = [start]
    for label in found["path"] {
        if label != "wait" { lines = push(lines, label) }
    }
    let head = if MODE == "solve" { f"SOLVED {start}" } else { f"JOINED {start} reaches {TARGET}" }
    print(f"{head} steps={len(lines) - 1} followed={arrived.solved} {counts}")
    for line in lines {
        print(line)
    }
}

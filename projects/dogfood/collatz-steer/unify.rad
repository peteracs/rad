use "bigwalk.rad"

resource Family { m: int = 1, q: int = 1, j: int = 1 }

pub struct FamilyReport {
    m: int = 0
    ks: int = 0
    agreements: int = 0
    max_gap_steps: int = 0        // |descent - passage| worst case
    worst_dip_micro: int = 0      // min over k of min_t W_t
    worst_dip_k: int = 0
    max_passage_per_bit_x1000: int = 0 // odd steps needed per excess bit
    min_rate_x1000: int = 100000
}

component Report { result: FamilyReport = FamilyReport {} }

entity report_slot { Report {} }

system Walk(report: mut Report, family: Family) {
    let mut agree: int = 0
    let mut gap: int = 0
    let mut dip: int = 0
    let mut dip_k: int = 0
    let mut per_bit: int = 0
    let mut rate: int = 100000
    let start_k: int = if family.m == 1 { 2 } else { 1 }  // 2^1 - 1 = 1 is the trivial point
    for k in range(start_k, 61) {
        let p: Passage = walk(family.m, family.q, family.j, k)
        if p.agree { agree = agree + 1 }
        let g: int = abs(p.descent_steps - p.passage_steps)
        if g > gap { gap = g }
        if p.min_walk_micro < dip { dip = p.min_walk_micro dip_k = k }
        if p.excess_micro > 0 {
            let b: int = int_div(1000000000 * p.passage_odd, p.excess_micro)
            if b > per_bit { per_bit = b }
        }
        if p.halving_rate_x1000 > 0 and p.halving_rate_x1000 < rate { rate = p.halving_rate_x1000 }
    }
    report = Report { result: FamilyReport { m: family.m, ks: 61 - start_k, agreements: agree, max_gap_steps: gap,
        worst_dip_micro: dip, worst_dip_k: dip_k, max_passage_per_bit_x1000: per_bit, min_rate_x1000: rate } }
}

component Unified { families: int = 0, all_agree: bool = false, worst_gap: int = 0 }

entity unified { Unified {} }

intent Finding {
    key target: entity
    m: int
    agreements: int
    ks: int
    gap: int
}

law Submit(target: entity, r: FamilyReport) {
    propose Finding { target: target, m: r.m, agreements: r.agreements, ks: r.ks, gap: r.max_gap_steps }
}

resolver Merge for Finding(target, proposals) {
    let mut every: bool = true
    let mut worst: int = 0
    for p in proposals {
        if p.agreements != p.ks { every = false }
        if p.gap > worst { worst = p.gap }
    }
    next(target, Unified { families: len(proposals), all_agree: every, worst_gap: worst })
}

fn main() -> nil {
    let base: world_fork = fork()
    let jobs: list<world_fork> = [fork_with(base, Family { m: 1, q: 1, j: 1 }),
        fork_with(base, Family { m: 5, q: 2, j: 3 }), fork_with(base, Family { m: 17, q: 7, j: 11 })]
    let done: list<world_fork> = simulate_many(jobs, [system::Walk], 1, 1937)
    let mut reports: list<FamilyReport> = []
    for i in range(len(done)) {
        assert_only_changed(jobs[i], done[i], [Report])
        let r: FamilyReport = (peek(done[i], report_slot, Report) |> unwrap).result
        reports = push(reports, r)
        print(json_stringify(r))
    }
    settle { for r in reports { Submit(unified, r) } }
    print(json_stringify(require(unified, Unified)))
    print(why(unified, Unified))
}

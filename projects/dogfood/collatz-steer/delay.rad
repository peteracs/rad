// Escape delays of the trapped cylinders S_K, generated by Terras's rule
// T^t(r + 2^t u) = T^t(r) + 3^q u, so only surviving prefixes are visited.
pub pure fn tstep(x: int) -> int { return if x % 2 == 0 { int_div(x, 2) } else { int_div(3 * x + 1, 2) } }

pub struct DelayReport {
    k: int = 0
    residues: int = 0
    max_delay: int = 0
    argmax: int = 0
    shadow: str = ""              // "-1", "-5", "-17" if argmax = 2^K - m, else "rogue"
    top_shadow_delays: list<int> = []   // delays of 2^K-1, 2^K-5, 2^K-17 (-1 if not in S_K)
    best_rogue_delay: int = 0
    best_rogue: int = 0
    min_walk_at_k_micro: int = 0  // deepest W_K among survivors
}

// W in micro-bits: +1e6 per step, -1584963 per odd step.
pub pure fn delays(k: int) -> DelayReport {
    let mut stack: list<list<int>> = [[0, 0, 0, 1, 0]]   // r, t, x = T^t(r), 3^q, W
    let mut count: int = 0
    let mut best: int = 0 - 1
    let mut arg: int = 0
    let mut rogue_best: int = 0 - 1
    let mut rogue: int = 0
    let mut deepest: int = 0
    let shadows: list<int> = [(1 << k) - 1, (1 << k) - 5, (1 << k) - 17]
    let mut shadow_delay: list<int> = [0 - 1, 0 - 1, 0 - 1]
    while len(stack) > 0 {
        let s: list<int> = stack[len(stack) - 1]
        stack = slice(stack, 0, len(stack) - 1)
        let r: int = s[0]
        let t: int = s[1]
        let x: int = s[2]
        let p3: int = s[3]
        let w: int = s[4]
        if t == k {
            if r >= 1 {
                count = count + 1
                if w < deepest { deepest = w }
                // Continue the actual integer r past the horizon until W > 0.
                let mut y: int = x
                let mut walk: int = w
                let mut tau: int = k
                while walk <= 0 {
                    if y % 2 == 1 { walk = walk + 1000000 - 1584963 } else { walk = walk + 1000000 }
                    y = tstep(y)
                    tau = tau + 1
                }
                let delay: int = tau - k
                if delay > best { best = delay arg = r }
                let si: int = index_of(shadows, r)
                if si >= 0 { shadow_delay = set_at(shadow_delay, si, delay) }
                else if delay > rogue_best { rogue_best = delay rogue = r }
            }
        } else {
            for b in [0, 1] {
                let r2: int = r + b * (1 << t)
                let x2: int = x + b * p3
                let odd: int = x2 % 2
                let p3n: int = if odd == 1 { 3 * p3 } else { p3 }
                if p3n >= (1 << (t + 1)) {
                    let w2: int = w + 1000000 - odd * 1584963
                    stack = push(stack, [r2, t + 1, tstep(x2), p3n, w2])
                }
            }
        }
    }
    let label: str = if arg == shadows[0] { "-1" } else if arg == shadows[1] { "-5" } else if arg == shadows[2] { "-17" } else { "rogue" }
    return DelayReport { k: k, residues: count, max_delay: best, argmax: arg, shadow: label,
        top_shadow_delays: shadow_delay, best_rogue_delay: rogue_best, best_rogue: rogue, min_walk_at_k_micro: deepest }
}

pub pure fn index_of(xs: list<int>, v: int) -> int {
    for i in range(len(xs)) { if xs[i] == v { return i } }
    return 0 - 1
}

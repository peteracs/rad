use "schema.rad"
use "systems/routing.rad"
use "scenarios/production.rad"

fn main() -> nil {
    let receipt = summarize_alert_batch(50000)
    set_resource(PagerGridBatchReceipt, receipt)
    assert(res(PagerGridBatchReceipt).alerts == 50000, "50k alerts accounted")
    assert(res(PagerGridBatchReceipt).critical == 5000, "critical routes exact")
    assert(res(PagerGridBatchReceipt).routine == 45000, "routine routes exact")
    print("pagergrid-bench: ok incidents=50000")
}

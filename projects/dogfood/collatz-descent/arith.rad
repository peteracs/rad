use "calibrate.rad"

// Sweep: every cycle of 3x+d (odd d < 200, 3 does not divide d) with least
// element below 5000. For single-block cycles (the hard case for 3x+1),
// record gcd(d, 2^j - 3^q): a cycle needs D / gcd(d, D) to divide C.
pub pure fn gcd(a: int, b: int) -> int {
    let mut x: int = a
    let mut y: int = b
    while y != 0 { let r: int = x % y x = y y = r }
    return x
}

pub pure fn pow_mod_diff(j: int, q: int, m: int) -> int {
    // (2^j - 3^q) mod m, exact in ints.
    let mut a: int = 1
    for _ in range(j) { a = (a * 2) % m }
    let mut b: int = 1
    for _ in range(q) { b = (b * 3) % m }
    return ((a - b) % m + m) % m
}

fn main() -> nil {
    let l: Logs = logs()
    let mut tau_of: list<int> = [1]
    for q in range(1, 3000) { tau_of = push(tau_of, ceil_alpha(l, q)) }
    let mut single: int = 0
    let mut single_coprime: int = 0
    let mut multi: int = 0
    let mut best_coprime_ratio: int = 0
    let mut best_coprime: str = ""
    let mut best_shared_ratio: int = 0
    let mut best_shared: str = ""
    for d in range(5, 200, 2) {
        if d % 3 == 0 { continue }
        for n in range(1, 5000) {
            if n % d == 0 { continue }
            let members: list<int> = cycle_members(n, d, 4000)
            if len(members) == 0 { continue }
            let r: CycleReport = analyse(n, d, members, tau_of)
            assert(r.descent_ratio_milli <= 1000 and r.envelope_use_milli <= 1000 and r.drift_slack_min_milli > 0, "calibration violated")
            if r.blocks > 1 { multi = multi + 1 continue }
            single = single + 1
            let g: int = gcd(d, pow_mod_diff(r.length, r.odd, d))
            // n0 / d measures how large the cycle is in units of the offset.
            let ratio: int = int_div(n * 1000, d)
            let tag: str = format("d={} n0={} q={} j={} gcd={}", d, n, r.odd, r.length, g)
            if g == d {
                if ratio > best_shared_ratio { best_shared_ratio = ratio best_shared = tag }
            } else if g == 1 {
                single_coprime = single_coprime + 1
                if ratio > best_coprime_ratio { best_coprime_ratio = ratio best_coprime = tag }
            }
        }
    }
    print(format("cycles: {} single-block, {} multi-block; single-block with gcd(d, D) = 1: {}", single, multi, single_coprime))
    print(format("largest n0/d with d | D:      {}/1000  ({})", best_shared_ratio, best_shared))
    print(format("largest n0/d with gcd = 1:    {}/1000  ({})", best_coprime_ratio, best_coprime))
}

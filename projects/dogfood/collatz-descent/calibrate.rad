use "descent.rad"

// Calibration on x -> x/2, (3x + d)/2 for odd d > 0. Their offsets are exactly
// d times the 3x+1 offsets, so every 3x+1 necessary condition has a 3x+d
// version with thresholds scaled by d. These maps have real cycles; a sound
// condition must admit every one of them. We measure how tight each one is.
//
// For each cycle, from its least element n0:
//   drift:     every block endpoint n_(k+1) < n_k + d (s* q_k + beta*)
//   descent:   n0 (2^d(q_0) - 1) <= d C_0 / 3^q_0 (block 0 fails to descend)
//   envelope:  d C_k / 3^q_k <= d (s* q_k + beta*)
// and the tightness ratio n0 (2^(tau - q alpha) - 1) / (d C/3^q), which is at most 1.

pub struct CycleReport {
    d: int = 0
    n0: int = 0
    length: int = 0
    odd: int = 0
    blocks: int = 0
    first_block_q: int = 0
    descent_ratio_milli: int = 0
    envelope_use_milli: int = 0
    drift_slack_min_milli: int = 0
}

pub pure fn log2_3() -> float { return 1.584962500721156 }

pub pure fn step(x: int, d: int) -> int {
    return if x % 2 == 0 { int_div(x, 2) } else { int_div(3 * x + d, 2) }
}

// Cycle through n if the orbit of n returns to n within `limit` steps.
pub pure fn cycle_members(n: int, d: int, limit: int) -> list<int> {
    let mut x: int = step(n, d)
    let mut members: list<int> = [n]
    for _ in range(limit) {
        if x == n { return members }
        if x < n { return [] }
        members = push(members, x)
        x = step(x, d)
    }
    return []
}

pub pure fn analyse(n0: int, d: int, members: list<int>, tau_of: list<int>) -> CycleReport {
    let j: int = len(members)
    let mut odd: int = 0
    for x in members { if x % 2 == 1 { odd = odd + 1 } }
    // Walk blocks around the cycle once, starting at n0.
    let mut t: int = 0
    let mut blocks: int = 0
    let mut first_q: int = 0
    let mut ratio: float = 0.0
    let mut envelope_use: float = 0.0
    let mut drift_slack: float = 1000000.0
    let mut x: int = n0
    while t < j {
        let start: int = x
        let mut q: int = 0
        let mut s: int = 0
        let mut c: float = 0.0
        // c accumulates C/3^q = sum 2^(e_i)/3^(i+1) in floating point (a measurement).
        // The exponent stays one number so 3^q cannot overflow a float.
        while s < tau_of[q] {
            if x % 2 == 1 { c = c + pow(2.0, float(s) - float(q + 1) * log2_3()) q = q + 1 }
            x = step(x, d)
            s = s + 1
        }
        let bound: float = float(d) * (float(slope_numerator()) / float(slope_denominator()) * float(q) + 0.6882)
        envelope_use = max(envelope_use, float(d) * c / bound)
        // q = 0 blocks are a single halving: x = start/2 < start, no offset.
        if q > 0 { drift_slack = min(drift_slack, (float(start) + float(d) * c - float(x)) / (float(d) * c)) }
        if blocks == 0 {
            first_q = q
            let w: float = float(s) - float(q) * log2_3()
            ratio = float(n0) * (pow(2.0, w) - 1.0) / (float(d) * c)
        }
        blocks = blocks + 1
        t = t + s
    }
    return CycleReport { d: d, n0: n0, length: j, odd: odd, blocks: blocks, first_block_q: first_q,
        descent_ratio_milli: int(ratio * 1000.0), envelope_use_milli: int(envelope_use * 1000.0),
        drift_slack_min_milli: int(drift_slack * 1000.0) }
}

fn main() -> nil {
    let l: Logs = logs()
    let mut tau_of: list<int> = [1]
    for q in range(1, 3000) { tau_of = push(tau_of, ceil_alpha(l, q)) }
    let mut worst_ratio: int = 0
    let mut found: int = 0
    for d in [5, 7, 11, 13, 17, 19, 23, 25, 29, 31, 37, 41, 43, 47] {
        for n in range(1, 20000) {
            if n % d == 0 { continue }
            let members: list<int> = cycle_members(n, d, 4000)
            if len(members) == 0 { continue }
            let r: CycleReport = analyse(n, d, members, tau_of)
            assert(r.descent_ratio_milli <= 1000, "calibration: a real cycle violates the descent condition")
            assert(r.envelope_use_milli <= 1000, "calibration: a real cycle exceeds the ladder envelope")
            assert(r.drift_slack_min_milli > 0, "calibration: a real cycle violates the drift lemma")
            worst_ratio = max(worst_ratio, r.descent_ratio_milli)
            found = found + 1
            print(json_stringify(r))
        }
    }
    print(format("{} cycles, largest descent ratio {}/1000", found, worst_ratio))
}

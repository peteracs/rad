use "kl.rad"

struct Split { k: int = 0, triple_dispersion: float = 0.0, child_parent_spread: float = 0.0, parent_spread: float = 0.0, top_digit_mean: list<float> = [] }

// Compare the level-k optimum with the level-(k-1) optimum:
// child m' + j 3^(k-2) against parent m' (index t, children t, t+n1, t+2n1).
fn main() -> nil {
    let top: int = int(sys_args()[0])
    let mut vector: bytebuf = words_new(3, 1 << 30)
    let mut parent: bytebuf = vector
    let mut floor_gamma: float = 0.0
    for k in range(2, top + 1) {
        if k > 2 { vector = lift(vector, level_size(k - 1)) }
        let found: LevelSearch = search_level(k, vector, floor_gamma, 1.0, 24, 300)
        vector = found.vector
        floor_gamma = found.gamma_lo
        if k >= 4 {
            let n1: int = int_div(level_size(k), 3)
            let pmean: float = float(words_max_value(parent))
            let mut dispersion: float = 0.0
            let mut lo_ratio: float = 1000000.0
            let mut hi_ratio: float = 0.0
            let mut digit: list<float> = [0.0, 0.0, 0.0]
            for t in range(n1) {
                let p: float = float(words_get(parent, t))
                let xs: list<float> = [float(words_get(vector, t)), float(words_get(vector, t + n1)), float(words_get(vector, t + 2 * n1))]
                let mean: float = (xs[0] + xs[1] + xs[2]) / 3.0
                dispersion = dispersion + (max(xs[0], max(xs[1], xs[2])) - min(xs[0], min(xs[1], xs[2]))) / mean
                let ratio: float = mean / p
                if ratio < lo_ratio { lo_ratio = ratio }
                if ratio > hi_ratio { hi_ratio = ratio }
                for j in range(3) { digit = set_at(digit, j, digit[j] + xs[j] / mean / float(n1)) }
            }
            print(json_stringify(Split { k: k, triple_dispersion: dispersion / float(n1),
                child_parent_spread: hi_ratio / lo_ratio,
                parent_spread: float(words_max_value(parent)) / float(words_min_value(parent)) + 0.0 * pmean,
                top_digit_mean: digit }))
        }
        parent = vector
    }
}

use "kl.rad"

struct Row { k: int = 0, lambda: float = 0.0, gamma: float = 0.0, evaluations: int = 0 }

fn main() -> nil {
    let args: list<str> = sys_args()
    let top: int = if len(args) > 0 { int(args[0]) } else { 11 }
    let iterations: int = if len(args) > 1 { int(args[1]) } else { 200 }
    let mut vector: bytebuf = words_new(3, 1 << 30)
    let mut floor_gamma: float = 0.0
    for k in range(2, top + 1) {
        if k > 2 { vector = lift(vector, level_size(k - 1)) }
        let found: LevelSearch = search_level(k, vector, floor_gamma, 1.0, 30, iterations)
        vector = found.vector
        floor_gamma = found.gamma_lo
        print(json_stringify(Row { k: k, lambda: found.lambda_lo, gamma: found.gamma_lo, evaluations: found.evaluations }))
    }
}

use "kl.rad"

struct Policy { k: int = 0, gamma: float = 0.0, wins: list<int> = [], ties: int = 0, spread: float = 0.0 }

// For each class m' mod 3^(k-1), which lift j (m' + j 3^(k-1)) attains cbar.
fn main() -> nil {
    let top: int = int(sys_args()[0])
    let mut vector: bytebuf = words_new(3, 1 << 30)
    let mut floor_gamma: float = 0.0
    for k in range(2, top + 1) {
        if k > 2 { vector = lift(vector, level_size(k - 1)) }
        let found: LevelSearch = search_level(k, vector, floor_gamma, 1.0, 26, 300)
        vector = found.vector
        floor_gamma = found.gamma_lo
        let n: int = level_size(k)
        let n1: int = int_div(n, 3)
        let mut wins: list<int> = [0, 0, 0]
        let mut ties: int = 0
        for t in range(n1) {
            let x: int = words_get(vector, t)
            let y: int = words_get(vector, t + n1)
            let z: int = words_get(vector, t + 2 * n1)
            let low: int = min(x, min(y, z))
            let count: int = (if x == low { 1 } else { 0 }) + (if y == low { 1 } else { 0 }) + (if z == low { 1 } else { 0 })
            if count > 1 { ties = ties + 1 }
            if x == low { wins = set_at(wins, 0, wins[0] + 1) } else if y == low { wins = set_at(wins, 1, wins[1] + 1) } else { wins = set_at(wins, 2, wins[2] + 1) }
        }
        let spread: float = float(words_max_value(vector)) / float(words_min_value(vector))
        print(json_stringify(Policy { k: k, gamma: found.gamma_lo, wins: wins, ties: ties, spread: spread }))
    }
}

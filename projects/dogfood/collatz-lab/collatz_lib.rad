// Exact small arithmetic helpers kept in RAD so the native bulk kernel is
// independently exercised by ordinary language code.

pub pure fn add_vectors(left: list<int>, right: list<int>) -> list<int> {
    assert(len(left) == len(right), "histogram lengths differ")
    let mut result = []
    for index in range(len(left)) {
        result = push(result, left[index] + right[index])
    }
    return result
}

pub pure fn zeros(count: int) -> list<int> {
    let mut result = []
    for _index in range(count) {
        result = push(result, 0)
    }
    return result
}

pub pure fn sum_ints(items: list<int>) -> int {
    let mut total = 0
    for value in items {
        total = total + value
    }
    return total
}

pub pure fn first_nonzero_index(items: list<int>) -> int {
    for index in range(len(items)) {
        if items[index] != 0 {
            return index
        }
    }
    return -1
}

pub pure fn minimum_noncontracting_odd_steps(depth: int) -> int {
    let target = shl(1, depth)
    let mut coefficient = 1
    let mut odd_steps = 0
    while coefficient < target {
        coefficient = coefficient * 3
        odd_steps = odd_steps + 1
    }
    return odd_steps
}

pub pure fn survivor_curve(prune_histogram: list<int>, depth: int) -> list<int> {
    let mut remaining_leaves = shl(1, depth)
    let mut result = []
    for current_depth in range(1, depth + 1) {
        remaining_leaves = remaining_leaves - prune_histogram[current_depth]
        result = push(
            result,
            int_div(remaining_leaves, shl(1, depth - current_depth)),
        )
    }
    return result
}

// Count parity words whose terminal multiplicative coefficient is dangerous,
// and the much smaller subset that stays dangerous at every prefix.  The
// second class is an irrational-slope ballot/meander language: it models the
// parity shape a divergent least counterexample would have to follow.
pub pure fn critical_path_profile(depth: int) -> map<str, int> {
    let mut unrestricted = zeros(depth + 1)
    let mut meanders = zeros(depth + 1)
    unrestricted = set_at(unrestricted, 0, 1)
    meanders = set_at(meanders, 0, 1)

    for step in range(1, depth + 1) {
        let mut next_unrestricted = zeros(depth + 1)
        let mut next_meanders = zeros(depth + 1)
        for odd_steps in range(step + 1) {
            let mut unrestricted_count = unrestricted[odd_steps]
            let mut meander_count = meanders[odd_steps]
            if odd_steps > 0 {
                unrestricted_count = unrestricted_count + unrestricted[odd_steps - 1]
                meander_count = meander_count + meanders[odd_steps - 1]
            }
            next_unrestricted = set_at(next_unrestricted, odd_steps, unrestricted_count)
            if pow(3, odd_steps) >= shl(1, step) {
                next_meanders = set_at(next_meanders, odd_steps, meander_count)
            }
        }
        unrestricted = next_unrestricted
        meanders = next_meanders
    }

    let mut terminal_noncontracting = 0
    for odd_steps in range(depth + 1) {
        if pow(3, odd_steps) >= shl(1, depth) {
            terminal_noncontracting = terminal_noncontracting + unrestricted[odd_steps]
        }
    }
    let result: map<str, int> = {
        "terminal_noncontracting_words": terminal_noncontracting,
        "prefix_noncontracting_words": sum_ints(meanders),
    }
    return result
}

// Construct the canonical residue for the greedy boundary word: choose an
// even parity whenever it keeps 3^q >= 2^j, otherwise choose odd.  The parity
// word is an infinite noncontracting meander in the 2-adic model.  Its inverse
// input bits reveal whether a finite positive representative is stabilizing.
pub pure fn greedy_critical_shadow(depth: int) -> map<str, any> {
    let mut residue = 0
    let mut coefficient = 1
    let mut denominator = 1
    let mut probe = 0
    let mut odd_steps = 0
    let mut input_bits = []
    let mut parity_word = []
    let mut last_nonzero_input_bit = -1

    for step in range(1, depth + 1) {
        let parity = if coefficient >= shl(1, step) { 0 } else { 1 }
        let extension = (parity - (probe % 2) + 2) % 2
        residue = residue + extension * denominator
        if extension != 0 {
            last_nonzero_input_bit = step - 1
        }
        input_bits = push(input_bits, extension)
        parity_word = push(parity_word, parity)
        let source = probe + extension * coefficient
        if parity == 1 {
            probe = int_div(3 * source + 1, 2)
            coefficient = coefficient * 3
            odd_steps = odd_steps + 1
        } else {
            probe = int_div(source, 2)
        }
        denominator = denominator * 2
        assert(coefficient >= denominator, "greedy critical word crossed its boundary")
    }
    let next_parity = if coefficient >= shl(1, depth + 1) { 0 } else { 1 }
    let next_forced_input_bit = (next_parity - (probe % 2) + 2) % 2
    let result: map<str, any> = {
        "depth": depth,
        "residue": residue,
        "terminal": probe,
        "odd_steps": odd_steps,
        "input_bits": input_bits,
        "parity_word": parity_word,
        "last_nonzero_input_bit": last_nonzero_input_bit,
        "next_parity": next_parity,
        "next_forced_input_bit": next_forced_input_bit,
    }
    return result
}

// Shortcut map: one division by two is folded into every odd step.
pub pure fn collatz_shortcut(value: int) -> int {
    if value % 2 == 0 {
        return int_div(value, 2)
    }
    return int_div(3 * value + 1, 2)
}

// Returns (steps until strict descent, terminal, peak, odd steps).  This is
// intentionally written in RAD, not delegated to the kernel.
pub pure fn first_descent(start: int, step_limit: int) -> any {
    assert(start > 1, "first_descent needs start > 1")
    let mut value = start
    let mut peak = start
    let mut odd_steps = 0
    let mut steps = 0
    while value >= start and steps < step_limit {
        if value % 2 != 0 {
            odd_steps = odd_steps + 1
        }
        value = collatz_shortcut(value)
        if value > peak {
            peak = value
        }
        steps = steps + 1
    }
    return (steps, value, peak, odd_steps)
}

// Odd-only Syracuse valuations v2(3n+1). A divergent counterexample would
// need their long-run average to stay at or below log_2(3), while the usual
// geometric heuristic has mean 2.
pub pure fn syracuse_valuations(start: int, count: int) -> list<int> {
    assert(start > 0 and start % 2 != 0, "valuation trace needs a positive odd start")
    let mut result = []
    let mut value = start
    while len(result) < count and value != 1 {
        let expanded = 3 * value + 1
        let valuation = ctz(expanded)
        result = push(result, valuation)
        value = shr(expanded, valuation)
    }
    return result
}

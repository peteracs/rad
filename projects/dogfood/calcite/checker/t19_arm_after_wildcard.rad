// SUSPECT: an arm placed AFTER a `_` wildcard can never be reached.
// Spec 4.6 calls unreachable code a compile-time error.
fn label(n: int) -> str {
    match n {
        1 => { return "one" }
        _ => { return "other" }
        2 => { return "two (unreachable)" }
    }
}

fn main() -> nil {
    print(label(2))
}

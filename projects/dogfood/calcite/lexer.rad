// =====================================================================
//  calcite / lexer.rad
//  Source text -> flat token list. Tokens are a sum type so every
//  consumer has to match them exhaustively.
// =====================================================================

use "ast.rad"

pub type Tok {
    TNum { num: 0.0 }
    TIdent { name: "" }
    TPunct { sym: "" }
    TEof {}
}

pure fn is_digit(c: str) -> bool {
    if len(c) == 0 {
        return false
    }
    return contains("0123456789", c)
}

pure fn is_ident_start(c: str) -> bool {
    if len(c) == 0 {
        return false
    }
    return contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
}

pure fn is_ident_char(c: str) -> bool {
    return is_ident_start(c) or is_digit(c)
}

pure fn is_space(c: str) -> bool {
    return c == " " or c == "\t" or c == "\n" or c == "\r"
}

// Human-readable token text, used in parser error messages.
pub fn tok_text(t: Tok) -> str {
    match t {
        TNum { num } => { return fmt_num(num) }
        TIdent { name } => { return name }
        TPunct { sym } => { return sym }
        TEof => { return "end of input" }
    }
}

pub fn tokenize(src: str) -> Result<list, str> {
    let cs = chars(src)
    let n = len(cs)
    let mut out = []
    let mut i = 0

    while i < n {
        let c = cs[i]
        if is_space(c) {
            i = i + 1
        } else if is_digit(c) {
            let mut text = ""
            let mut j = i
            while j < n and is_digit(cs[j]) {
                text = text + cs[j]
                j = j + 1
            }
            if j < n and cs[j] == "." {
                text = text + "."
                j = j + 1
                while j < n and is_digit(cs[j]) {
                    text = text + cs[j]
                    j = j + 1
                }
            }
            out = push(out, Tok::TNum { num: float(text) })
            i = j
        } else if is_ident_start(c) {
            let mut text = ""
            let mut j = i
            while j < n and is_ident_char(cs[j]) {
                text = text + cs[j]
                j = j + 1
            }
            out = push(out, Tok::TIdent { name: text })
            i = j
        } else {
            let mut two = ""
            if i + 1 < n {
                two = c + cs[i + 1]
            }
            if two == "<=" or two == ">=" or two == "==" or two == "!=" {
                out = push(out, Tok::TPunct { sym: two })
                i = i + 2
            } else if contains("+-*/%^()<>,=", c) {
                out = push(out, Tok::TPunct { sym: c })
                i = i + 1
            } else {
                return Err(f"unexpected character '{c}' at offset {i}")
            }
        }
    }

    out = push(out, Tok::TEof {})
    return Ok(out)
}

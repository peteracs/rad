// BUG 03 - a `pub fn` is exempt from the "unused" report but is NOT treated
// as a reachability ROOT, so every private helper it calls is falsely
// reported as dead code.
//
// Run:  target\debug\rad.exe lint --preset=strict projects\dogfood\calcite\bugs\03_pub_fn_not_reachability_root.rad
//
// This file is a library module: no main, no top-level statements.
// `helper` is called by `exported`, which is public and therefore part of
// the module's live API. Expected: no unused-function warnings.
// Actual:   Warning: Unused function 'helper'

fn helper(x: int) -> int {
    return x * 2
}

pub fn exported(x: int) -> int {
    return helper(x) + 1
}

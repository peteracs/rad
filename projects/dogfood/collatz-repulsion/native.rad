// Survival receipts from the project-owned trapped_survival batch tool
// (survival_receipts.py writes them).
pub struct NativeRow { bits: int = 0, d: int = 0, mark: int = 0, observed: int = 0, expected_x10: int = 0, z_x100: int = 0 }

pub fn native_rows(bits: int, d: int, multiples: list<int>) -> list<NativeRow> {
    let path: str = format("projects/dogfood/collatz-repulsion/out/survival-b{}-d{}.json", bits, d)
    let receipt: any = json_parse(read_file(path)) |> unwrap
    let mut marks: list<int> = []
    let mut out: list<NativeRow> = []
    for i in range(len(multiples)) {
        marks = push(marks, multiples[i] * bits)
        let row: any = receipt["marks"][i]
        assert(row["mark"] == marks[i], "survival receipt does not match the requested marks")
        let obs: int = row["observed"]
        let mean: float = float(row["expected_x1000"]) / 1000.0
        let sd: float = pow(float(row["variance_x1000"]) / 1000.0, 0.5)
        out = push(out, NativeRow { bits: bits, d: d, mark: marks[i], observed: obs, expected_x10: int(10.0 * mean),
            z_x100: if sd > 0.0 { int(100.0 * (float(obs) - mean) / sd) } else { 0 } })
    }
    return out
}

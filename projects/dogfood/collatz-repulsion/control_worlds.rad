use "control.rad"

resource Continuation { seed: int = 0, min_start: int = 2 }

pub struct Tally { seed: int = 0, min_start: int = 0, counts: list<int> = [] }

component TallyEvidence { result: Tally = Tally {} }

entity tally_slot { TallyEvidence {} }

system Run(evidence: mut TallyEvidence, c: Continuation, io true) {
    let marks: list<int> = [40, 60, 80, 100, 120, 160]
    if c.seed == 0 {
        evidence = TallyEvidence { result: Tally { seed: 0, min_start: c.min_start, counts: continue_counts(20, marks, c.min_start) } }
    } else {
        // Null world: the same trapped states, continued with fair seeded coin flips.
        let floors: list<int> = floor_table(900)
        let states: list<list<int>> = trapped_states(20, floors) |> filter(fn(st: list<int>) -> bool { return st[0] >= c.min_start })
        let mut counts: list<int> = [0, 0, 0, 0, 0, 0]
        for s in states {
            let mut q: int = s[1]
            let mut t: int = 20
            let mut alive: bool = true
            while alive and t < 160 {
                if rand_bool() { q = q + 1 }
                t = t + 1
                if q < floors[t] { alive = false }
                if alive { for i in range(6) { if marks[i] == t { counts = set_at(counts, i, counts[i] + 1) } } }
            }
        }
        evidence = TallyEvidence { result: Tally { seed: c.seed, min_start: c.min_start, counts: counts } }
    }
}

component Contrast { real: list<int> = [], random_mean: list<int> = [], random_min: list<int> = [], random_max: list<int> = [] }

entity contrast { Contrast {} }

intent Counted {
    key target: entity
    seed: int
    counts: list<int>
}

law Report(target: entity, t: Tally) { propose Counted { target: target, seed: t.seed, counts: t.counts } }

resolver Compare for Counted(target, proposals) {
    let mut real: list<int> = []
    let mut totals: list<int> = [0, 0, 0, 0, 0, 0]
    let mut lo: list<int> = [1000000, 1000000, 1000000, 1000000, 1000000, 1000000]
    let mut hi: list<int> = [0, 0, 0, 0, 0, 0]
    let mut nrand: int = 0
    for p in proposals {
        if p.seed == 0 { real = p.counts } else {
            nrand = nrand + 1
            for i in range(6) {
                totals = set_at(totals, i, totals[i] + p.counts[i])
                lo = set_at(lo, i, min(lo[i], p.counts[i]))
                hi = set_at(hi, i, max(hi[i], p.counts[i]))
            }
        }
    }
    let mut mean: list<int> = []
    for i in range(6) { mean = push(mean, int_div(totals[i], max(1, nrand))) }
    next(target, Contrast { real: real, random_mean: mean, random_min: lo, random_max: hi })
}

fn main() -> nil {
    let base: world_fork = fork()
    let mut jobs: list<world_fork> = []
    for m in [2, 1 << 19] { for seed in [0, 11, 23, 37] { jobs = push(jobs, fork_with(base, Continuation { seed: seed, min_start: m })) } }
    let done: list<world_fork> = simulate_many(jobs, [system::Run], 1, 1937)
    let mut tallies: list<Tally> = []
    for i in range(len(done)) {
        assert_only_changed(jobs[i], done[i], [TallyEvidence])
        tallies = push(tallies, (peek(done[i], tally_slot, TallyEvidence) |> unwrap).result)
    }
    for t in tallies { print(t.min_start, t.seed, t.counts) }
}

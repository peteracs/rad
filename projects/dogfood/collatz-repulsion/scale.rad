use "native.rad"
let d: int = int(sys_args()[0])
for b in [30] { let mut zs: list<int> = [] let mut ratios: list<int> = [] for r in native_rows(b, d, [2, 3, 4, 5, 6]) { zs = push(zs, r.z_x100) ratios = push(ratios, if r.expected_x10 > 0 { int_div(10000 * r.observed, r.expected_x10) } else { 0 }) } print(d, b, "z x100:", zs, "obs/exp x1000:", ratios) }

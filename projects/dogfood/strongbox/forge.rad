// strongbox - the adversary. Produces plausibly edited, valid archives.
//
//   rad projects/dogfood/strongbox/forge.rad -- <mode>
//
// The attacker loads, edits, and re-seals a valid current save, so the
// transport integrity digest is valid. The independent receipt chain must
// still identify the semantic forgery.
//
//   downgrade  a sev-5 incident becomes sev-1 (and its SLA changes)
//   whitewash  an open incident is recorded as resolved
//   erase      an incident is deleted and the Ledger count adjusted
//   backdate   open incidents receive a harmless-looking SLA
//   none       semantically unchanged control
//
// Run main.rad first to produce saves/archive.radw.

component Incident { code: "", severity: 1, status: "open", age: 0, sla_mins: 60 }

component Assignee { name: "", team: "unassigned" }

component Source { origin: "" }

resource Ledger { count: 0, region: "", revision: 3 }

let argv = sys_args()
let mut mode = "downgrade"
if len(argv) > 0 {
    mode = argv[0]
}

let archive = read_file("projects/dogfood/strongbox/saves/archive.radw")
let _loaded = load_world(archive)
let mut note = ""

if mode == "downgrade" {
    let ent = get_entity("OOM_KILL")
    let incident = get(ent, Incident) |> unwrap
    set(ent, Incident { severity: 1, sla_mins: 60, ..incident })
    note = "OOM_KILL severity 5 -> 1, sla 15 -> 60"
} else if mode == "whitewash" {
    let ent = get_entity("LB_5XX")
    let incident = get(ent, Incident) |> unwrap
    set(ent, Incident { status: "resolved", ..incident })
    note = "LB_5XX open -> resolved"
} else if mode == "erase" {
    despawn(get_entity("SLOW_QUERY"))
    let ledger = res(Ledger)
    set_resource(Ledger, Ledger { count: ledger.count - 1, ..ledger })
    note = "SLOW_QUERY deleted, Ledger count 5 -> 4 to stay consistent"
} else if mode == "backdate" {
    for ent in entities(Incident) {
        let incident = get(ent, Incident) |> unwrap
        if incident.status == "open" {
            set(ent, Incident { sla_mins: 600, ..incident })
        }
    }
    note = "open incidents given a 600-minute SLA so nothing looks breached"
} else if mode == "none" {
    note = "unmodified control copy"
} else {
    print(f"unknown mode {mode}")
}

let forged = save_world()
let changed = forged != archive
write_file(f"projects/dogfood/strongbox/saves/forged_{mode}.radw", forged)

print(f"=== forge: {mode} ===")
print(f"  edit: {note}")
print(f"  archive changed: {changed}  ({len(archive)} -> {len(forged)} bytes)")
print(f"  wrote saves/forged_{mode}.radw")

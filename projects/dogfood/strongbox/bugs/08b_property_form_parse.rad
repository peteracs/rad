// BUG 08b — the documented property-test form does not parse.
//
//   rad projects/dogfood/strongbox/bugs/08b_property_form_parse.rad
//
// spec.md line 117 defines:
//   test_decl = "test" ( IDENT | STRING )
//               [ "for" IDENT "in" expr { "," IDENT "in" expr } ] block ;
//
// and spec.md 1687 documents gen_int/gen_float/gen_str/gen_bool/gen_list as
// "deterministic test generators", which exist to feed exactly this form.
//
// EXPECTED: parses, and runs the body once per generated value.
// ACTUAL:   Error: Expected LBrace, got For ('for')
//
// So the `for ... in` clause of test_decl is specified and documented but
// unimplemented, and the gen_* builtins have no syntax that consumes them.

test plain_form_parses_but_never_runs {
    assert_eq(1, 1)
}

test property_form for v in gen_int() {
    assert_eq(v, v)
}

// BUG 05 — baseline program to record.
//
//   rad projects/dogfood/strongbox/bugs/05_retro_write_hole/record.rad \
//       --record projects/dogfood/strongbox/bugs/05_retro_write_hole/base.radr

component Counter { n: 0 }

let _c = spawn("c", Counter { n: 1 })

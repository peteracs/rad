pub opaque type OrderId = u64
pub opaque type AccountId = u64
pub opaque type PriceTicks = i64
pub opaque type Quantity = u64
pub opaque type Sequence = u64

pub resource BookCoreBatchReceipt {
    orders: int = 0,
    fills: int = 0,
    open_orders: int = 0,
}

pub event MatchBatchCommitted {
    fills: int,
}

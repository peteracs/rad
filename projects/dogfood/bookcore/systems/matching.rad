use "../schema.rad"
use "../owners/order_book.rad"

pub fn drain_crossing_book(batch_size: int) -> nil {
    MatchBook(batch_size)
    while res(MatchCycle).has_more_crossing_orders {
        MatchBook(batch_size)
    }
}

@no_full_scan
pub system MatchOrders(
    reads OrderIdentity,
    reads OpenOrder,
    reads BuyOrder,
    reads SellOrder,
    reads MatchCycle,
    writes OpenOrder,
    writes BuyOrder,
    writes SellOrder,
    writes Fill,
    writes MatchCycle,
    writes "$entities",
    writes "$entity_identity",
    emits MatchBatchCommitted,
) {
    drain_crossing_book(100000)
}

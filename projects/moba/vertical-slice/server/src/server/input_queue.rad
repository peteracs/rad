pub component PeerConnection {
    indexed key: str = "",
    connected: bool = true,
    session_id: int = 0,
    player_id: int = 1,
    host: str = "",
    port: int = 0,
    last_seen_ms: int = 0,
    last_command_id: int = 0,
    last_client_seq: int = 0,
    received_client_seq: int = 0,
    received_ack_bits: int = 0,
    last_applied_client_seq: int = 0,
    applied_ack_bits: int = 0,
    late_inputs: int = 0,
    future_inputs: int = 0,
    duplicate_inputs: int = 0,
    overwritten_inputs: int = 0,
    last_status: str = "idle"
}


// NAVWORK — browser-moba's navgrid, written the way it wants to be
// written (fake-port round 12). The code comes first; whatever the
// language can't run becomes a feature.
//
// Architecture (mirrors nav/navmesh.ts + game/navPull.ts + the
// original's TestNavGrid):
//   - The navgrid is a resource: one int per 1m cell, 0 walkable,
//     1 NOT_PASSABLE. Derived data, never in the snapshot.
//   - Pathing is grid A* with tuple cells: score maps keyed by (x, y),
//     neighbors via tuple math, the open set ordered by lexicographic
//     tuple comparison — (f, g, cell) sorts itself.
//   - String pulling: a cell-march line-of-sight test (the same DDA the
//     original's GetClosestCellToRay uses) drops every waypoint the
//     previous one can already see past.
//   - nav_pull: pwHUD's right-click ground pull, a pure function — ray
//     from the click toward the unit (or back at the player when the
//     click lands on the footprint), first passable cell wins.

pub let W = 16
pub let H = 12
pub let CELL = 1.0                       // navGrid_CellSize: 50u = 1 m

resource NavGrid { cells: list = [] }

pub let CARDINAL = [(1, 0), (-1, 0), (0, 1), (0, -1)]

fn passable(c: (int, int)) -> bool {
    let (x, y) = c
    if x < 0 or y < 0 or x >= W or y >= H { return false }
    return res(NavGrid).cells[y * W + x] == 0
}

pure fn manhattan(a: (int, int), b: (int, int)) -> int {
    let (dx, dy) = a - b
    return abs(dx) + abs(dy)
}

// ------------------------------------------------------------- A*

// open entries are (f, g, cell): lexicographic tuple order IS the
// A* priority — lowest f first, g breaks ties
fn find_path(start: (int, int), goal: (int, int)) -> list {
    let mut open = [(manhattan(start, goal), 0, start)]
    let mut came = {}                    // cell -> cell, tuple-keyed
    let mut best = {}                    // cell -> g,    tuple-keyed
    best[start] = 0

    while len(open) > 0 {
        open = sort(open)
        let (_, g, cur) = open[0]
        open = drop_first(open)
        if cur == goal { break }
        if g > get_or(best, cur, 0) { continue }   // stale entry

        for d in CARDINAL {
            let next = cur + d
            if not passable(next) { continue }
            let ng = g + 1
            if ng >= get_or(best, next, 999999) { continue }
            best[next] = ng
            came[next] = cur
            open << (ng + manhattan(next, goal), ng, next)
        }
    }

    if not contains(best, goal) { return [] }
    let mut path = [goal]
    let mut at = goal
    while at != start {
        at = came[at]
        path << at
    }
    return reverse(path)
}

// ------------------------------------------------- string pulling

// cell-march LOS: sample the segment every half cell; any blocked
// sample kills the sight line (the era's conservative DDA)
fn sees(a: (int, int), b: (int, int)) -> bool {
    let steps = manhattan(a, b) * 2
    if steps == 0 { return true }
    for i in range(steps + 1) {
        let t = float(i) / float(steps)
        let (ax, ay) = a
        let (bx, by) = b
        let probe = (int(round(float(ax) + (float(bx) - float(ax)) * t)),
            int(round(float(ay) + (float(by) - float(ay)) * t)))
        if not passable(probe) { return false }
    }
    return true
}

// keep a waypoint only when the last kept one can't see past it
fn smooth(path: list) -> list {
    if len(path) <= 2 { return path }
    let mut out = [path[0]]
    let mut anchor = path[0]
    for i in range(1, len(path) - 1) {
        if not sees(anchor, path[i + 1]) {
            anchor = path[i]
            out << anchor
        }
    }
    out << path[len(path) - 1]
    return out
}

// ------------------------------------------------------- nav pull

// pwHUD::ProcessRightClick's ground pull (game/navPull.ts, RE'd from
// 0x7df10c): budget = max(0, radius*0.9 - 1m); aim at the unit when the
// click is off the footprint, back at the player when it's on it; march
// one cell per step, first passable cell wins, exhausted budget = no-op
pub fn nav_pull(click: (int, int), unit: (int, int), unit_radius: float, player: (int, int)) -> (int, int) {
    let budget = max(0.0, unit_radius * 0.9 - 1.0)
    let on_footprint = float(manhattan(click, unit)) < unit_radius
    let aim = if on_footprint { player - click } else { unit - click }
    if passable(click) { return click }              // first-cell hit
    let (ax, ay) = aim
    let step = (sign(ax), sign(ay))
    let mut probe = click
    let mut spent = 0.0
    while spent < budget {
        probe = probe + step
        spent = spent + 1.0
        if passable(probe) { return probe }
    }
    return click                                     // budget out: no-op
}

pure fn sign(v: int) -> int {
    return if v > 0 { 1 } else if v < 0 { -1 } else { 0 }
}

// ------------------------------------------------------------ demo

fn main() -> nil {
    // a wall across the middle with one gap at y=9
    let mut cells = []
    for y in range(H) {
        for x in range(W) {
            let wall = x == 8 and y != 9
            cells << if wall { 1 } else { 0 }
        }
    }
    update(NavGrid) { cells = cells }

    let path = find_path((2, 2), (13, 2))
    print(f"raw path: {len(path)} cells")
    let pulled = smooth(path)
    print(f"smoothed: {pulled}")

    // unreachable: goal walled into a pocket
    update(NavGrid) { cells[9 * W + 8] = 1 }         // close the gap
    print(f"sealed map: {len(find_path((2, 2), (13, 2)))} cells")

    // nav pull: click inside a turret footprint pulls to the player's side
    update(NavGrid) { cells[5 * W + 12] = 1 }        // the turret's cell
    let dest = nav_pull((12, 5), (12, 5), 3.0, (2, 5))
    print(f"pull on-footprint: {dest}")
    // tiny radius: provably a no-op, like every shipped unit of the era
    let noop = nav_pull((12, 5), (12, 5), 0.6, (2, 5))
    print(f"pull tiny radius: {noop}")
}
